--- /dev/null
+++ b/src/sidebar/components/hooks/use-library-route.ts
@@ -0,0 +1,53 @@
+import { useCallback, useLayoutEffect, useState } from 'preact/hooks';
+
+import type { LibraryTab } from '../../helpers/library-preferences';
+import {
+  libraryRouteHash,
+  parseLibraryRoute,
+} from '../../helpers/library-routes';
+import type { LibraryRoute } from '../../helpers/library-routes';
+
+export function useLibraryRoute(
+  legacyTab: LibraryTab,
+  /* istanbul ignore next - test seam */
+  window_ = window,
+) {
+  const [route, setRoute] = useState(() =>
+    parseLibraryRoute(window_.location.hash, legacyTab),
+  );
+  useLayoutEffect(() => {
+    const sync = () => {
+      const next = parseLibraryRoute(window_.location.hash, legacyTab);
+      const hash = libraryRouteHash(next);
+      if (window_.location.hash !== hash) {
+        const url = new URL(window_.location.href);
+        url.hash = hash;
+        window_.history.replaceState(window_.history.state, '', url.href);
+      }
+      setRoute(next);
+    };
+    // Canonicalize old query links without adding a Back history entry.
+    sync();
+    window_.addEventListener('popstate', sync);
+    window_.addEventListener('hashchange', sync);
+    return () => {
+      window_.removeEventListener('popstate', sync);
+      window_.removeEventListener('hashchange', sync);
+    };
+  }, [legacyTab, window_]);
+
+  const navigate = useCallback(
+    (next: LibraryRoute) => {
+      const hash = libraryRouteHash(next);
+      if (window_.location.hash === hash) {
+        return;
+      }
+      const url = new URL(window_.location.href);
+      url.hash = hash;
+      window_.history.pushState(window_.history.state, '', url.href);
+      setRoute(parseLibraryRoute(hash));
+    },
+    [window_],
+  );
+  return { route, navigate };
+}
