+import { mount, mockImportedComponents } from '@hypothesis/frontend-testing';
+import { act } from 'preact/test-utils';
+
+import * as fixtures from '../../../test/annotation-fixtures';
+import LocalResearchActions, { $imports } from '../LocalResearchActions';
+
+describe('LocalResearchActions', () => {
+  let request;
+  let doc;
+  let enabled;
+  let annotation;
+  let remember;
+  beforeEach(() => {
+    annotation = fixtures.defaultAnnotation();
+    doc = {
+      id: 'document',
+      title: 'Personal title',
+      reaction: null,
+      annotation_states: {},
+      metadata: {},
+      analysis: {},
+    };
+    enabled = true;
+    request = sinon.stub().callsFake(async () => ({ document: doc }));
+    remember = sinon.stub();
+    $imports.$mock(mockImportedComponents());
+    $imports.$mock({
+      '../../helpers/local-research': {
+        localResearchEnabled: () => enabled,
+        researchRequest: request,
+        rememberResearchDocument: remember,
+      },
+      '../hooks/local-research': { useResearchDocument: () => doc },
+      '../../store': {
+        useSidebarStore: () => ({
+          profile: () => ({ userid: annotation.user }),
+        }),
+      },
+    });
+  });
+  afterEach(() => $imports.$restore());
+  const create = () => mount(<LocalResearchActions annotation={annotation} />);
+  const button = (wrapper, title) =>
+    wrapper
+      .find('IconButton')
+      .filterWhere(node => node.prop('title') === title);
+  it('is absent outside the extension so the original client interface is unchanged', () => {
+    enabled = false;
+    assert.isTrue(create().isEmptyRender());
+  });
+  it('saves an explicit like without editing the annotation', async () => {
+    const wrapper = create();
+    await act(async () =>
+      button(wrapper, 'Like this annotation').props().onClick(),
+    );
+    assert.calledWith(
+      request,
+      'annotation-reaction',
+      sinon.match({ uri: annotation.uri, values: { reaction: 'like' } }),
+    );
+    assert.calledWith(remember, annotation.uri, doc);
+  });
+  it('clears a selected reaction', async () => {
+    doc.annotation_states[annotation.id] = { reaction: 'dislike' };
+    const wrapper = create();
+    await act(async () =>
+      button(wrapper, 'Dislike this annotation').props().onClick(),
+    );
+    assert.calledWith(
+      request,
+      'annotation-reaction',
+      sinon.match({ values: { reaction: null } }),
+    );
+  });
+  it('shows the annotation stance while leaving page metadata in Page Notes', () => {
+    doc.metadata = {
+      authors: ['Ada Reader'],
+      institutions: ['Example University'],
+      journal: 'Learning Journal',
+    };
+    doc.analysis = {
+      sentiments: [
+        {
+          annotation_id: annotation.id,
+          sentiment: 'mixed',
+          confidence: 0.8,
+          reason: 'Mixed comment.',
+        },
+      ],
+    };
+    const wrapper = create();
+    act(() => button(wrapper, 'Annotation sentiment').props().onClick());
+    wrapper.update();
+    assert.notInclude(wrapper.text(), 'Ada Reader');
+    assert.notInclude(wrapper.text(), 'Example University');
+    assert.include(wrapper.text(), 'mixed (80%)');
+  });
+});
