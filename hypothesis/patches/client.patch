+        .props()
+        .onChange({ currentTarget: { value: '4' } }),
+    );
+    wrapper.update();
+    assert.equal(
+      wrapper.getDOMNode().querySelectorAll('.ld-chart-table tbody tr').length,
+      4,
+    );
