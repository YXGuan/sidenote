--- /dev/null
+++ b/src/sidebar/helpers/library.ts
@@ -0,0 +1,434 @@
+import type {
+  PageClassification,
+  PageReaction,
+  ResearchDocument,
+} from './local-research';
+
+export type LibraryPage = {
+  id: string;
+  url: string;
+  title: string;
+  manual_tags: string[];
+  auto_tags: string[];
+  groups: string[];
+  classification: PageClassification;
+  classification_source?: string;
+  reaction: PageReaction;
+  annotation_ids: string[];
+  metadata: ResearchDocument['metadata'];
+  created_at: string;
+  updated_at: string;
+  search_text: string;
+  summary?: string;
+  activity?: ResearchDocument['activity'];
+  annotation_activity?: Record<string, number>;
+  automatic_collections?: ResearchDocument['automatic_collections'];
+  collection_signals?: ResearchDocument['collection_signals'];
+};
+export type LibraryFilters = {
+  type: string;
+  topic: string;
+  subtopic: string;
+  keyword?: string;
+  group: string;
+  reaction: string;
+  author?: string;
+  institution?: string;
+  dateFrom?: string;
+  dateTo?: string;
+  metadata?: string;
+};
+export type LibrarySort =
+  | 'newest'
+  | 'oldest'
+  | 'liked'
+  | 'least-liked'
+  | 'updated'
+  | 'oldest-updated'
+  | 'annotations'
+  | 'fewest-annotations'
+  | 'title'
+  | 'title-desc'
+  | 'visits'
+  | 'fewest-visits';
+export type DashboardView = 'list' | 'overview' | 'table' | 'board';
+export type Count = { label: string; count: number };
+export const AUTOMATIC_COLLECTIONS = [
+  {
+    id: 'liked-auto',
+    label: 'Liked (Auto)',
+    description:
+      'Positive sentiment in your comments. Your explicit dislikes take precedence.',
+  },
+  {
+    id: 'questions-auto',
+    label: 'Questions (Auto)',
+    description:
+      'Questions in your comments or highlights, including questions without a question mark.',
+  },
+  {
+    id: 'visit-often',
+    label: 'Visit Often',
+    description:
+      'At least 3 recorded visits in the last 30 days. Openings and tab returns within 5 minutes count once.',
+  },
+] as const;
+export function pageInCollection(page: LibraryPage, collection: string) {
+  return AUTOMATIC_COLLECTIONS.some(item => item.id === collection)
+    ? (page.automatic_collections ?? []).includes(collection)
+    : page.groups.includes(collection);
+}
+export const EMPTY_FILTERS: LibraryFilters = {
+  type: '',
+  topic: '',
+  subtopic: '',
+  group: '',
+  reaction: '',
+};
+export const REACTION_SCORE: Record<string, number> = {
+  love: 2,
+  like: 1,
+  bad: -1,
+  hate: -2,
+};
+const normalized = (value: string) => value.toLocaleLowerCase();
+export const subtopicLabel = (value: { topic: string; name: string }) =>
+  `${value.topic} / ${value.name}`;
+export const pageKeywords = (page: Pick<LibraryPage, 'classification'>) =>
+  page.classification.keywords ??
+  page.classification.subtopics.map(item => item.name);
+
+export function sourceDomain(url: string) {
+  try {
+    const parsed = new URL(url);
+    return (
+      parsed.hostname.replace(/^www\./, '') ||
+      (parsed.protocol === 'urn:' ? 'PDF' : 'Local source')
+    );
+  } catch {
+    return 'Saved source';
+  }
+}
+
+export function monthBuckets(pages: LibraryPage[], sort: LibrarySort) {
+  if (sort !== 'newest' && sort !== 'oldest') {
+    return [{ label: '', pages }];
+  }
+  const groups: { label: string; pages: LibraryPage[] }[] = [];
+  for (const page of pages) {
+    const date = page.created_at ? new Date(page.created_at) : null;
+    const label =
+      date && Number.isFinite(date.getTime())
+        ? date.toLocaleDateString(undefined, {
+            month: 'short',
+            year: 'numeric',
+          })
+        : 'Date unavailable';
+    const previous = groups[groups.length - 1];
+    if (previous?.label === label) {
+      previous.pages.push(page);
+    } else {
+      groups.push({ label, pages: [page] });
+    }
+  }
+  return groups;
+}
+
+export function normalizePage(
+  page: Partial<LibraryPage> & {
+    id: string;
+    url: string;
+    title: string;
+    tags?: string[];
+  },
+): LibraryPage {
+  return {
+    manual_tags: page.tags ?? [],
+    auto_tags: [],
+    groups: [],
+    reaction: null,
+    classification: { link_type: 'unknown', topics: [], subtopics: [] },
+    annotation_ids: [],
+    metadata: {},
+    created_at: '',
+    updated_at: '',
+    search_text: '',
+    ...page,
+  };
+}
+
+export function pageFromDocument(
+  previous: LibraryPage,
+  doc: ResearchDocument,
+): LibraryPage {
+  return {
+    ...previous,
+    title: doc.title,
+    manual_tags: doc.manual_tags ?? doc.page_tags,
+    auto_tags: doc.auto_tags ?? [],
+    groups: doc.groups ?? [],
+    classification: doc.classification ?? previous.classification,
+    classification_source: doc.classification_source,
+    reaction: doc.reaction,
+    metadata: doc.metadata,
+    summary: doc.summary,
+    activity: doc.activity,
+    automatic_collections: doc.automatic_collections,
+    collection_signals: doc.collection_signals,
+    created_at: doc.created_at,
+    updated_at: doc.updated_at,
+    annotation_ids: doc.annotations.flatMap(annotation =>
+      annotation.id ? [annotation.id] : [],
+    ),
+    annotation_activity: doc.annotations.reduce<Record<string, number>>(
+      (days, annotation) => {
+        const day = annotation.created?.slice(0, 10);
+        if (day) {
+          days[day] = (days[day] ?? 0) + 1;
+        }
+        return days;
+      },
+      {},
+    ),
+  };
+}
+
+function searchable(page: LibraryPage) {
+  return [
+    page.title,
+    page.url,
+    page.search_text,
+    page.summary ?? '',
+    page.metadata.abstract ?? '',
+    ...page.manual_tags,
+    ...page.auto_tags,
+    ...page.groups,
+    ...(page.metadata.authors ?? []),
+    ...(page.metadata.institutions ?? []),
+    page.metadata.journal ?? '',
+    page.metadata.doi ?? '',
+    page.metadata.arxiv_id ?? '',
+    page.metadata.openalex_id ?? '',
+    page.metadata.semantic_scholar_id ?? '',
+    page.classification.link_type,
+    ...page.classification.topics,
+    ...page.classification.subtopics.map(subtopicLabel),
+    ...pageKeywords(page),
+    page.reaction ?? 'unrated',
+  ].join(' ');
+}
+
+export function matchesQuery(page: LibraryPage, query: string) {
+  const fields: Record<string, string[]> = {
+    author: page.metadata.authors ?? [],
+    institution: page.metadata.institutions ?? [],
+    journal: [page.metadata.journal ?? ''],
+    type: [page.classification.link_type],
+    topic: page.classification.topics,
+    keyword: pageKeywords(page),
+    subtopic: page.classification.subtopics.flatMap(item => [
+      item.name,
+      subtopicLabel(item),
+    ]),
+    group: page.groups,
+    tag: [...page.manual_tags, ...page.auto_tags],
+    reaction: [page.reaction ?? 'unrated'],
+  };
+  const full = normalized(searchable(page));
+  return Array.from(
+    query.slice(0, 4096).matchAll(/([a-z_]+):"([^"]*)"|"([^"]*)"|(\S+)/gi),
+  ).every(match => {
+    let field = match[1];
+    let term = match[2] ?? match[3] ?? match[4];
+    if (!field && term.includes(':')) {
+      const separator = term.indexOf(':');
+      const candidate = term.slice(0, separator).toLowerCase();
+      if (candidate in fields) {
+        field = candidate;
+        term = term.slice(separator + 1);
+      }
+    }
+    if (!field || !(field.toLowerCase() in fields)) {
+      return full.includes(normalized(term));
+    }
+    const exact = ['type', 'topic', 'keyword', 'tag', 'reaction'].includes(
+      field.toLowerCase(),
+    );
+    return fields[field.toLowerCase()].some(value =>
+      exact
+        ? normalized(value) === normalized(term)
+        : normalized(value).includes(normalized(term)),
+    );
+  });
+}
+
+export function filterPages(
+  pages: LibraryPage[],
+  query: string,
+  filters: LibraryFilters,
+) {
+  return pages.filter(
+    page =>
+      matchesQuery(page, query) &&
+      (!filters.type || page.classification.link_type === filters.type) &&
+      (!filters.topic || page.classification.topics.includes(filters.topic)) &&
+      (!filters.keyword || pageKeywords(page).includes(filters.keyword)) &&
+      (!filters.subtopic ||
+        page.classification.subtopics.some(
+          item => subtopicLabel(item) === filters.subtopic,
+        )) &&
+      (!filters.group ||
+        (filters.group === '__ungrouped__'
+          ? !page.groups.length
+          : pageInCollection(page, filters.group))) &&
+      (!filters.reaction ||
+        (page.reaction ?? 'unrated') === filters.reaction) &&
+      (!filters.author || page.metadata.authors?.includes(filters.author)) &&
+      (!filters.institution ||
+        page.metadata.institutions?.includes(filters.institution)) &&
+      (!filters.dateFrom ||
+        (page.created_at &&
+          page.created_at.slice(0, 10) >= filters.dateFrom)) &&
+      (!filters.dateTo ||
+        (page.created_at && page.created_at.slice(0, 10) <= filters.dateTo)) &&
+      (!filters.metadata ||
+        (filters.metadata === 'missing-authors'
+          ? !page.metadata.authors?.length
+          : !page.metadata.doi &&
+            !page.metadata.openalex_id &&
+            !page.metadata.arxiv_id)),
+  );
+}
+
+function dateOrder(a: string, b: string, newest = true) {
+  const first = Date.parse(a),
+    second = Date.parse(b);
+  if (!Number.isFinite(first)) {
+    return Number.isFinite(second) ? 1 : 0;
+  }
+  if (!Number.isFinite(second)) {
+    return -1;
+  }
+  return newest ? second - first : first - second;
+}
+
+export function sortPages(pages: LibraryPage[], sort: LibrarySort) {
+  return [...pages].sort((a, b) => {
+    let order = 0;
+    if (sort === 'liked' || sort === 'least-liked') {
+      order =
+        ((REACTION_SCORE[b.reaction ?? ''] ?? 0) -
+          (REACTION_SCORE[a.reaction ?? ''] ?? 0)) *
+        (sort === 'liked' ? 1 : -1);
+    } else if (sort === 'annotations' || sort === 'fewest-annotations') {
+      order =
+        (b.annotation_ids.length - a.annotation_ids.length) *
+        (sort === 'annotations' ? 1 : -1);
+    } else if (sort === 'visits' || sort === 'fewest-visits') {
+      order =
+        ((b.collection_signals?.visits_30_days ?? 0) -
+          (a.collection_signals?.visits_30_days ?? 0)) *
+        (sort === 'visits' ? 1 : -1);
+    } else if (sort === 'title' || sort === 'title-desc') {
+      order = a.title.localeCompare(b.title) * (sort === 'title' ? 1 : -1);
+    } else {
+      const modified = sort === 'updated' || sort === 'oldest-updated';
+      order = dateOrder(
+        modified ? a.updated_at : a.created_at,
+        modified ? b.updated_at : b.created_at,
+        sort !== 'oldest' && sort !== 'oldest-updated',
+      );
+    }
+    return (
+      order ||
+      dateOrder(a.created_at, b.created_at) ||
+      a.title.localeCompare(b.title)
+    );
+  });
+}
+
+/** Count distinct annotations for each label, including every coauthor/topic. */
+export function countAnnotationLabels(
+  pages: LibraryPage[],
+  values: (page: LibraryPage) => string[],
+): Count[] {
+  const counts = new Map<string, { label: string; ids: Set<string> }>();
+  for (const page of pages) {
+    if (!page.annotation_ids.length) {
+      continue;
+    }
+    for (const label of values(page)) {
+      if (!label.trim()) {
+        continue;
+      }
+      const key = normalized(label);
+      const item = counts.get(key) ?? { label, ids: new Set<string>() };
+      page.annotation_ids.forEach(id => item.ids.add(id));
+      counts.set(key, item);
+    }
+  }
+  return [...counts.values()]
+    .map(({ label, ids }) => ({ label, count: ids.size }))
+    .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
+}
+
+export function countLabels(
+  pages: LibraryPage[],
+  values: (page: LibraryPage) => string[],
+): Count[] {
+  const counts = new Map<string, { label: string; count: number }>();
+  for (const page of pages) {
+    const seen = new Set<string>();
+    for (const label of values(page)) {
+      const key = normalized(label);
+      if (seen.has(key)) {
+        continue;
+      }
+      seen.add(key);
+      const item = counts.get(key) ?? { label, count: 0 };
+      item.count++;
+      counts.set(key, item);
+    }
+  }
+  return [...counts.values()].sort(
+    (a, b) => b.count - a.count || a.label.localeCompare(b.label),
+  );
+}
+
+export function boardGroups(
+  pages: LibraryPage[],
+  by: string,
+  manualGroups: string[],
+) {
+  const values = (page: LibraryPage) =>
+    by === 'type'
+      ? [
+          page.classification.link_type === 'unknown'
+            ? 'Unclassified'
+            : page.classification.link_type,
+        ]
+      : by === 'topic'
+        ? page.classification.topics
+        : by === 'keyword'
+          ? pageKeywords(page)
+          : by === 'subtopic'
+            ? page.classification.subtopics.map(subtopicLabel)
+            : page.groups;
+  const names =
+    by === 'manual'
+      ? [...manualGroups, 'Ungrouped']
+      : [
+          ...countLabels(pages, page =>
+            values(page).length ? values(page) : ['Unclassified'],
+          ).map(row => row.label),
+        ];
+  return names.map(name => ({
+    name,
+    pages: pages.filter(
+      page =>
+        values(page).includes(name) ||
+        (!values(page).length &&
+          name === (by === 'manual' ? 'Ungrouped' : 'Unclassified')),
+    ),
+  }));
+}
