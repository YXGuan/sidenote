+import { useEffect, useState } from 'preact/hooks';
+
+import { countLabels } from '../helpers/library';
+import type { LibraryPage } from '../helpers/library';
+import {
+  activityBuckets,
+  activityPreferences,
+  ACTIVITY_INTERVALS,
+  ACTIVITY_RANGES,
+  ACTIVITY_PREFERENCE_KEY,
+} from '../helpers/library-activity';
+import LibraryInsights from './LibraryInsights';
+import LibraryShowMore from './LibraryShowMore';
+import { useProgressiveList } from './hooks/use-progressive-list';
+
+export default function LibraryDashboard({
+  pages,
+  onFilter,
+}: {
+  pages: LibraryPage[];
+  onFilter: (field: string, value: string) => void;
+}) {
+  const [preferences, setPreferences] = useState(() =>
+    activityPreferences(localStorage),
+  );
+  const { interval, periods } = preferences;
+  const count = periods[interval];
+  const unit = { daily: 'days', weekly: 'weeks', monthly: 'months' }[interval];
+  const buckets = activityBuckets(pages, interval, count);
+  const history = useProgressiveList(
+    buckets,
+    JSON.stringify([interval, count, buckets]),
+  );
+  useEffect(() => {
+    try {
+      localStorage.setItem(
+        ACTIVITY_PREFERENCE_KEY,
+        JSON.stringify(preferences),
+      );
+    } catch {
+      // The chart remains usable when optional preference storage is unavailable.
+    }
+  }, [preferences]);
+  const annotations = pages.reduce(
+    (sum, p) => sum + p.annotation_ids.length,
+    0,
+  );
+  const visits = pages.reduce(
+    (sum, p) => sum + (p.activity?.visit_count ?? 0),
+    0,
+  );
+  const known = pages.filter(
+    p => p.metadata.openalex_id || p.metadata.semantic_scholar_id,
+  ).length;
+  const max = Math.max(
+    1,
+    ...buckets.flatMap(b => [b.pages, b.annotations, b.visits]),
+  );
+  const y = (n: number) => 188 - (n / max) * 144;
+  const x = (i: number) => 45 + (i / Math.max(1, buckets.length - 1)) * 650;
+  const labelEvery = Math.max(1, Math.ceil((buckets.length - 1) / 6));
+  const path = (field: 'pages' | 'annotations' | 'visits') =>
+    buckets.map((b, i) => `${i ? 'L' : 'M'} ${x(i)} ${y(b[field])}`).join(' ');
+  const types = countLabels(pages, p => [p.classification.link_type]);
+  return (
+    <div className="ld-dashboard">
+      <div className="ld-stat-grid">
+        {[
+          [pages.length, 'Saved pages'],
+          [annotations, 'Annotations'],
+          [visits, 'Recorded visits'],
+          [known, 'Resolved papers'],
+        ].map(([value, label]) => (
+          <div className="ld-stat" key={label}>
+            <span>{label}</span>
+            <strong>{Number(value).toLocaleString()}</strong>
+          </div>
+        ))}
+      </div>
+      <section
+        className="ld-panel ld-activity-chart"
+        aria-label="Reading activity over time"
+      >
+        <div className="ld-section-head">
+          <div>
+            <h2>Reading activity</h2>
+          </div>
+          <div className="ld-activity-controls">
+            <div
+              className="ld-activity-interval"
+              role="group"
+              aria-label="Activity interval"
+            >
+              {ACTIVITY_INTERVALS.map(value => (
+                <button
+                  type="button"
+                  key={value}
+                  aria-pressed={interval === value}
+                  onClick={() =>
+                    setPreferences(current => ({ ...current, interval: value }))
+                  }
+                >
+                  {value[0].toUpperCase() + value.slice(1)}
+                </button>
+              ))}
+            </div>
+            <select
+              aria-label="Activity period"
+              value={count}
+              onChange={e =>
+                setPreferences({
+                  ...preferences,
+                  periods: {
+                    ...periods,
+                    [interval]: Number(e.currentTarget.value),
+                  },
+                })
+              }
+            >
+              {ACTIVITY_RANGES[interval].map(value => (
+                <option key={value} value={value}>
+                  Last {value} {unit}
+                </option>
+              ))}
+            </select>
+          </div>
+        </div>
+        <p className="ld-hint">
+          UTC calendar {unit}
+          {interval === 'weekly' ? ' · Weeks start Monday' : ''} · Current
+          period through today
+        </p>
+        <div className="ld-legend">
+          <span>
+            <i />
+            Pages saved
+          </span>
+          <span>
+            <i />
+            Annotations
+          </span>
+          <span>
+            <i />
+            Recorded visits
+          </span>
+        </div>
+        <svg
+          className="ld-line-chart"
+          viewBox="0 0 740 228"
+          role="img"
+          aria-label={`${interval[0].toUpperCase() + interval.slice(1)} activity for the last ${count} ${unit} (UTC); exact counts in the table below`}
+        >
+          {[0, 0.25, 0.5, 0.75, 1].map(f => (
+            <g key={f}>
+              <line
+                x1="40"
+                x2="710"
+                y1={y(max * f)}
+                y2={y(max * f)}
+                stroke="currentColor"
+                opacity=".09"
+              />
+              <text x="30" y={y(max * f) + 4} textAnchor="end">
+                {Math.round(max * f)}
+              </text>
+            </g>
+          ))}
+          <path
+            d={`${path('pages')} L 695 188 L 45 188 Z`}
+            fill="var(--ld-accent)"
+            opacity=".07"
+          />
+          <path
+            d={path('pages')}
+            fill="none"
+            stroke="var(--ld-accent)"
+            strokeWidth="2.5"
+          />
+          <path
+            d={path('annotations')}
+            fill="none"
+            stroke="var(--ld-chart-annotations, #a183c8)"
+            strokeWidth="2"
+          />
+          <path
+            d={path('visits')}
+            fill="none"
+            stroke="var(--ld-chart-visits, #d5a35e)"
+            strokeWidth="2"
+            strokeDasharray="5 5"
+          />
+          {buckets.map((b, i) => (
+            <g key={`${interval}:${b.key}`}>
+              <circle cx={x(i)} cy={y(b.pages)} r="4" fill="var(--ld-accent)">
+                <title>
+                  {b.key}: {b.pages} saved pages, {b.annotations} annotations,{' '}
+                  {b.visits} recorded visits
+                </title>
+              </circle>
+              {(i % labelEvery === 0 || i === buckets.length - 1) && (
+                <text x={x(i)} y="216" textAnchor="middle">
+                  {b.label}
+                </text>
+              )}
+            </g>
+          ))}
+        </svg>
+        <details className="ld-chart-table">
+          <summary>View activity data</summary>
+          <table>
+            <thead>
+              <tr>
+                <th>
+                  {interval === 'daily'
+                    ? 'Day'
+                    : interval === 'weekly'
+                      ? 'Week starting'
+                      : 'Month'}{' '}
+                  (UTC)
+                </th>
+                <th>Pages saved</th>
+                <th>Annotations</th>
+                <th>Recorded visits</th>
+              </tr>
+            </thead>
+            <tbody key={`${interval}:${count}:${buckets[0].key}`}>
+              {history.items.map(b => (
+                <tr key={`${interval}:${b.key}`}>
+                  <th>{b.key}</th>
+                  <td>{b.pages}</td>
+                  <td>{b.annotations}</td>
+                  <td>{b.visits}</td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+          <LibraryShowMore {...history} label="activity periods" />
+        </details>
+      </section>
+      <LibraryInsights
+        pages={pages}
+        onTopic={value => onFilter('topic', value)}
+        onKeyword={value => onFilter('keyword', value)}
+        onAuthor={value => onFilter('author', value)}
+      />
+      <div className="ld-dashboard-bottom">
+        <section className="ld-panel">
+          <h2>Saved page types</h2>
+          <div className="ld-type-bars">
+            {types.map(t => (
+              <button key={t.label} onClick={() => onFilter('type', t.label)}>
+                <span>{t.label === 'unknown' ? 'Unclassified' : t.label}</span>
+                <span className="ld-bar">
+                  <i
+                    style={{
+                      width: `${(100 * t.count) / Math.max(1, pages.length)}%`,
+                    }}
+                  />
+                </span>
+                <b>{t.count}</b>
+              </button>
+            ))}
+          </div>
+        </section>
+        <section className="ld-panel">
+          <h2>Metadata health</h2>
+          {[
+            [
+              'missing-authors',
+              'Missing authors',
+              pages.filter(p => !p.metadata.authors?.length).length,
+            ],
+            [
+              'missing-ids',
+              'Without a research ID',
+              pages.filter(
+                p =>
+                  !p.metadata.doi &&
+                  !p.metadata.openalex_id &&
+                  !p.metadata.arxiv_id,
+              ).length,
+            ],
+          ].map(([key, label, count]) => (
+            <button
+              key={key}
+              className="ld-health-row"
+              onClick={() => onFilter('metadata', String(key))}
+            >
+              <span>{label}</span>
+              <b>{count} →</b>
+            </button>
+          ))}
+        </section>
+      </div>
+    </div>
+  );
+}
