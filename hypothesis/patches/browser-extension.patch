new file mode 100644
index 0000000..0b7099e
--- /dev/null
+++ b/src/background/saved-page-visits.ts
@@ -0,0 +1,77 @@
+/** Record visits to saved pages only, without browser-history access. */
+export function initSavedPageVisits(
+  tabs: Pick<typeof chrome.tabs, 'get' | 'onActivated' | 'onUpdated'>,
+  bridge: {
+    savedURLs: () => Promise<string[]>;
+    record: (url: string) => Promise<void>;
+  },
+) {
+  if (!tabs?.onActivated || !tabs.onUpdated) {
+    return;
+  }
+  let urls = new Map<string, string>();
+  let loadedAt = 0;
+  let loading: Promise<void> | undefined;
+  const pending = new Set<string>();
+  const recent = new Map<string, number>();
+  const track = async (tab: chrome.tabs.Tab) => {
+    if (
+      tab.incognito ||
+      !tab.active ||
+      tab.status !== 'complete' ||
+      !tab.url?.match(/^https?:\/\//)
+    ) {
+      return;
+    }
+    try {
+      if (Date.now() - loadedAt >= 60_000) {
+        loading ??= bridge
+          .savedURLs()
+          .then(values => {
+            urls = new Map(values.map(value => [new URL(value).href, value]));
+            loadedAt = Date.now();
+          })
+          .finally(() => {
+            loading = undefined;
+          });
+        await loading;
+      }
+      const source = new URL(tab.url);
+      source.hash = '';
+      const url = source.href;
+      if (
+        !urls.has(url) ||
+        pending.has(url) ||
+        Date.now() - (recent.get(url) ?? 0) < 300_000
+      ) {
+        return;
+      }
+      pending.add(url);
+      try {
+        await bridge.record(urls.get(url)!);
+        recent.set(url, Date.now());
+        // Keep a bounded cache in long-lived service workers.
+        for (const [key, stamp] of recent) {
+          if (Date.now() - stamp >= 300_000) {
+            recent.delete(key);
+          }
+        }
+      } finally {
+        pending.delete(url);
+      }
+    } catch {
+      // An unavailable local bridge must not interfere with browsing.
+    }
+  };
+  tabs.onUpdated.addListener((_id, change, tab) => {
+    if (change.status === 'complete' || change.url) {
+      void track(tab);
+    }
+  });
+  tabs.onActivated.addListener(({ tabId }) => {
+    void tabs
+      .get(tabId)
+      .then(track)
+      .catch(() => {});
+  });
+}
