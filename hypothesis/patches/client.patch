+++ b/src/sidebar/components/LibraryUpdateNotice.tsx
@@ -0,0 +1,61 @@
+import { useEffect, useState } from 'preact/hooks';
+
+const DISMISSED_KEY = 'hypothesis.local-library.dismissed-dashboard-update.v1';
+
+/** A missing optional capability should not interrupt reading saved pages. */
+export default function LibraryUpdateNotice({
+  needed,
+}: {
+  needed: boolean | null;
+}) {
+  const [dismissed, setDismissed] = useState(() => {
+    try {
+      return localStorage.getItem(DISMISSED_KEY) === 'true';
+    } catch {
+      return false;
+    }
+  });
+  useEffect(() => {
+    // Wait for a successful capability check before resetting a dismissal.
+    if (needed === false) {
+      setDismissed(false);
+      try {
+        localStorage.removeItem(DISMISSED_KEY);
+      } catch {
+        /* Optional preference. */
+      }
+    }
+  }, [needed]);
+
+  if (!needed || dismissed) {
+    return null;
+  }
+  return (
+    <aside className="ld-update-notice" aria-label="Dashboard update">
+      <div>
+        <span>Dashboard update available</span>
+        <details>
+          <summary>How to update</summary>
+          <p>
+            Open <code>chrome://extensions</code>, click <b>Reload</b> for{' '}
+            <b>sidenote</b>, then refresh this page. Your saved pages and
+            pairing are kept.
+          </p>
+        </details>
+      </div>
+      <button
+        aria-label="Dismiss update notice"
+        onClick={() => {
+          setDismissed(true);
+          try {
+            localStorage.setItem(DISMISSED_KEY, 'true');
+          } catch {
+            /* Keep it dismissed for this page if storage is unavailable. */
+          }
+        }}
+      >
+        Dismiss
+      </button>
+    </aside>
+  );
+}
