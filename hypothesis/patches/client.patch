+/* Console color mode: scoped to the Compact local workspace. */
+.ld-app[data-color-scheme='light'] {
+  color-scheme: light;
+}
+.ld-app[data-color-scheme='dark'] {
+  color-scheme: dark;
+  --ld-bg: oklch(17% 0.008 250);
+  --ld-surface: oklch(21% 0.009 250);
+  --ld-input: oklch(13.5% 0.007 250);
+  --ld-ink: oklch(95% 0.005 250);
+  --ld-muted: oklch(71% 0.01 250);
+  --ld-secondary: oklch(83% 0.008 250);
+  --ld-line: oklch(31% 0.01 250);
+  --ld-control-line: oklch(55% 0.012 250);
+  --ld-accent: oklch(82% 0.15 80);
+  --ld-on-accent: oklch(18% 0.04 75);
+  --ld-tint: oklch(29% 0.05 80);
+  --ld-notice-bg: oklch(24% 0.035 80);
+  --ld-notice-line: oklch(42% 0.06 80);
+  --ld-chart-annotations: oklch(77% 0.12 245);
+  --ld-chart-visits: oklch(71% 0.01 250);
+  --ld-graph-label: #e9edf0;
+  --ld-graph-edge: #56616b;
+  --ld-graph-topic: #e3b85c;
+  --ld-graph-source: #94b6ce;
+  --ld-graph-author: #c9a7d7;
+  --ld-graph-annotation: #a0c7b2;
+  --color-brand: var(--ld-accent);
+  --color-brand-dark: var(--ld-ink);
+  --color-border: var(--ld-line);
+  --color-color-text: var(--ld-ink);
+  --color-color-text-light: var(--ld-muted);
+  --color-color-text-inverted: var(--ld-bg);
+  --color-white: var(--ld-surface);
+  --color-grey-0: var(--ld-surface);
+  --color-grey-1: var(--ld-input);
+  --color-grey-2: var(--ld-line);
+  --color-grey-3: var(--ld-control-line);
+  --color-grey-4: var(--ld-muted);
+  --color-grey-5: var(--ld-muted);
+  --color-grey-6: var(--ld-secondary);
+  --color-grey-7: var(--ld-secondary);
+  --color-grey-8: var(--ld-ink);
+  --color-grey-9: var(--ld-ink);
+  grid-template-columns: 208px minmax(0, 1fr);
+  font:
+    16px/1.5 'Host Grotesk',
+    ui-sans-serif,
+    system-ui,
+    sans-serif;
+}
+.local-library-shell:has(.ld-app[data-color-scheme='dark']) {
+  color-scheme: dark;
+  background: oklch(17% 0.008 250);
+}
