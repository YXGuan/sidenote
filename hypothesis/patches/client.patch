+import cytoscape from 'cytoscape';
+import { useEffect, useRef, useState } from 'preact/hooks';
+
+import type { ResearchGraphData } from '../helpers/research-types';
+import LibraryShowMore from './LibraryShowMore';
+import { CitationDetails } from './ResearchEvidence';
+import { useProgressiveList } from './hooks/use-progressive-list';
+
+export default function ResearchGraph({
+  graph,
+  onTopic,
+  onFocus,
+  onExpand,
+}: {
+  graph: ResearchGraphData;
+  onTopic: (id: string) => void;
+  onFocus: (id: string) => void;
+  onExpand: () => void;
+}) {
+  const container = useRef<HTMLDivElement>(null);
+  const instance = useRef<cytoscape.Core | null>(null);
+  const [selected, setSelection] = useState({
+    focus: graph.focus,
+    kind: 'node',
+    id: graph.focus ?? graph.nodes[0]?.id ?? '',
+  });
+  const selection =
+    selected.focus === graph.focus
+      ? selected
+      : { focus: graph.focus, kind: 'node', id: graph.focus ?? '' };
+  const viewport = useRef<{
+    focus?: string;
+    positions: Record<string, cytoscape.Position>;
+    pan: cytoscape.Position;
+    zoom: number;
+  } | null>(null);
+  const node =
+    graph.nodes.find(n => n.id === selection.id) ??
+    graph.nodes.find(n => n.id === graph.focus);
+  const edge =
+    selection.kind === 'edge'
+      ? graph.edges.find(e => e.id === selection.id)
+      : undefined;
+  const connections = graph.edges.filter(
+    e => e.source === node?.id || e.target === node?.id,
+  );
+  const adjacent = useProgressiveList(
+    connections,
+    (node?.id ?? '') + JSON.stringify(connections),
+  );
+  const nodes = useProgressiveList(graph.nodes, JSON.stringify(graph.nodes));
+  const matches = useProgressiveList(
+    graph.matches ?? [],
+    JSON.stringify(graph.matches ?? []),
+  );
+  const focusOn = (id: string) => {
+    setSelection({ focus: id, kind: 'node', id });
+    onFocus(id);
+  };
+
+  useEffect(() => {
+    if (!container.current) {
+      return undefined;
+    }
+    const saved =
+      viewport.current?.focus === graph.focus ? viewport.current : null;
+    const cy = cytoscape({
+      container: container.current,
+      elements: [
+        ...graph.nodes.map(data => ({
+          data,
+          position: saved?.positions[data.id],
+        })),
+        ...graph.edges.map(data => ({ data })),
+      ],
+      layout:
+        saved && graph.nodes.every(n => saved.positions[n.id])
+          ? { name: 'preset', fit: false }
+          : {
+              name: 'cose',
+              animate: false,
+              nodeRepulsion: () => 16000,
+              idealEdgeLength: () => 160,
+              nodeDimensionsIncludeLabels: true,
+              padding: 50,
+            },
+      style: [
+        {
+          selector: 'node',
+          style: {
+            label: 'data(label)',
+            'font-size': 12,
+            'text-wrap': 'ellipsis',
+            'text-max-width': '130px',
+            'text-valign': 'bottom',
+            'text-margin-y': 8,
+            'background-color': '#859d90',
+            color: '#213e31',
+            width: 24,
+            height: 24,
+          },
+        },
+        {
+          selector: 'node[kind = "topic"], node[kind = "concept"]',
+          style: { 'background-color': '#37674f', width: 36, height: 36 },
+        },
+        {
+          selector: 'node[kind = "annotation"]',
+          style: { 'background-color': '#91a8c3', width: 14, height: 14 },
+        },
+        {
+          selector: 'node[kind = "author"]',
+          style: { 'background-color': '#b49060' },
+        },
+        {
+          selector: 'edge',
+          style: {
+            'curve-style': 'bezier',
+            width: 1,
+            'line-color': '#b9c9be',
+            'target-arrow-color': '#b9c9be',
+            'target-arrow-shape': 'triangle',
+            'arrow-scale': 0.6,
+          },
+        },
+        {
+          selector: 'edge[basis != "metadata"]',
+          style: {
+            label: 'data(relation)',
+            'font-size': 10,
+            'text-rotation': 'autorotate',
+            'text-background-color': '#fafcf9',
+            'text-background-opacity': 0.95,
+            'text-background-padding': '3px',
+            width: 2,
+            'line-color': '#527c66',
+            'target-arrow-color': '#527c66',
+          },
+        },
+        {
+          selector: 'edge[basis = "inferred"]',
+          style: { 'line-style': 'dashed' },
+        },
+        {
+          selector: ':selected',
+          style: {
+            'border-width': 3,
+            'border-color': '#c48d3f',
+            'line-color': '#c48d3f',
+            'target-arrow-color': '#c48d3f',
+          },
+        },
+      ],
+    });
+    instance.current = cy;
+    const themeRoot = container.current.closest('.ld-app');
+    const applyTheme = () => {
+      if (!container.current) {
+        return;
+      }
+      const styles = getComputedStyle(container.current);
+      const color = (name: string, fallback: string) =>
+        styles.getPropertyValue(`--ld-graph-${name}`).trim() || fallback;
+      const dark = themeRoot?.getAttribute('data-color-scheme') === 'dark';
+      cy.style()
+        .selector('node')
+        .style({
+          color: color('label', '#213e31'),
+          'background-color': color('source', '#859d90'),
+        })
+        .selector('node[kind = "topic"], node[kind = "concept"]')
+        .style({ 'background-color': color('topic', '#37674f') })
+        .selector('node[kind = "author"]')
+        .style({ 'background-color': color('author', '#b49060') })
+        .selector('node[kind = "annotation"]')
+        .style({ 'background-color': color('annotation', '#91a8c3') })
+        .selector('edge')
+        .style({
+          'line-color': color('edge', '#b9c9be'),
+          'target-arrow-color': color('edge', '#b9c9be'),
+        })
+        .selector('edge[basis != "metadata"]')
+        .style({
+          color: color('label', '#213e31'),
+          'line-color': color('topic', '#527c66'),
+          'target-arrow-color': color('topic', '#527c66'),
+          'text-background-color': dark ? '#262a30' : '#fafcf9',
+        })
+        .selector(':selected')
+        .style({
+          'border-color': dark ? '#e3b85c' : '#c48d3f',
+          'line-color': dark ? '#e3b85c' : '#c48d3f',
+        })
+        .update();
+    };
+    applyTheme();
+    const themeChanges = new MutationObserver(applyTheme);
+    if (themeRoot) {
+      themeChanges.observe(themeRoot, {
+        attributes: true,
+        attributeFilter: ['data-color-scheme'],
+      });
+    }
+    if (saved && graph.nodes.every(n => saved.positions[n.id])) {
+      cy.pan(saved.pan);
+      cy.zoom(saved.zoom);
+    }
+    cy.on('tap', 'node', event =>
+      setSelection({ focus: graph.focus, kind: 'node', id: event.target.id() }),
+    );
+    cy.on('tap', 'edge', event =>
+      setSelection({ focus: graph.focus, kind: 'edge', id: event.target.id() }),
+    );
+    const resize = new ResizeObserver(() => cy.resize());
+    resize.observe(container.current);
+    return () => {
+      const positions: Record<string, cytoscape.Position> = {};
+      cy.nodes().forEach(n => {
+        positions[n.id()] = n.position();
+      });
+      viewport.current = {
+        focus: graph.focus,
+        positions,
+        pan: cy.pan(),
+        zoom: cy.zoom(),
+      };
+      resize.disconnect();
+      themeChanges.disconnect();
+      cy.destroy();
+      instance.current = null;
+    };
+  }, [graph]);
+
+  useEffect(() => {
+    const cy = instance.current;
+    if (cy) {
+      cy.elements().unselect();
+      cy.getElementById(edge?.id ?? node?.id ?? '').select();
+    }
+  }, [edge?.id, node?.id, graph]);
+
+  return (
+    <>
+      {!!graph.matches?.length && (
+        <details className="rw-graph-matches">
+          <summary>
+            {graph.matches.length} matching concepts and records · choose a
+            starting point
+          </summary>
+          <div className="rw-controls">
+            {matches.items.map(n => (
+              <button
+                key={n.id}
+                className="ld-button"
+                onClick={() => focusOn(n.id)}
+              >
+                {n.label} · {n.kind}
+              </button>
+            ))}
+          </div>
+          <LibraryShowMore {...matches} label="graph search matches" />
+        </details>
+      )}
+      <div className="rw-controls rw-graph-toolbar">
+        <button
+          className="ld-button"
+          onClick={() => instance.current?.fit(undefined, 50)}
+        >
+          Fit connections
+        </button>
+        <button
+          className="ld-button"
+          onClick={() => {
+            const cy = instance.current;
+            if (cy) {
+              cy.zoom(cy.zoom() * 1.3);
+            }
+          }}
+        >
+          Zoom in
+        </button>
+        <button
+          className="ld-button"
+          onClick={() => {
+            const cy = instance.current;
+            if (cy) {
+              cy.zoom(cy.zoom() / 1.3);
+            }
+          }}
+        >
+          Zoom out
+        </button>
+        {graph.focus && (
+          <button
+            className="ld-button"
+            disabled={(graph.depth ?? 1) >= 3}
+            onClick={onExpand}
+          >
+            Expand neighborhood
+          </button>
+        )}
+        <span className="rw-muted">
+          Solid: source-stated · Dashed: inferred · Faint: metadata
+        </span>
+      </div>
+      {!graph.edges.some(e => e.basis && e.basis !== 'metadata') && (
+        <p className="ld-notice">
+          This neighborhood currently shows saved metadata. Synthesize a topic
+          in Wiki to add cited connections between ideas.
+        </p>
+      )}
+      <div className="rw-graph-layout">
+        <div
+          className="rw-graph"
+          ref={container}
+          role="img"
+          aria-label={`Knowledge graph with ${graph.nodes.length} nodes`}
+        />
+        <aside className="rw-graph-inspector" aria-label="Connection inspector">
+          {edge ? (
+            <>
+              <small>
+                {edge.basis === 'metadata'
+                  ? 'Saved metadata'
+                  : edge.basis === 'source-stated'
+                    ? 'Source-stated connection'
+                    : 'Inferred connection'}
+              </small>
+              <h3>{graph.nodes.find(n => n.id === edge.source)?.label}</h3>
+              <p className="rw-relation-label">{edge.relation}</p>
+              <h3>{graph.nodes.find(n => n.id === edge.target)?.label}</h3>
+              {edge.explanation && <p>{edge.explanation}</p>}
+              <p className="rw-muted">
+                Inspect the passages to assess this connection. Matching a quote
+                does not prove the explanation.
+              </p>
+              <CitationDetails key={edge.id} citations={edge.evidence ?? []} />
+              <div className="rw-controls">
+                <button
+                  className="ld-button"
+                  onClick={() => focusOn(edge.source)}
+                >
+                  Explore first concept
+                </button>
+                <button
+                  className="ld-button"
+                  onClick={() => focusOn(edge.target)}
+                >
+                  Explore second concept
+                </button>
+              </div>
+            </>
+          ) : node ? (
+            <>
+              <small>
+                {node.kind === 'topic' || node.kind === 'concept'
+                  ? 'CONCEPT'
+                  : node.kind.toUpperCase()}
+              </small>
+              <h3>{node.label}</h3>
+              {!!node.aliases?.length && (
+                <p>Also called {node.aliases.join(', ')}</p>
+              )}
+              <div className="rw-controls">
+                {node.id !== graph.focus && (
+                  <button
+                    className="ld-button"
+                    onClick={() => focusOn(node.id)}
+                  >
+                    Explore from here
+                  </button>
+                )}
+                {node.page_id && (
+                  <button
+                    className="ld-button"
+                    onClick={() => onTopic(node.page_id!)}
+                  >
+                    Read wiki page
+                  </button>
+                )}
+                {node.url && (
+                  <a href={node.url} target="_blank" rel="noreferrer">
+                    Open original source ↗
+                  </a>
+                )}
+              </div>
+              <h4>Connections</h4>
+              <p className="rw-muted">
+                Choose a connection to inspect its evidence.
+              </p>
+              <ul className="rw-connection-list">
+                {adjacent.items.map(rel => (
+                  <li key={rel.id}>
+                    <button
+                      onClick={() =>
+                        setSelection({
+                          focus: graph.focus,
+                          kind: 'edge',
+                          id: rel.id,
+                        })
+                      }
+                    >
+                      <span>
+                        {graph.nodes.find(n => n.id === rel.source)?.label}{' '}
+                        <b>{rel.relation}</b>{' '}
+                        {graph.nodes.find(n => n.id === rel.target)?.label}
+                      </span>
+                      <small>
+                        {rel.basis === 'metadata'
+                          ? 'Metadata'
+                          : rel.basis === 'source-stated'
+                            ? 'Source-stated'
+                            : 'Inferred'}{' '}
+                        · {rel.evidence?.length ?? 0} passages
+                      </small>
+                    </button>
+                  </li>
+                ))}
+              </ul>
+              <LibraryShowMore {...adjacent} label="connections" />
+            </>
+          ) : (
+            <p>Select a concept or connection to inspect it.</p>
+          )}
+        </aside>
+      </div>
+      <details className="rw-evidence-drawer">
+        <summary>Browse visible nodes · {graph.nodes.length}</summary>
+        <div className="rw-controls">
+          {nodes.items.map(n => (
+            <button
+              className="ld-button"
+              key={n.id}
+              onClick={() =>
+                setSelection({ focus: graph.focus, kind: 'node', id: n.id })
+              }
+            >
+              {n.label} · {n.kind}
+            </button>
+          ))}
+        </div>
+        <LibraryShowMore {...nodes} label="visible graph nodes" />
+      </details>
+      {graph.truncated && (
+        <p className="ld-notice">
+          Showing {graph.nodes.length} of {graph.total_nodes} nodes in this
+          neighborhood. Select a concept to explore a smaller area.
+        </p>
+      )}
+      <p className="rw-muted">{graph.notice}</p>
+    </>
+  );
+}
