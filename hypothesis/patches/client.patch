@@ -0,0 +1,62 @@
+import { mount } from '@hypothesis/frontend-testing';
+
+import LibraryUpdateNotice from '../LibraryUpdateNotice';
+
+describe('LibraryUpdateNotice', () => {
+  beforeEach(() => {
+    const saved = new Map();
+    sinon
+      .stub(Storage.prototype, 'getItem')
+      .callsFake(key => saved.get(key) ?? null);
+    sinon
+      .stub(Storage.prototype, 'setItem')
+      .callsFake((key, value) => saved.set(key, value));
+    sinon
+      .stub(Storage.prototype, 'removeItem')
+      .callsFake(key => saved.delete(key));
+  });
+  const create = needed => mount(<LibraryUpdateNotice needed={needed} />);
+
+  it('keeps reload instructions collapsed without announcing a connection warning', () => {
+    const wrapper = create(true);
+    assert.include(wrapper.text(), 'Dashboard update available');
+    assert.equal(wrapper.find('summary').text(), 'How to update');
+    assert.notOk(wrapper.find('details').prop('open'));
+    assert.include(wrapper.find('details').text(), 'chrome://extensions');
+    assert.lengthOf(wrapper.find('[role="alert"]'), 0);
+    assert.lengthOf(wrapper.find('[role="status"]'), 0);
+    assert.notInclude(wrapper.text(), 'Retry connection');
+  });
+
+  it('remembers dismissal across refreshes, remounts and the initial loading state', () => {
+    const wrapper = create(true);
+    wrapper.find('button').simulate('click');
+    wrapper.setProps({ needed: true });
+    assert.isTrue(wrapper.isEmptyRender());
+    wrapper.unmount();
+    const reloaded = create(null);
+    reloaded.setProps({ needed: true });
+    assert.isTrue(reloaded.isEmptyRender());
+  });
+
+  it('allows a future update hint once the previous capability mismatch is resolved', () => {
+    const wrapper = create(true);
+    wrapper.find('button').simulate('click');
+    wrapper.setProps({ needed: false });
+    assert.isTrue(wrapper.isEmptyRender());
+    wrapper.unmount();
+    assert.isFalse(create(true).isEmptyRender());
+  });
+
+  it('still dismisses for this page when preference storage is unavailable', () => {
+    localStorage.getItem.throws(new Error('Blocked'));
+    localStorage.setItem.throws(new Error('Blocked'));
+    localStorage.removeItem.throws(new Error('Blocked'));
+    const wrapper = create(true);
+    wrapper.find('button').simulate('click');
+    assert.isTrue(wrapper.isEmptyRender());
+    wrapper.setProps({ needed: false });
+    wrapper.setProps({ needed: true });
+    assert.isFalse(wrapper.isEmptyRender());
+  });
+});
