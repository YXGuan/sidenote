+import { mount, mockImportedComponents } from '@hypothesis/frontend-testing';
+
+import AnnotationScopeControls, { $imports } from '../AnnotationScopeControls';
+
+describe('AnnotationScopeControls', () => {
+  let store;
+  beforeEach(() => {
+    store = {
+      annotationScopeEnabled: sinon.stub().returns(true),
+      annotationScope: sinon.stub().returns('mine'),
+      isLoggedIn: sinon.stub().returns(true),
+      setAnnotationScope: sinon.stub(),
+    };
+    $imports.$mock(mockImportedComponents());
+    $imports.$mock({ '../store': { useSidebarStore: () => store } });
+  });
+  afterEach(() => $imports.$restore());
+  it('shows the current scope and lets the user switch between mine and everyone', () => {
+    const wrapper = mount(<AnnotationScopeControls />);
+    const buttons = wrapper.find('Button');
+    assert.isTrue(buttons.at(0).prop('pressed'));
+    assert.isFalse(buttons.at(1).prop('pressed'));
+    buttons.at(1).props().onClick();
