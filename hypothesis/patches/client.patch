+import {
+  DEFAULT_RESEARCH_UPDATES,
+  researchUpdatedAt,
+  researchUpdates,
+} from '../research-updates';
+
+describe('research update preferences', () => {
+  it('distinguishes missing builds from existing results with no build timestamp', () => {
+    assert.equal(researchUpdatedAt(), 'Not built yet');
+    assert.equal(researchUpdatedAt(undefined, true), 'Build time unavailable');
+  });
+  it('keeps Wiki builds manual and refreshes saved graph and atlas results by default', () => {
+    assert.deepEqual(researchUpdates({ getItem: () => null }), {
+      wiki: false,
+      graph: true,
+      kura: true,
+      interval: 60_000,
+    });
+  });
+  it('restores explicit choices from this browser', () => {
+    const saved = { wiki: true, graph: false, kura: false, interval: 300_000 };
+    assert.deepEqual(
+      researchUpdates({ getItem: () => JSON.stringify(saved) }),
+      saved,
+    );
+  });
+  it('rejects invalid timer values and falls back safely for unavailable storage', () => {
+    for (const saved of [
+      'null',
+      '{',
+      '[]',
+      '{"wiki":"true","graph":null,"interval":1}',
+    ]) {
+      assert.deepEqual(
+        researchUpdates({ getItem: () => saved }),
+        DEFAULT_RESEARCH_UPDATES,
+      );
+    }
+    assert.deepEqual(
+      researchUpdates({
+        getItem: () => {
+          throw new Error('Blocked');
+        },
+      }),
+      DEFAULT_RESEARCH_UPDATES,
+    );
+  });
+});
