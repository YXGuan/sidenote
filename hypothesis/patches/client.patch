@@ -0,0 +1,76 @@
+import { loadLibrary } from '../library-loading';
+
+describe('local library loading', () => {
+  it('keeps saved pages when an older worker rejects optional capabilities', async () => {
+    const documents = [{ id: 'saved-page', title: 'A saved paper' }];
+    const result = await loadLibrary(async action => {
+      if (action === 'library') {
+        return { documents };
+      }
+      if (action === 'status') {
+        return { last_sync: { completed: '2026-10-17' } };
+      }
+      throw new Error('Unsupported local research action');
+    });
+    assert.deepEqual(result.library.documents, documents);
+    assert.equal(result.status.last_sync.completed, '2026-10-17');
+    assert.isNull(result.organization);
+    assert.isTrue(result.needsReload);
+    assert.equal(result.warning, '');
+  });
+
+  it('keeps saved pages when both optional requests fail', async () => {
+    const result = await loadLibrary(async action => {
+      if (action === 'library') {
+        return { documents: [{ id: 'saved' }] };
+      }
+      throw new Error('Optional information unavailable');
+    });
+    assert.lengthOf(result.library.documents, 1);
+    assert.isFalse(result.needsReload);
+    assert.include(result.warning, 'unavailable');
+  });
+
+  it('keeps real optional connection failures visible alongside an update hint', async () => {
+    const result = await loadLibrary(async action => {
+      if (action === 'library') {
+        return { documents: [] };
+      }
+      throw new Error(
+        action === 'status'
+          ? 'Connection failed'
+          : 'Unsupported local research action',
+      );
+    });
+    assert.isTrue(result.needsReload);
+    assert.include(result.warning, 'unavailable');
+  });
+
+  it('reports a failed required library request instead of converting it to zero pages', async () => {
+    const error = new Error('Pair this extension');
+    try {
+      await loadLibrary(async action => {
+        if (action === 'library') {
+          throw error;
+        }
+        return {};
+      });
+      assert.fail('Expected a connection error');
+    } catch (actual) {
+      assert.equal(actual, error);
+    }
+  });
+
+  it('accepts a genuinely empty library and rejects a malformed response', async () => {
+    const result = await loadLibrary(async () => ({ documents: [] }));
+    assert.deepEqual(result.library.documents, []);
+    assert.equal(result.warning, '');
+    assert.isFalse(result.needsReload);
+    try {
+      await loadLibrary(async () => ({}));
+      assert.fail('Expected invalid response error');
+    } catch (error) {
+      assert.include(error.message, 'invalid library response');
+    }
+  });
+});
