+import type { Count, LibraryFilters, LibrarySort } from '../helpers/library';
+import SearchableLibraryFilter from './SearchableLibraryFilter';
+
+function SortColumn({
+  label,
+  ascending,
+  descending,
+  sort,
+  onSort,
+}: {
+  label: string;
+  ascending: LibrarySort;
+  descending: LibrarySort;
+  sort: LibrarySort;
+  onSort: (sort: LibrarySort) => void;
+}) {
+  return (
+    <th
+      scope="col"
+      aria-sort={
+        sort === ascending
+          ? 'ascending'
+          : sort === descending
+            ? 'descending'
+            : 'none'
+      }
+    >
+      <div className="ld-sort-heading">
+        <span>{label}</span>
+        <span className="ld-sort-arrows">
+          {(
+            [
+              ['↑', ascending, 'ascending'],
+              ['↓', descending, 'descending'],
+            ] as const
+          ).map(([arrow, value, direction]) => (
+            <button
+              key={value}
+              type="button"
+              aria-label={`Sort ${label.toLowerCase()} ${direction}`}
+              title={`Sort ${label.toLowerCase()} ${direction}`}
+              aria-pressed={sort === value}
+              onClick={() => onSort(value)}
+            >
+              {arrow}
+            </button>
+          ))}
+        </span>
+      </div>
+    </th>
+  );
+}
+
+export default function LibraryTableHeader({
+  sort,
+  onSort,
+  filters,
+  onFilter,
+  topics,
+  authors,
+  showVisits,
+}: {
+  sort: LibrarySort;
+  onSort: (sort: LibrarySort) => void;
+  filters: LibraryFilters;
+  onFilter: (key: keyof LibraryFilters, value: string) => void;
+  topics: Count[];
+  authors: Count[];
+  showVisits: boolean;
+}) {
+  const sortColumn = (
+    label: string,
+    ascending: LibrarySort,
+    descending: LibrarySort,
+  ) => <SortColumn {...{ label, ascending, descending, sort, onSort }} />;
+  return (
+    <thead>
+      <tr>
+        {sortColumn('Page', 'title', 'title-desc')}
+        {(['topic', 'author'] as const).map(key => (
+          <th key={key} scope="col">
+            <SearchableLibraryFilter
+              column
+              label={key === 'topic' ? 'Topic' : 'Authors'}
+              value={filters[key] ?? ''}
+              options={[
+                {
+                  value: '',
+                  label: key === 'topic' ? 'All topics' : 'All authors',
+                },
+                ...(key === 'topic' ? topics : authors).map(item => ({
+                  value: item.label,
+                  label: `${item.label} (${item.count})`,
+                })),
+              ]}
+              onChange={value => onFilter(key, value)}
+            />
+          </th>
+        ))}
+        {sortColumn('Notes', 'fewest-annotations', 'annotations')}
+        {showVisits && sortColumn('Visits (30d)', 'fewest-visits', 'visits')}
+        {sortColumn('Added', 'oldest', 'newest')}
+        {sortColumn('Modified', 'oldest-updated', 'updated')}
+        <th scope="col">Actions</th>
+      </tr>
+    </thead>
+  );
+}
