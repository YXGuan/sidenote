new file mode 100644
index 0000000..715159f
--- /dev/null
+++ b/src/sidebar/helpers/library-activity.ts
@@ -0,0 +1,127 @@
+import type { LibraryPage } from './library';
+
+export const ACTIVITY_INTERVALS = ['daily', 'weekly', 'monthly'] as const;
+export type ActivityInterval = (typeof ACTIVITY_INTERVALS)[number];
+export const ACTIVITY_RANGES: Record<ActivityInterval, number[]> = {
+  daily: [7, 30, 90],
+  weekly: [4, 12, 26],
+  monthly: [3, 6, 12],
+};
+export const ACTIVITY_PREFERENCE_KEY = 'hypothesis.local-library.activity.v1';
+const DEFAULT_PERIODS = { daily: 30, weekly: 12, monthly: 6 };
+
+export function activityPreferences(storage: Pick<Storage, 'getItem'>) {
+  let saved: {
+    interval?: ActivityInterval;
+    periods?: Partial<Record<ActivityInterval, number>>;
+  } | null = null;
+  try {
+    saved = JSON.parse(storage.getItem(ACTIVITY_PREFERENCE_KEY) ?? '{}');
+  } catch {
+    // Optional browser preferences must not prevent reading the dashboard.
+  }
+  return {
+    interval:
+      ACTIVITY_INTERVALS.find(interval => interval === saved?.interval) ??
+      'monthly',
+    periods: Object.fromEntries(
+      ACTIVITY_INTERVALS.map(interval => {
+        const count = saved?.periods?.[interval];
+        return [
+          interval,
+          count !== undefined && ACTIVITY_RANGES[interval].includes(count)
+            ? count
+            : DEFAULT_PERIODS[interval],
+        ];
+      }),
+    ) as Record<ActivityInterval, number>,
+  };
+}
+
+function periodStart(date: Date, interval: ActivityInterval) {
+  const result = new Date(
+    Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()),
+  );
+  if (interval === 'monthly') {
+    result.setUTCDate(1);
+  } else if (interval === 'weekly') {
+    result.setUTCDate(result.getUTCDate() - ((result.getUTCDay() + 6) % 7));
+  }
+  return result;
+}
+
+/** Aggregate complete UTC calendar buckets; weeks start Monday, last bucket ends today. */
+export function activityBuckets(
+  pages: LibraryPage[],
+  interval: ActivityInterval,
+  count: number,
+  today = new Date(),
+) {
+  const current = periodStart(today, interval);
+  const todayKey = today.toISOString().slice(0, 10);
+  const keyFor = (date: Date) =>
+    date.toISOString().slice(0, interval === 'monthly' ? 7 : 10);
+  const buckets = Array.from({ length: count }, (_, i) => {
+    const date = new Date(current);
+    const offset = i - count + 1;
+    if (interval === 'monthly') {
+      date.setUTCMonth(date.getUTCMonth() + offset);
+    } else {
+      date.setUTCDate(
+        date.getUTCDate() + offset * (interval === 'weekly' ? 7 : 1),
+      );
+    }
+    return {
+      key: keyFor(date),
+      label: date.toLocaleDateString(undefined, {
+        month: 'short',
+        ...(interval === 'monthly' ? {} : { day: 'numeric' as const }),
+        timeZone: 'UTC',
+      }),
+      pages: 0,
+      annotations: 0,
+      visits: 0,
+    };
+  });
+  const byKey = new Map(buckets.map(bucket => [bucket.key, bucket]));
+  const add = (
+    day: string,
+    field: 'pages' | 'annotations' | 'visits',
+    value: number,
+  ) => {
+    if (
+      !/^\d{4}-\d{2}-\d{2}$/.test(day) ||
+      day > todayKey ||
+      !Number.isFinite(value) ||
+      value <= 0
+    ) {
+      return;
+    }
+    const date = new Date(day + 'T00:00:00Z');
+    if (
+      !Number.isFinite(date.getTime()) ||
+      date.toISOString().slice(0, 10) !== day
+    ) {
+      return;
+    }
+    const bucket = byKey.get(keyFor(periodStart(date, interval)));
+    if (bucket) {
+      bucket[field] += value;
+    }
+  };
+  for (const page of pages) {
+    const created = new Date(page.created_at);
+    if (Number.isFinite(created.getTime())) {
+      add(created.toISOString().slice(0, 10), 'pages', 1);
+    }
+    for (const [day, value] of Object.entries(page.annotation_activity ?? {})) {
+      add(day, 'annotations', value);
+    }
+    for (const [day, value] of Object.entries(
+      page.activity?.visits_by_day ?? {},
+    )) {
+      add(day, 'visits', value);
+    }
+  }
+  return buckets;
+}
