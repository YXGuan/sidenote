+  const create = (pages = [page(0)], props = {}) =>
+    mount(
+      <ResearchWiki
+        wiki={{ pages, evidence: [evidence], stale: false }}
+        pageID=""
+        busy={false}
+        onSelect={sinon.stub()}
+        onSynthesize={sinon.stub()}
+        onExplore={sinon.stub()}
