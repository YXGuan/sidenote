+import { Button } from '@hypothesis/frontend-shared';
+
+import { useSidebarStore } from '../store';
+
+/** Persistent personal-reading filter for sidenote's browser sidebar. */
+export default function AnnotationScopeControls() {
+  const store = useSidebarStore();
+  const enabled = store.annotationScopeEnabled();
+  const scope = store.annotationScope();
+  const loggedIn = store.isLoggedIn();
+  if (!enabled) {
+    return null;
+  }
+  return (
+    <section
+      className="mb-3 border rounded bg-white p-3 space-y-2"
+      aria-label="Annotation visibility"
+    >
+      <div className="flex items-center justify-between gap-2">
+        <span className="text-xs text-color-text-light">Show annotations</span>
+        <div
+          className="flex gap-1"
+          role="group"
+          aria-label="Annotation authors"
+        >
+          <Button
+            size="sm"
+            variant={scope === 'mine' ? 'primary' : 'secondary'}
+            pressed={scope === 'mine'}
+            onClick={() => store.setAnnotationScope('mine')}
+          >
+            Only mine
+          </Button>
+          <Button
+            size="sm"
+            variant={scope === 'all' ? 'primary' : 'secondary'}
+            pressed={scope === 'all'}
+            onClick={() => store.setAnnotationScope('all')}
+          >
+            Everyone
+          </Button>
+        </div>
+      </div>
+      <p className="text-xs text-color-text-light">
+        {scope === 'mine'
+          ? loggedIn
+            ? 'Only your annotations and page highlights are shown.'
+            : 'Log in to see your own annotations and highlights.'
+          : 'Showing annotations and highlights from everyone in this group.'}
+      </p>
+    </section>
+  );
+}
diff --git a/src/sidebar/components/KuraWorkspace.tsx b/src/sidebar/components/KuraWorkspace.tsx
