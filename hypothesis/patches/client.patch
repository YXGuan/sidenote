+import {
+  libraryPreferences,
+  LIBRARY_PREFERENCE_KEY,
+} from '../library-preferences';
+
+describe('local library preferences', () => {
+  const storage = entries => ({ getItem: key => entries[key] ?? null });
+
+  it('starts on Compact and the library tab', () => {
+    assert.deepEqual(libraryPreferences(storage({}), ''), {
+      design: 'compact',
+      developerMode: false,
+      colorScheme: 'system',
+      tab: 'library',
+      sort: 'newest',
+    });
+  });
+
+  it('moves an existing installation to Compact while retaining its sort', () => {
+    const saved = storage({
+      'hypothesis.local-library.preferences.v2': JSON.stringify({
+        design: 'studio',
+        sort: 'annotations',
+      }),
+    });
+    assert.deepEqual(libraryPreferences(saved, ''), {
+      design: 'compact',
+      developerMode: false,
+      colorScheme: 'system',
+      tab: 'library',
+      sort: 'annotations',
+    });
+  });
+
+  it('uses Compact for all previous layout preferences and links while retaining sorting', () => {
+    for (const design of ['classic', 'studio', 'paper', 'compact']) {
+      const saved = storage({
+        [LIBRARY_PREFERENCE_KEY]: JSON.stringify({ design, sort: 'title' }),
+      });
+      assert.equal(libraryPreferences(saved, '').design, 'compact');
+      assert.equal(libraryPreferences(saved, '').sort, 'title');
+      assert.equal(
+        libraryPreferences(saved, `?design=${design}`).design,
+        'compact',
+      );
+      assert.equal(
+        libraryPreferences(saved, '?design=paper&tab=dashboard').design,
+        'compact',
+      );
+    }
+  });
+
+  it('keeps legacy links and explicit tab selection working', () => {
+    const saved = storage({});
+    assert.equal(libraryPreferences(saved, '?view=list').design, 'compact');
+    assert.equal(libraryPreferences(saved, '?view=table').design, 'compact');
+    assert.equal(libraryPreferences(saved, '?view=overview').tab, 'dashboard');
+    assert.equal(libraryPreferences(saved, '?view=board').tab, 'collections');
+    assert.equal(
+      libraryPreferences(saved, '?tab=collections').tab,
+      'collections',
+    );
+    assert.equal(
+      libraryPreferences(saved, '?design=classic').design,
+      'compact',
+    );
+  });
+
+  it('restores reverse column sorts', () => {
+    for (const sort of ['title-desc', 'oldest-updated', 'fewest-visits']) {
+      const saved = storage({
+        [LIBRARY_PREFERENCE_KEY]: JSON.stringify({ sort }),
+      });
+      assert.equal(libraryPreferences(saved, '').sort, sort);
+    }
+  });
+
+  it('falls back safely for unavailable storage, corrupt JSON, and invalid values', () => {
+    const unavailable = {
+      getItem: () => {
+        throw new Error('Blocked');
+      },
+    };
+    for (const saved of [
+      unavailable,
+      storage({ [LIBRARY_PREFERENCE_KEY]: 'null' }),
+      storage({ [LIBRARY_PREFERENCE_KEY]: '{' }),
+      storage({ [LIBRARY_PREFERENCE_KEY]: '{"design":"nope","sort":"nope"}' }),
+    ]) {
+      assert.deepEqual(
+        libraryPreferences(saved, '?design=unknown&tab=unknown'),
+        {
+          design: 'compact',
+          developerMode: false,
+          colorScheme: 'system',
+          tab: 'library',
+          sort: 'newest',
+        },
+      );
+    }
+  });
+
+  it('restores developer mode only for a saved boolean', () => {
+    for (const value of [true, false, 'true', 1, null]) {
+      const saved = storage({
+        [LIBRARY_PREFERENCE_KEY]: JSON.stringify({ developerMode: value }),
+      });
+      assert.equal(libraryPreferences(saved, '').developerMode, value === true);
+    }
+  });
+
+  it('remembers color mode separately from the retired layouts', () => {
+    for (const colorScheme of ['light', 'dark', 'system']) {
+      const saved = storage({
+        [LIBRARY_PREFERENCE_KEY]: JSON.stringify({
+          design: 'classic',
+          sort: 'title',
+          colorScheme,
+        }),
+      });
+      assert.equal(libraryPreferences(saved, '').colorScheme, colorScheme);
+      assert.equal(libraryPreferences(saved, '').design, 'compact');
+      assert.equal(libraryPreferences(saved, '').sort, 'title');
+    }
+    assert.equal(
+      libraryPreferences(
+        storage({
+          [LIBRARY_PREFERENCE_KEY]: JSON.stringify({ colorScheme: 'unknown' }),
+        }),
+        '',
+      ).colorScheme,
+      'system',
+    );
+  });
+});
