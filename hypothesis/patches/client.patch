+/* Kura: source-linked semantic research atlas. */
+.kura-heading {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 24px;
+  margin-top: 30px;
+}
+.kura-heading h2 {
+  margin: 8px 0;
+  font-size: 30px;
+  letter-spacing: -0.035em;
+}
+.kura-heading > button {
+  flex-shrink: 0;
+}
+.kura-stats {
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 12px;
+  margin: 28px 0 20px;
+}
+.kura-stats > div {
+  padding: 16px 20px;
+  border: 1px solid var(--ld-line, #dce3d9);
+  background: var(--ld-surface, #fff);
+  border-radius: 9px;
+}
+.kura-stats strong {
+  display: block;
+  font-size: 29px;
+  font-weight: 500;
+  margin-top: 5px;
+  font-variant-numeric: tabular-nums;
+}
+.kura-filters {
+  gap: 8px;
+}
+.kura-filters > button {
+  padding: 8px 12px;
+  border: 1px solid var(--ld-line, #d8e1d9);
+  border-radius: 5px;
+}
+.kura-filters > button[aria-pressed='true'] {
+  background: var(--ld-tint, #e4eee6);
+  border-color: var(--ld-line, #809c86);
+}
+.kura-filters input {
+  max-width: 180px;
+}
+.kura-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 1.65fr) minmax(290px, 1fr);
+  gap: 16px;
+  margin-top: 18px;
+  align-items: start;
+}
+.kura-panel {
+  min-width: 0;
+  background: var(--ld-surface, #fff);
+  border: 1px solid var(--ld-line, #dce3d9);
+  border-radius: 10px;
+  padding: 20px;
+}
+.kura-details {
+  max-height: 740px;
+  overflow: auto;
+  position: sticky;
+  top: 16px;
+  overflow-wrap: anywhere;
+}
+.kura-details h3 {
+  font-size: 21px;
+  line-height: 1.3;
+  margin-top: 10px;
+}
+.kura-map {
+  width: 100%;
+  min-height: 370px;
+  touch-action: none;
+  cursor: grab;
+}
+.kura-map-tools {
+  margin: 0 0 10px;
+  gap: 6px;
+}
+.kura-map-tools > span {
+  margin-right: auto;
+  font-weight: 600;
+}
+.kura-map-tools button {
+  border: 1px solid var(--ld-line, #dce3d9);
+  padding: 4px 9px;
+  border-radius: 4px;
+}
+.kura-bubble {
+  cursor: pointer;
+  outline: none;
+}
+.kura-bubble:focus circle,
+.kura-bubble:hover circle {
+  stroke: var(--ld-ink, #253c30);
+  stroke-width: 3;
+}
+.kura-map-label {
+  font-size: 17px;
+  fill: var(--ld-ink, #344d40);
+  paint-order: stroke;
+  stroke: var(--ld-surface, white);
+  stroke-width: 4px;
+  stroke-linejoin: round;
+}
+.kura-legend {
+  display: flex;
+  gap: 8px 18px;
+  flex-wrap: wrap;
+  margin: 18px 0;
+  font-size: 11px;
+  color: var(--ld-muted, #617369);
+}
+.kura-legend button {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  text-align: left;
+}
+.kura-swatch {
+  display: inline-block;
+  width: 9px;
+  height: 9px;
+  border-radius: 3px;
+  flex-shrink: 0;
+}
+.kura-tree,
+.kura-tree ul,
+.kura-sizes {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+}
+.kura-tree-row {
+  display: flex;
+  align-items: flex-start;
+  gap: 2px;
+}
+.kura-tree .kura-tree-toggle,
+.kura-tree-spacer {
+  flex: 0 0 28px;
+  width: 28px;
+  height: 42px;
+}
+.kura-tree .kura-tree-toggle {
+  border-radius: 5px;
+  color: var(--ld-muted, #617369);
+}
+.kura-tree .kura-tree-topic {
+  display: flex;
+  flex: 1;
+  min-width: 0;
+  gap: 9px;
+  align-items: center;
+  text-align: left;
+  border-radius: 5px;
+  padding: 10px 8px;
+  line-height: 1.5;
+}
+.kura-tree-topic > span:nth-child(2) {
+  flex: 1;
+}
+.kura-tree button[aria-pressed='true'],
+.kura-tree button:hover {
+  background: var(--ld-input, #edf2ed);
+}
+.kura-tree button:focus-visible {
+  outline: 2px solid var(--ld-line, #4b7594);
+  outline-offset: -2px;
+}
+.kura-subtopics {
+  border-top: 1px solid var(--ld-line, #dce3d9);
+  margin: 18px 0;
+  padding-top: 12px;
+}
+.kura-subtopics button {
+  display: flex;
+  text-align: left;
+  justify-content: space-between;
+  width: 100%;
+  gap: 12px;
+  padding: 8px 0;
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+.kura-back {
+  font-size: 12px;
+  text-align: left;
+  text-decoration: underline;
+}
+.kura-evidence {
+  border-top: 1px solid var(--ld-line, #dce3d9);
+  margin-top: 18px;
+  padding-top: 18px;
+}
+.kura-evidence > small {
+  font-size: 9px;
+  letter-spacing: 0.08em;
+}
+.kura-evidence h4 {
+  margin-top: 8px;
+  line-height: 1.5;
+  font-weight: 600;
+}
+.kura-evidence .kura-summary {
+  color: var(--ld-muted, #617369);
+  font-size: 12px;
+}
+.kura-evidence details {
+  padding: 10px 0;
+  border: 0;
+  font-size: 12px;
+}
+.kura-evidence blockquote {
+  border-left: 3px solid var(--ld-line, #b6c8b9);
+  padding-left: 12px;
+  margin: 14px 0;
+  white-space: pre-wrap;
+}
+.kura-original {
+  white-space: pre-wrap;
+}
+.kura-sizes button {
+  display: grid;
+  width: 100%;
+  text-align: left;
+  grid-template-columns: 1fr auto;
+  gap: 9px;
+  padding: 15px 4px;
+  border-bottom: 1px solid var(--ld-line, #e5e8e3);
+}
+.kura-sizes button[aria-pressed='true'] {
+  background: var(--ld-input, #edf2ed);
+}
+.kura-bar {
+  display: block;
+  height: 7px;
+  border-radius: 3px;
+  grid-column: 1 / -1;
+}
+.kura-progress {
+  padding: 18px;
+  margin-top: 20px;
+  border: 1px solid var(--ld-line, #b9c9bd);
+  border-radius: 8px;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+  align-items: center;
+}
+.kura-progress small {
+  flex-basis: 100%;
+}
+.kura-progress progress {
+  accent-color: var(--ld-accent, #35634a);
+  max-width: 200px;
+}
+.kura-empty {
+  margin: 30px 0;
+  border: 1px dashed var(--ld-line, #b9c9bd);
+  border-radius: 9px;
+  text-align: center;
+  padding: 40px 20px;
+}
+@media (max-width: 1000px) {
+  .kura-layout {
+    grid-template-columns: 1fr;
+  }
+  .kura-details {
+    position: static;
+    max-height: none;
+  }
+}
+@media (max-width: 600px) {
+  .kura-stats {
+    grid-template-columns: repeat(2, 1fr);
+  }
+  .kura-heading {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+  .kura-map {
+    min-height: 260px;
+  }
+}
