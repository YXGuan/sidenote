@@ -0,0 +1,39 @@
+import type { JSX } from 'preact';
+
+import { libraryRouteHash } from '../helpers/library-routes';
+import type { LibraryRoute } from '../helpers/library-routes';
+
+type Props = Omit<JSX.HTMLAttributes<HTMLAnchorElement>, 'href' | 'onClick'> & {
+  to: LibraryRoute;
+  navigate: (route: LibraryRoute) => void;
+};
+
+/** Keep browser link behavior for new tabs and modifier clicks. */
+export default function LibraryRouteLink({
+  to,
+  navigate,
+  children,
+  ...props
+}: Props) {
+  return (
+    <a
+      {...props}
+      href={libraryRouteHash(to)}
+      onClick={event => {
+        if (
+          event.button !== 0 ||
+          event.metaKey ||
+          event.ctrlKey ||
+          event.shiftKey ||
+          event.altKey
+        ) {
+          return;
+        }
+        event.preventDefault();
+        navigate(to);
+      }}
+    >
+      {children}
+    </a>
+  );
+}
