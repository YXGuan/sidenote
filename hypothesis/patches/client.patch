+  private _getStructuredCitation(): Record<string, string[]> {
+    const result: Record<string, string[]> = {};
+    const array = (value: any): any[] =>
+      Array.isArray(value) ? value : value ? [value] : [];
+    const append = (key: string, value: unknown) => {
+      if (typeof value === 'string' && value.trim()) {
+        result[key] = [...new Set([...(result[key] ?? []), value.trim()])];
+      }
+    };
+    for (const script of Array.from(
+      this.document.querySelectorAll('script[type="application/ld+json"]'),
+    )) {
+      if (!script.textContent || script.textContent.length > 500_000) {
+        continue;
+      }
+      let parsed;
+      try {
+        parsed = JSON.parse(script.textContent);
+      } catch {
+        continue;
+      }
+      for (const item of array(parsed?.['@graph'] ?? parsed)) {
+        if (
+          !array(item?.['@type']).some(type =>
+            [
+              'ScholarlyArticle',
+              'Article',
+              'NewsArticle',
+              'BlogPosting',
+              'Book',
+            ].includes(type),
+          )
+        ) {
+          continue;
+        }
+        append('title', item.headline ?? item.name);
+        append('abstract', item.abstract ?? item.description);
+        append('publication_date', item.datePublished);
+        append('journal_title', item.isPartOf?.name);
+        append(
+          'publisher',
+          typeof item.publisher === 'string'
+            ? item.publisher
+            : item.publisher?.name,
+        );
+        for (const author of array(item.author)) {
+          append('author', typeof author === 'string' ? author : author?.name);
+          for (const affiliation of array(author?.affiliation)) {
+            append(
+              'author_institution',
+              typeof affiliation === 'string' ? affiliation : affiliation?.name,
+            );
+          }
+        }
+        for (const identifier of array(item.identifier)) {
+          if (String(identifier?.propertyID).toLowerCase() === 'doi') {
+            append('doi', identifier.value);
+          }
+        }
+      }
+    }
+    return result;
+  }
