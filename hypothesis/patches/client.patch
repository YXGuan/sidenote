+          aria-label={`Page details: ${selectedPage.title}`}
+        >
+          <header>
+            <span>PAGE DETAILS</span>
+            <div>
+              {/^https?:/.test(selectedPage.url) && (
+                <a href={selectedPage.url} target="_blank" rel="noreferrer">
+                  Open source ↗
+                </a>
+              )}
+              <button
+                className="ld-icon-button"
+                aria-label="Close page details"
+                onClick={() => selectPage(null)}
+              >
+                <Icon name="close" />
+              </button>
+            </div>
+          </header>
+          <h2>{selectedPage.title}</h2>
+          <SavedPage key={selectedPage.url} uri={selectedPage.url} />
+        </aside>
+      )}
+    </div>
+  );
+}
diff --git a/src/sidebar/components/OpenPageLink.tsx b/src/sidebar/components/OpenPageLink.tsx
