+      wrapper.find('[aria-label="Overview"]').text(),
+      'A cited explanation.',
+    );
+    assert.equal(
+      wrapper.find('[aria-label="Overview"] blockquote').text(),
+      'Structure matters.',
+    );
+    assert.include(
+      wrapper.find('[aria-label="Overview"]').text(),
+      'Your comment: I disagree.',
+    );
+    assert.include(wrapper.text(), 'You marked this source Disliked');
+    assert.equal(
+      wrapper.find('[aria-label="Overview"] a').prop('href'),
+      evidence.url,
+    );
+    wrapper
+      .find('button')
+      .filterWhere(b => b.text() === 'Explore connections')
+      .simulate('click');
+    assert.calledWith(explore, 'concept-0');
