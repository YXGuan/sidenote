+                    },
+                    {
+                      kind: 'question',
+                      text: 'Illustrative question: what evidence distinguishes influence from selection?',
+                      evidence: sampleCitations,
+                    },
+                  ],
+                  relationships: [sampleRelation],
+                  markdown:
+                    p.markdown +
+                    '\n\n## Synthesis preview\n\nThis is illustrative text showing where a cited synthesis will appear. No model was called.',
+                }
+              : p,
+          );
+          result = previewWiki;
+        } else if (v.operation === 'lint') {
+          result = { issues: [] };
+        } else if (v.operation === 'ask') {
+          result = {
+            answer:
+              '**Illustrative preview.** This is where an answer combining your notes and web research appears. No model or web search was called.',
+            context: docs.slice(0, 2).map(d => ({
+              id: d.id,
+              title: d.title,
+              url: d.url,
+              text: d.summary,
+            })),
+            used_library: [],
+            web_sources: [],
+          };
+        } else {
+          const results = docs.slice(1, 5).map(d => ({
+            id: d.id,
+            title: d.title,
+            url: d.url,
+            text: d.summary,
+            excerpt: d.summary,
+            matched_terms: ['social', 'network'],
+          }));
+          result = {
+            query: v.query,
+            kind: v.kind,
+            terms: ['social network analysis'],
+            engine: 'Illustrative preview',
+            total: results.length,
+            offset: 0,
+            limit: 50,
+            results,
+            notice: 'Synthetic matches for preview only.',
+          };
+        }
+        researchJob = { id: String(Date.now()), state: 'completed', result };
+        data = { job: researchJob };
+      } else if (m.action === 'library') {
+        data = { documents: docs.filter(doc => !removed.has(doc.id)), groups };
+      } else if (m.action === 'groups') {
+        data = { groups };
+      } else if (m.action === 'status') {
+        data = { last_sync: { completed: new Date().toISOString() } };
+      } else if (m.action === 'organization') {
+        data = {
+          job: { state: 'idle' },
+          backup: previewBackup,
+          enrichment: previewEnrichment,
+          settings: { provider: 'local', model: 'gpt-6-luna', automatic: true },
+        };
+      } else if (m.action === 'settings' || m.action === 'save-settings') {
+        if (m.action === 'save-settings') {
+          previewSettings.preferences = {
+            ...previewSettings.preferences,
+            ...m.values.preferences,
+          };
+          for (const [name, value] of Object.entries(m.values.api_keys ?? {})) {
+            previewSettings.api_keys[name].configured = value !== null;
+          }
+          // Preview stores only configuration flags, never entered key values.
+          sessionStorage.setItem(
+            'preview-maintenance-settings',
+            JSON.stringify(previewSettings),
+          );
+        }
+        data = {
+          ...previewSettings,
+          backup: previewBackup,
+          enrichment: previewEnrichment,
+        };
+      } else if (m.action === 'backup') {
+        previewBackup = {
+          state: 'complete',
+          completed: new Date().toISOString(),
+        };
+        data = { backup: previewBackup };
+      } else if (m.action === 'create-group') {
+        if (!groups.includes(m.name)) {
+          groups.push(m.name);
+        }
+        data = { groups };
+      } else if (['remove', 'restore'].includes(m.action) && doc) {
+        if (m.action === 'remove') {
+          removed.add(doc.id);
+          data = { removed: doc.id };
+        } else {
+          removed.delete(doc.id);
+          data = { document: doc };
+        }
+        sessionStorage.setItem(
+          'preview-removed-pages',
+          JSON.stringify([...removed]),
+        );
+      } else if (m.action === 'update' && doc) {
+        const { metadata, ...values } = m.values;
+        Object.assign(doc, values, { updated_at: new Date().toISOString() });
+        if (metadata) {
+          Object.assign(doc.metadata, metadata);
+        }
+        if ('reaction' in values) {
+          doc.groups = doc.groups.filter((g: string) => g !== 'Likes');
+          if (values.reaction === 'like') {
+            doc.groups.push('Likes');
+          }
+        }
+        if (values.groups) {
+          doc.reaction = values.groups.includes('Likes') ? 'like' : null;
+        }
+        data = { document: doc };
+      } else if (['document', 'suggest-page', 'enrich'].includes(m.action)) {
+        data = { document: doc };
+      } else if (m.action === 'enrich-library') {
+        previewEnrichment = {
+          state: 'complete',
+          done: 3,
+          total: 3,
+          matched: 3,
+          failed: 0,
+          skipped: docs.length - 3,
+          completed: new Date().toISOString(),
+        };
+        data = {
+          enrichment: previewEnrichment,
+        };
+      } else if (m.action === 'organize') {
+        data = {
+          job: {
+            state: 'complete',
+            done: docs.length,
+            total: docs.length,
+            applied: docs.length,
+            failed: 0,
+          },
+        };
+      }
+      return { ok: true, data };
+    },
+  },
+};
+const state = {};
+const previewStore = {
+  getState: () => state,
+  profile: () => ({ userid: 'synthetic-preview-reader' }),
+  subscribe: () => () => {},
+};
+const services = {
+  get: (name: string) => {
+    if (name === 'tags') {
+      return {
+        filter: () => ['language models', 'social science', 'education'],
+      };
+    }
+    if (name === 'store') {
+      return previewStore;
+    }
+    throw new Error(`Unexpected preview service: ${name}`);
+  },
+};
+render(
+  <ServiceContext.Provider value={services}>
+    {/* Match HypothesisApp's scroll container, not just its inner view. */}
+    <div className="h-full min-h-full overflow-auto local-library-shell js-thread-list-scroll-root">
+      <div className="container" style={{ maxWidth: 'none', padding: 0 }}>
+        <main>
+          <LocalLibraryView />
+        </main>
+      </div>
+    </div>
+  </ServiceContext.Provider>,
+  document.getElementById('app')!,
+);
