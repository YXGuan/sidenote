#!/usr/bin/env python3
"""Build the real Hypothesis repositories with the checked-in native patches."""
import argparse
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
REPOS = {
    'client': ('https://github.com/hypothesis/client.git', 'a7b7400d0d706d4357ec37c2a3610b25dcca89d5', '3.6.0'),
    'browser-extension': ('https://github.com/hypothesis/browser-extension.git', 'a29dd56bc736aa231e229e34dc42a1ded49151fc', '3.6.1'),
}


def run(args, cwd):
    subprocess.run(args, cwd=cwd, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--install-deps', action='store_true', help='Refresh locked dependencies even when node_modules exists')
    parser.add_argument('--export-patches', action='store_true', help='Save current modifications from both actual Git checkouts')
    args = parser.parse_args()
    exports = []
    for name, (url, revision, yarn) in REPOS.items():
        repo = ROOT / name
        patch = ROOT / 'patches' / (name + '.patch')
        if args.export_patches:
            head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo).decode().strip()
            if head != revision:
                raise RuntimeError(f'{name} is at another commit; preserve your work and use the pinned revision {revision}')
            body = subprocess.check_output(['git', 'diff', '--binary', 'HEAD'], cwd=repo)
            files = subprocess.check_output(['git', 'ls-files', '--others', '--exclude-standard', '-z'], cwd=repo).decode().split('\0')
            for file in filter(None, files):
                diff = subprocess.run(['git', 'diff', '--no-index', '--binary', '--', '/dev/null', file], cwd=repo, stdout=subprocess.PIPE)
                if diff.returncode not in (0, 1):
                    raise RuntimeError('Unable to export ' + file)
                body += diff.stdout
            if not body.strip():
                raise RuntimeError(f'Refusing to replace {patch.name} with an empty export; existing patches are intact')
            exports.append((patch, body))
            continue
        if not repo.exists():
            run(['git', 'clone', '--no-checkout', url, str(repo)], ROOT)
            run(['git', 'checkout', revision], repo)
        head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo).decode().strip()
        if head != revision:
            raise RuntimeError(f'{name} is at another commit; preserve your work and use the pinned revision {revision}')
        reverse = subprocess.run(['git', 'apply', '--reverse', '--check', str(patch)], cwd=repo, capture_output=True)
        if reverse.returncode:
            run(['git', 'apply', '--check', str(patch)], repo)
            run(['git', 'apply', str(patch)], repo)
        if args.install_deps or not (repo / 'node_modules').exists():
            run(['node', f'.yarn/releases/yarn-{yarn}.cjs', 'install', '--immutable'], repo)
    if args.export_patches:
        # Validate both checkouts before overwriting either tracked patch.
        for patch, body in exports:
            patch.parent.mkdir(parents=True, exist_ok=True)
            patch.write_bytes(body)
            print(f'Exported {patch.relative_to(ROOT)}')
    else:
        run(['node', '.yarn/releases/yarn-3.6.0.cjs', 'build'], ROOT / 'client')
        run(['make', '-B', 'extension', 'SETTINGS_FILE=settings/chrome-research.json'], ROOT / 'browser-extension')
        notices = ROOT.parent / 'third_party' / 'licenses'
        if notices.exists():
            shutil.copytree(notices, ROOT / 'browser-extension/build/licenses', dirs_exist_ok=True)
            shutil.copyfile(ROOT.parent / 'LICENSE', ROOT / 'browser-extension/build/licenses/project.txt')
            shutil.copyfile(ROOT.parent / 'THIRD_PARTY_NOTICES.md', ROOT / 'browser-extension/build/licenses/THIRD_PARTY_NOTICES.md')
        print('\nLoad unpacked: ' + str(ROOT / 'browser-extension/build'))
        print('After rebuilding, click Reload for sidenote in chrome://extensions, then refresh its tabs. Pairing is retained.')
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (RuntimeError, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
