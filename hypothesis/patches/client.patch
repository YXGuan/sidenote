+import { REFRESH_INTERVALS } from '../helpers/research-updates';
+import type { ResearchUpdates } from '../helpers/research-updates';
+
+export default function ResearchUpdateSettings({
+  developerMode = false,
+  value,
+  onChange,
+}: {
+  developerMode?: boolean;
+  value: ResearchUpdates;
+  onChange: (settings: ResearchUpdates) => void;
+}) {
+  return (
+    <details
+      className="rw-update-settings"
+      aria-label="Research update settings"
+    >
+      <summary>Update settings</summary>
+      <div className="rw-update-options">
+        {developerMode && (
+          <>
+            <label htmlFor="research-auto-wiki">
+              <input
+                id="research-auto-wiki"
+                type="checkbox"
+                checked={value.wiki}
+                onChange={event =>
+                  onChange({ ...value, wiki: event.currentTarget.checked })
+                }
+              />
+              <span>Update Wiki automatically</span>
+            </label>
+            <label htmlFor="research-auto-graph">
+              <input
+                id="research-auto-graph"
+                type="checkbox"
+                checked={value.graph}
+                onChange={event =>
+                  onChange({ ...value, graph: event.currentTarget.checked })
+                }
+              />
+              <span>Refresh Knowledge graph automatically</span>
+            </label>
+          </>
+        )}
+        <label htmlFor="research-auto-kura">
+          <input
+            id="research-auto-kura"
+            type="checkbox"
+            checked={value.kura}
+            onChange={event =>
+              onChange({ ...value, kura: event.currentTarget.checked })
+            }
+          />
+          <span>Refresh saved topic classification automatically</span>
+        </label>
+        <label>
+          <span>Refresh interval</span>
+          <select
+            aria-label="Refresh interval"
+            value={value.interval}
+            onChange={event =>
+              onChange({
+                ...value,
+                interval: Number(event.currentTarget.value),
+              })
+            }
+          >
+            {REFRESH_INTERVALS.map(interval => (
+              <option key={interval} value={interval}>
+                {interval === 30_000
+                  ? '30 seconds'
+                  : interval === 60_000
+                    ? '1 minute'
+                    : '5 minutes'}
+              </option>
+            ))}
+          </select>
+        </label>
+      </div>
+    </details>
+  );
+}
diff --git a/src/sidebar/components/ResearchWiki.tsx b/src/sidebar/components/ResearchWiki.tsx
new file mode 100644
index 0000000..26c8a61
--- /dev/null
+++ b/src/sidebar/components/ResearchWiki.tsx
@@ -0,0 +1,316 @@
+import { MarkdownView } from '@hypothesis/annotation-ui';
+import { useState } from 'preact/hooks';
+
+import type { Wiki, WikiPage } from '../helpers/research-types';
+import LibraryShowMore from './LibraryShowMore';
+import { CitationDetails, SavedEvidence } from './ResearchEvidence';
+import { useProgressiveList } from './hooks/use-progressive-list';
+
+function PageList({
+  pages,
+  selected,
+  onSelect,
+  title,
+}: {
+  pages: WikiPage[];
+  selected?: string;
+  onSelect: (id: string) => void;
+  title: string;
+}) {
+  const list = useProgressiveList(
+    pages,
+    JSON.stringify(pages.map(p => p.id)),
+    pages.findIndex(p => p.id === selected) + 1,
+  );
+  return (
+    <div>
+      <h3>{title}</h3>
+      {list.items.map(page => (
+        <button
+          key={page.id}
+          aria-pressed={page.id === selected}
+          onClick={() => onSelect(page.id)}
+        >
+          {page.title}
+          <small>
+            {page.claims?.length
+              ? 'Concept page'
+              : `${page.evidence_ids.length} saved records`}
+            {page.needs_synthesis ? ' · Review needed' : ''}
+          </small>
+        </button>
+      ))}
+      <LibraryShowMore {...list} label={title.toLowerCase()} />
+    </div>
+  );
+}
+
+const sections = [
+  ['overview', 'Overview', 'Write a cited overview from the saved evidence.'],
+  ['idea', 'Key ideas', 'Key ideas will appear after synthesis.'],
+  [
+    'disagreement',
+    'Disagreements',
+    'No disagreement between sources has been identified in the current synthesis.',
+  ],
+  [
+    'question',
+    'Open questions',
+    'No open questions have been identified in the current synthesis.',
+  ],
+] as const;
+
+export default function ResearchWiki({
+  wiki,
+  pageID,
+  busy,
+  onSelect,
+  onSynthesize,
+  onExplore,
+}: {
+  wiki: Wiki;
+  pageID: string;
+  busy: boolean;
+  onSelect: (id: string) => void;
+  onSynthesize: (id: string) => void;
+  onExplore: (id: string) => void;
+}) {
+  const [filter, setFilter] = useState('');
+  const page =
+    wiki.pages.find(p => p.id === pageID) ??
+    (!pageID
+      ? (wiki.pages.find(p => p.kind !== 'source') ?? wiki.pages[0])
+      : undefined);
+  const filtered = wiki.pages.filter(p =>
+    [p.title, ...(p.aliases ?? [])]
+      .join(' ')
+      .toLowerCase()
+      .includes(filter.toLowerCase()),
+  );
+  const evidence = (wiki.evidence ?? []).filter(item =>
+    page?.evidence_ids.includes(item.id),
+  );
+  const sources = new Set(evidence.map(item => item.document_id ?? item.url))
+    .size;
+  const relationships = [
+    ...new Map(
+      wiki.pages.flatMap(p => p.relationships ?? []).map(r => [r.id, r]),
+    ).values(),
+  ].filter(r => r.source === page?.id || r.target === page?.id);
+  const relations = useProgressiveList(
+    relationships,
+    (page?.id ?? '') + JSON.stringify(relationships),
+  );
+  const related = wiki.pages.filter(p => page?.related.includes(p.id));
+  const reading = useProgressiveList(
+    related,
+    (page?.id ?? '') + JSON.stringify(related.map(p => p.id)),
+  );
+  return (
+    <div className="rw-wiki-layout">
+      <nav aria-label="Wiki pages">
+        <label htmlFor="wiki-find">Find a concept or source</label>
+        <input
+          id="wiki-find"
+          type="search"
+          value={filter}
+          onInput={e => setFilter(e.currentTarget.value)}
+          placeholder="Search names and aliases"
+        />
+        <PageList
+          pages={filtered.filter(p => p.kind !== 'source')}
+          selected={page?.id}
+          onSelect={onSelect}
+          title="Concepts"
+        />
+        <PageList
+          pages={filtered.filter(p => p.kind === 'source')}
+          selected={page?.id}
+          onSelect={onSelect}
+          title="Sources"
+        />
+        {!filtered.length && <p>No matching pages. Try another name.</p>}
+      </nav>
+      <article>
+        {page ? (
+          <>
+            <header className="rw-concept-heading">
+              <small>
+                {page.kind === 'source' ? 'SOURCE NOTEBOOK' : 'CONCEPT WIKI'}
+                {sources
+                  ? ` · ${sources} ${sources === 1 ? 'source' : 'sources'}`
+                  : ''}
+              </small>
+              <h2>{page.title}</h2>
+              {!!page.aliases?.length && (
+                <p className="rw-muted">
+                  Also called {page.aliases.join(', ')}
+                </p>
+              )}
+              <div className="rw-controls">
+                {page.kind !== 'source' && (
+                  <button
+                    className="ld-button ld-primary"
+                    disabled={busy || wiki.stale}
+                    onClick={() => onSynthesize(page.id)}
+                  >
+                    {page.provider === 'local'
+                      ? 'Synthesize this topic'
+                      : 'Refresh synthesis'}
+                  </button>
+                )}
+                <button
+                  className="ld-button"
+                  onClick={() => onExplore(page.id)}
+                >
+                  Explore connections
+                </button>
+              </div>
+              {page.kind !== 'source' && (
+                <p className="rw-muted">
+                  Synthesis sends saved passages and your notes to your
+                  signed-in model. Citations show the original evidence.
+                </p>
+              )}
+              {page.coverage && (
+                <small>
+                  Based on {page.coverage.records} saved records across{' '}
+                  {page.coverage.sources} sources. Summaries can omit details;
+                  inspect the saved evidence below.
+                </small>
+              )}
+              {page.needs_synthesis && (
+                <p className="ld-notice">
+                  Evidence changed or this page covers a wider subject. Refresh
+                  the synthesis before relying on these claims.
+                </p>
+              )}
+            </header>
+            {page.kind !== 'source' &&
+              page.claims &&
+              sections.map(([kind, title, empty]) => (
+                <section
+                  key={kind}
+                  className={`rw-concept-section rw-section-${kind}`}
+                  aria-label={title}
+                >
+                  <h3>{title}</h3>
+                  {page.claims!.filter(c => c.kind === kind).length ? (
+                    page
+                      .claims!.filter(c => c.kind === kind)
+                      .map((claim, index) => (
+                        <div key={index} className="rw-concept-statement">
+                          <p>{claim.text}</p>
+                          <CitationDetails
+                            citations={claim.evidence}
+                            evidence={wiki.evidence}
+                          />
+                        </div>
+                      ))
+                  ) : (
+                    <p className="rw-muted">
+                      {page.claims!.length
+                        ? empty
+                        : kind === 'disagreement' || kind === 'question'
+                          ? 'Synthesis has not been run yet.'
+                          : empty}
+                    </p>
+                  )}
+                </section>
+              ))}
+            {!page.claims && (
+              <MarkdownView
+                markdown={page.markdown.replace(/^# .*?(\r?\n|$)/, '')}
+                mentionMode="username"
+              />
+            )}
+            {!!relationships.length && (
+              <section
+                className="rw-concept-section"
+                aria-label="Connected ideas"
+              >
+                <h3>Connected ideas</h3>
+                {relations.items.map(rel => {
+                  const other = wiki.pages.find(
+                    p =>
+                      p.id ===
+                      (rel.source === page.id ? rel.target : rel.source),
+                  );
+                  return (
+                    <div className="rw-concept-statement" key={rel.id}>
+                      <small>
+                        {rel.basis === 'source-stated'
+                          ? 'Source-stated connection'
+                          : 'Inferred connection'}
+                        {wiki.stale ? ' · Evidence changed' : ''}
+                      </small>
+                      <p>
+                        <b>
+                          {wiki.pages.find(p => p.id === rel.source)?.title}
+                        </b>{' '}
+                        {rel.relation}{' '}
+                        <b>
+                          {wiki.pages.find(p => p.id === rel.target)?.title}
+                        </b>
+                      </p>
+                      <p>{rel.explanation}</p>
+                      {other && (
+                        <button
+                          className="ld-button"
+                          onClick={() => onSelect(other.id)}
+                        >
+                          Read {other.title}
+                        </button>
+                      )}
+                      <CitationDetails
+                        citations={rel.evidence ?? []}
+                        evidence={wiki.evidence}
+                      />
+                    </div>
+                  );
+                })}
+                <LibraryShowMore {...relations} label="connected ideas" />
+              </section>
+            )}
+            <details
+              className="rw-evidence-drawer"
+              open={page.kind === 'source'}
+            >
+              <summary>
+                Saved evidence · {page.evidence_ids.length} records
+              </summary>
+              <SavedEvidence items={evidence} pageID={page.id} />
+            </details>
+            {!!related.length && (
+              <section
+                className="rw-concept-section"
+                aria-label="Related reading"
+              >
+                <h3>Related reading</h3>
+                <p className="rw-muted">These pages share saved evidence.</p>
+                <div className="rw-controls">
+                  {reading.items.map(p => (
+                    <button
+                      className="ld-button"
+                      key={p.id}
+                      onClick={() => onSelect(p.id)}
+                    >
+                      {p.title}
+                    </button>
+                  ))}
+                </div>
+                <LibraryShowMore {...reading} label="related pages" />
+              </section>
+            )}
+          </>
+        ) : (
+          <p>
+            {wiki.pages.length
+              ? 'This wiki page is no longer available. Choose a concept or source.'
+              : 'Build your wiki to prepare the saved evidence, then synthesize a topic to write its concept pages.'}
+          </p>
+        )}
+      </article>
+    </div>
+  );
+}
diff --git a/src/sidebar/components/ResearchWorkspace.tsx b/src/sidebar/components/ResearchWorkspace.tsx
new file mode 100644
index 0000000..aed5d87
--- /dev/null
+++ b/src/sidebar/components/ResearchWorkspace.tsx
@@ -0,0 +1,710 @@
+import { MarkdownView } from '@hypothesis/annotation-ui';
+import { useCallback, useEffect, useRef, useState } from 'preact/hooks';
+
+import { LIBRARY_HOME, RESEARCH_VIEWS } from '../helpers/library-routes';
+import type { LibraryRoute } from '../helpers/library-routes';
+import { researchRequest } from '../helpers/local-research';
+import type {
+  Wiki,
+  ResearchGraphData as Graph,
+} from '../helpers/research-types';
+import {
+  researchUpdatedAt,
+  researchUpdates,
+  RESEARCH_UPDATES_KEY,
+} from '../helpers/research-updates';
+import type { ResearchUpdates } from '../helpers/research-updates';
+import KuraWorkspace from './KuraWorkspace';
+import ResearchGraph from './ResearchGraph';
+import ResearchUpdateSettings from './ResearchUpdateSettings';
+import ResearchWiki from './ResearchWiki';
+import { useResearchRefresh } from './hooks/use-research-refresh';
+
+type Evidence = {
+  id: string;
+  title: string;
+  url: string;
+  text: string;
+  excerpt?: string;
+  highlight?: string;
+  comment?: string;
+  matched_terms?: string[];
+};
+type Search = {
+  query: string;
+  kind: string;
+  terms: string[];
+  engine: string;
+  total: number;
+  offset: number;
+  limit: number;
+  results: Evidence[];
+  notice: string;
+};
+type Answer = {
+  answer: string;
+  used_library: Evidence[];
+  context: Evidence[];
+  web_sources: { title: string; url: string }[];
+};
+
+function EvidenceList({ items }: { items: Evidence[] }) {
+  return (
+    <ul className="rw-evidence">
+      {items.map(item => (
+        <li key={item.id}>
+          <a href={item.url} target="_blank" rel="noreferrer">
+            {item.title}
+          </a>
+          {item.highlight && <blockquote>{item.highlight}</blockquote>}
+          {item.comment && (
+            <p>
+              <b>Your comment:</b> {item.comment}
+            </p>
+          )}
+          {!item.highlight && !item.comment && (
+            <p>{item.excerpt ?? item.text}</p>
+          )}
+          {!!item.matched_terms?.length && (
+            <small>Matched: {item.matched_terms.join(', ')}</small>
+          )}
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+export default function ResearchWorkspace({
+  route,
+  navigate,
+  developerMode = false,
+  onDeveloperModeChange,
+}: {
+  developerMode?: boolean;
+  onDeveloperModeChange?: (value: boolean) => void;
+  route: LibraryRoute;
+  navigate: (route: LibraryRoute) => void;
+}) {
+  const { researchView: requestedView, wikiPage: pageID } = route;
+  const developerView = requestedView === 'wiki' || requestedView === 'graph';
+  const view = developerView && !developerMode ? null : requestedView;
+  const setPageID = (wikiPage: string) =>
+    navigate({
+      ...LIBRARY_HOME,
+      tab: 'research',
+      researchView: 'wiki',
+      wikiPage,
+    });
+  const [query, setQuery] = useState('');
+  const [web, setWeb] = useState(true);
+  const [expand, setExpand] = useState(true);
+  const [kind, setKind] = useState('links');
+  const [busy, setBusy] = useState('');
+  const [progress, setProgress] = useState('');
+  const [error, setError] = useState('');
+  const [answer, setAnswer] = useState<Answer | null>(null);
+  const [search, setSearch] = useState<Search | null>(null);
+  const [wiki, setWiki] = useState<Wiki>({ pages: [], stale: false });
+  const [wikiLoaded, setWikiLoaded] = useState(false);
+  const [refreshingWiki, setRefreshingWiki] = useState(false);
+  const [updates, setUpdates] = useState(() => researchUpdates(localStorage));
+  const [graph, setGraph] = useState<Graph | null>(null);
+  const [graphQuery, setGraphQuery] = useState('');
+  const [graphUpdated, setGraphUpdated] = useState('');
+  const [lint, setLint] = useState<{
+    issues: { kind: string; message: string }[];
+  } | null>(null);
+  const active = useRef(true);
+  const wikiRefreshing = useRef(false);
+  const graphRefreshing = useRef(false);
+  const graphFilter = useRef('');
+  const graphFocus = useRef('');
+  const graphDepth = useRef(1);
+  const graphOverview = useRef(false);
+  const graphRequest = useRef(0);
+  const jobRunning = useRef(false);
+  useEffect(() => {
+    active.current = true;
+    return () => {
+      active.current = false;
+    };
+  }, []);
+  const changeUpdates = (value: ResearchUpdates) => {
+    try {
+      localStorage.setItem(RESEARCH_UPDATES_KEY, JSON.stringify(value));
+    } catch {
+      /* Keep settings usable for this page if storage is unavailable. */
+    }
+    setUpdates(value);
+  };
+  const run = useCallback(
+    async (operation: string, values: Record<string, unknown> = {}) => {
+      if (jobRunning.current || graphRefreshing.current) {
+        return;
+      }
+      jobRunning.current = true;
+      setBusy(operation);
+      setProgress('');
+      setError('');
+      try {
+        const start = await researchRequest('research', {
+          values: { operation, ...values },
+        });
+        for (let attempt = 0; attempt < 2400 && active.current; attempt++) {
+          await new Promise(resolve => setTimeout(resolve, 1500));
+          if (!active.current) {
+            return;
+          }
+          const { job } = await researchRequest('research-job');
+          if (job.id !== start.job.id) {
+            throw new Error(
+              'Another research request replaced this one. Submit again.',
+            );
+          }
+          if (job.state === 'failed') {
+            throw new Error(job.error);
+          }
+          if (job.progress) {
+            setProgress(
+              `${job.progress.stage} · ${job.progress.done} / ${job.progress.total}`,
+            );
+          }
+          if (job.state !== 'completed') {
+            continue;
+          }
+          if (operation === 'find') {
+            setSearch(job.result);
+          } else if (operation === 'ask') {
+            setAnswer(job.result);
+          } else if (operation === 'lint') {
+            setLint(job.result);
+          } else {
+            setWiki(job.result);
+            setWikiLoaded(true);
+            setLint(null);
+          }
+          return;
+        }
+        throw new Error('Research is still running. Check again shortly.');
+      } catch (e) {
+        if (active.current) {
+          setError(e.message);
+        }
+      } finally {
+        jobRunning.current = false;
+        if (active.current) {
+          setBusy('');
+        }
+      }
+    },
+    [],
+  );
+  const refreshWiki = useCallback(
+    async (allowBuild = updates.wiki) => {
+      if (wikiRefreshing.current || jobRunning.current) {
+        return;
+      }
+      wikiRefreshing.current = true;
+      setRefreshingWiki(true);
+      setError('');
+      try {
+        const result = await researchRequest('wiki');
+        if (!Array.isArray(result.pages)) {
+          throw new Error(
+            'Wiki data is unavailable. Update the local service and reload the extension.',
+          );
+        }
+        if (active.current) {
+          setWiki(result as Wiki);
+          setWikiLoaded(true);
+          if (
+            allowBuild &&
+            (result.stale || (!result.generated_at && !result.pages.length))
+          ) {
+            const { job } = await researchRequest('research-job');
+            if (!['queued', 'running'].includes(job?.state)) {
+              await run('build-wiki');
+            }
+          }
+        }
+      } catch (e) {
+        if (active.current) {
+          setError(e.message);
+        }
+      } finally {
+        wikiRefreshing.current = false;
+        if (active.current) {
+          setRefreshingWiki(false);
+        }
+      }
+    },
+    [updates.wiki, run],
+  );
+  const loadGraph = useCallback(
+    async (
+      filter = graphFilter.current,
+      focus = graphFocus.current,
+      depth = graphDepth.current,
+      overview = graphOverview.current,
+    ) => {
+      if (jobRunning.current) {
+        return;
+      }
+      const requestID = ++graphRequest.current;
+      graphFilter.current = filter;
+      graphFocus.current = focus;
+      graphDepth.current = depth;
+      graphOverview.current = overview;
+      graphRefreshing.current = true;
+      setBusy('graph');
+      setError('');
+      try {
+        const result = await researchRequest('graph', {
+          values: { query: filter, focus, depth, overview },
+        });
+        if (!Array.isArray(result.nodes) || !Array.isArray(result.edges)) {
+          throw new Error(
+            'Graph data is unavailable. Update the local service and reload the extension.',
+          );
+        }
+        if (active.current && requestID === graphRequest.current) {
+          // Identical refreshes retain canvas positions, selection and list expansion.
+          setGraph(previous =>
+            JSON.stringify(previous) === JSON.stringify(result)
+              ? previous
+              : (result as Graph),
+          );
+          graphFilter.current = filter;
+          graphFocus.current = focus;
+          graphDepth.current = depth;
+          graphOverview.current = overview;
+          setGraphUpdated(new Date().toISOString());
+        }
+      } catch (e) {
+        if (active.current && requestID === graphRequest.current) {
+          setError(e.message);
+        }
+      } finally {
+        if (requestID === graphRequest.current) {
+          graphRefreshing.current = false;
+          if (active.current) {
+            setBusy('');
+          }
+        }
+      }
+    },
+    [],
+  );
+  useEffect(() => {
+    if (route.tab === 'research' && view === 'graph') {
+      if (route.graphNode !== graphFocus.current) {
+        graphFilter.current = '';
+        graphDepth.current = 1;
+        graphOverview.current = false;
+        setGraphQuery('');
+      }
+      graphFocus.current = route.graphNode;
+      void loadGraph();
+    }
+    if (route.tab === 'research' && view === 'wiki') {
+      void refreshWiki(document.visibilityState === 'visible' && updates.wiki);
+    }
+  }, [route.tab, view, route.graphNode, loadGraph, refreshWiki, updates.wiki]);
+  useResearchRefresh({
+    enabled: route.tab === 'research' && view === 'wiki' && updates.wiki,
+    interval: updates.interval,
+    refresh: () => refreshWiki(),
+  });
+  useResearchRefresh({
+    enabled: route.tab === 'research' && view === 'graph' && updates.graph,
+    interval: updates.interval,
+    refresh: () => loadGraph(),
+  });
+  const explore = (graphNode: string) =>
+    navigate({
+      ...LIBRARY_HOME,
+      tab: 'research',
+      researchView: 'graph',
+      graphNode,
+    });
+  return (
+    <section className="rw-workspace" aria-label="Research workspace">
+      <nav className="rw-tabs" aria-label="Research views">
+        {RESEARCH_VIEWS.filter(
+          name => developerMode || (name !== 'wiki' && name !== 'graph'),
+        ).map(name => (
+          <button
+            key={name}
+            disabled={!!busy}
+            aria-pressed={view === name}
+            onClick={() => {
+              navigate({
+                ...LIBRARY_HOME,
+                tab: 'research',
+                researchView: name,
+              });
+              setError('');
+            }}
+          >
+            {
+              (
+                {
+                  ask: 'Ask + web',
+                  find: 'Find in library',
+                  wiki: 'Wiki',
+                  graph: 'Knowledge graph',
+                  kura: 'Topic classification',
+                } as Record<string, string>
+              )[name]
+            }
+          </button>
+        ))}
+      </nav>
+      {developerView && !developerMode && (
+        <section className="ld-panel" aria-label="Developer mode required">
+          <h2>{requestedView === 'wiki' ? 'Wiki' : 'Knowledge graph'}</h2>
+          <p>This experimental view requires developer mode.</p>
+          <button
+            className="ld-button ld-primary"
+            onClick={() => onDeveloperModeChange?.(true)}
+          >
+            Enable developer mode
+          </button>
+        </section>
+      )}
+      <ResearchUpdateSettings
+        value={updates}
+        onChange={changeUpdates}
+        developerMode={developerMode}
+      />
+      {view === 'kura' && (
+        <KuraWorkspace
+          route={route}
+          navigate={navigate}
+          autoRefresh={updates.kura}
+          refreshInterval={updates.interval}
+        />
+      )}
+      {error && (
+        <p className="ld-notice" role="alert">
+          {error}
+        </p>
+      )}
+      {busy && (
+        <p role="status">
+          {busy === 'ask'
+            ? 'Researching your question…'
+            : busy === 'synthesize'
+              ? progress || 'Reading evidence and writing concept pages…'
+              : 'Working…'}
+        </p>
+      )}
+      {(view === 'ask' || view === 'find') && (
+        <>
+          <h2>{view === 'ask' ? 'Ask a question' : 'Find in library'}</h2>
+          <form
+            onSubmit={e => {
+              e.preventDefault();
+              void run(view === 'ask' ? 'ask' : 'find', {
+                query,
+                kind,
+                expand,
+                web,
+                approved: true,
+              });
+            }}
+          >
+            <label className="sr-only" htmlFor="research-question">
+              Question or search
+            </label>
+            <textarea
+              id="research-question"
+              value={query}
+              maxLength={2000}
+              rows={3}
+              onInput={e => setQuery(e.currentTarget.value)}
+              placeholder={
+                view === 'ask'
+                  ? 'Enter your question'
+                  : 'Search saved pages and annotations'
+              }
+            />
+            <div className="rw-controls">
+              {view === 'ask' ? (
+                <label>
+                  <input
+                    type="checkbox"
+                    checked={web}
+                    onChange={e => setWeb(e.currentTarget.checked)}
+                  />{' '}
+                  Allow web research
+                </label>
+              ) : (
+                <>
+                  <label>
+                    Show{' '}
+                    <select
+                      aria-label="Result type"
+                      value={kind}
+                      onChange={e => setKind(e.currentTarget.value)}
+                    >
+                      <option value="links">Links</option>
+                      <option value="annotations">Annotations</option>
+                    </select>
+                  </label>
+                  <label>
+                    <input
+                      type="checkbox"
+                      checked={expand}
+                      onChange={e => setExpand(e.currentTarget.checked)}
+                    />{' '}
+                    Find related terms with AI
+                  </label>
+                </>
+              )}
+              <button
+                className="ld-button ld-primary"
+                disabled={!!busy || !query.trim()}
+              >
+                {view === 'ask' ? 'Ask with library context' : 'Search library'}
+              </button>
+            </div>
+          </form>
+          {view === 'ask' && answer && (
+            <article className="rw-answer">
+              <MarkdownView markdown={answer.answer} mentionMode="username" />
+              <details>
+                <summary>
+                  Library context · {answer.context.length} excerpts supplied ·{' '}
+                  {answer.used_library.length} cited
+                </summary>
+                <EvidenceList items={answer.context} />
+              </details>
+              {!!answer.web_sources.length && (
+                <details open>
+                  <summary>Web sources</summary>
+                  <ul>
+                    {answer.web_sources.map(s => (
+                      <li key={s.url}>
+                        <a href={s.url} target="_blank" rel="noreferrer">
+                          {s.title}
+                        </a>
+                      </li>
+                    ))}
+                  </ul>
+                </details>
+              )}
+            </article>
+          )}
+          {view === 'find' && search && (
+            <div aria-live="polite">
+              <h3>
+                {search.total} matching {search.kind}
+              </h3>
+              {!!search.terms.length && (
+                <p>Related terms: {search.terms.join(', ')}</p>
+              )}
+              <EvidenceList items={search.results} />
+              {!search.total && (
+                <p>
+                  No saved matches. Try a broader topic or disable AI expansion.
+                </p>
+              )}
+              <div className="rw-controls">
+                <button
+                  className="ld-button"
+                  disabled={!!busy || search.offset === 0}
+                  onClick={() =>
+                    void run('find', {
+                      query: search.query,
+                      kind: search.kind,
+                      terms: search.terms,
+                      expand,
+                      offset: Math.max(0, search.offset - search.limit),
+                    })
+                  }
+                >
+                  Previous
+                </button>
+                <span>
+                  {search.total
+                    ? `${search.offset + 1}–${Math.min(search.offset + search.limit, search.total)} of ${search.total}`
+                    : '0 results'}
+                </span>
+                <button
+                  className="ld-button"
+                  disabled={
+                    !!busy || search.offset + search.limit >= search.total
+                  }
+                  onClick={() =>
+                    void run('find', {
+                      query: search.query,
+                      kind: search.kind,
+                      terms: search.terms,
+                      expand,
+                      offset: search.offset + search.limit,
+                    })
+                  }
+                >
+                  Next
+                </button>
+              </div>
+            </div>
+          )}
+        </>
+      )}
+      {view === 'wiki' && (
+        <>
+          <h2>Wiki</h2>
+          <p className="rw-freshness" role="status">
+            {refreshingWiki
+              ? 'Refreshing Wiki…'
+              : !wikiLoaded
+                ? 'Loading saved Wiki…'
+                : `${wiki.pages.length} ${wiki.pages.length === 1 ? 'page' : 'pages'} · ${researchUpdatedAt(wiki.generated_at, !!wiki.pages.length)}${wiki.stale ? ' · Changes pending' : ''}`}
+          </p>
+          <div className="rw-controls">
+            <button
+              className="ld-button ld-primary"
+              disabled={!!busy || refreshingWiki}
+              onClick={() => void run('build-wiki')}
+            >
+              {wiki.pages.length
+                ? 'Update wiki from library'
+                : 'Build wiki from library'}
+            </button>
+            <button
+              className="ld-button"
+              disabled={!!busy || refreshingWiki}
+              onClick={() => void refreshWiki(false)}
+            >
+              Refresh saved Wiki
+            </button>
+            <button
+              className="ld-button"
+              disabled={!!busy || !wiki.pages.length}
+              onClick={() => void run('lint')}
+            >
+              Check wiki
+            </button>
+          </div>
+          {wiki.stale && (
+            <p className="ld-notice">
+              Your library changed. Update the wiki before synthesizing.
+            </p>
+          )}
+          {lint && (
+            <div role="status">
+              {lint.issues.length ? (
+                <ul>
+                  {lint.issues.map((i, n) => (
+                    <li key={n}>
+                      {i.kind}: {i.message}
+                    </li>
+                  ))}
+                </ul>
+              ) : (
+                'Wiki checks passed: links and supporting quotes match the saved evidence.'
+              )}
+            </div>
+          )}
+          <ResearchWiki
+            wiki={wiki}
+            pageID={pageID}
+            busy={!!busy}
+            onSelect={setPageID}
+            onSynthesize={id =>
+              void run('synthesize', { page_id: id, approved: true })
+            }
+            onExplore={explore}
+          />
+        </>
+      )}
+      {view === 'graph' && (
+        <>
+          <h2>Knowledge graph</h2>
+          <p className="rw-freshness" role="status">
+            {graph
+              ? `${graph.nodes.length} visible nodes · ${graph.total_nodes} in this neighborhood · ${graph.library_nodes ?? graph.total_nodes} in library · ${researchUpdatedAt(graphUpdated)}`
+              : 'Loading graph…'}
+          </p>
+          <button
+            className="ld-button"
+            disabled={!!busy}
+            onClick={() => void loadGraph()}
+          >
+            Refresh graph
+          </button>
+          <form
+            className="rw-controls"
+            onSubmit={e => {
+              e.preventDefault();
+              graphDepth.current = 1;
+              graphOverview.current = false;
+              if (route.graphNode) {
+                navigate({ ...route, graphNode: '' });
+              }
+              void loadGraph(graphQuery, '', 1, false);
+            }}
+          >
+            <label htmlFor="graph-topic">Concept, question, or source</label>
+            <input
+              id="graph-topic"
+              value={graphQuery}
+              onInput={e => setGraphQuery(e.currentTarget.value)}
+              placeholder="Computational social science"
+            />
+            <button className="ld-button" disabled={!!busy}>
+              Find connections
+            </button>
+            <button
+              type="button"
+              className="ld-button"
+              disabled={!!busy}
+              onClick={() => {
+                setGraphQuery('');
+                if (route.graphNode) {
+                  navigate({ ...route, graphNode: '' });
+                }
+                void loadGraph('', '', 1, true);
+              }}
+            >
+              Show all
+            </button>
+          </form>
+          {graph?.stale && (
+            <p className="ld-notice">
+              Your library changed. Update the Wiki and refresh its synthesis to
+              restore current concept connections. Saved metadata is still
+              available.
+            </p>
+          )}
+          {graph && !!graph.nodes.length && (
+            <ResearchGraph
+              graph={graph}
+              onFocus={explore}
+              onExpand={() =>
+                void loadGraph(
+                  graphFilter.current,
+                  graph.focus,
+                  Math.min(3, (graph.depth ?? 1) + 1),
+                  false,
+                )
+              }
+              onTopic={id => {
+                setPageID(id);
+                void refreshWiki(false);
+              }}
+            />
+          )}
+          {graph && !graph.nodes.length && (
+            <p>
+              No matching connections. Try a concept name, words from a saved
+              passage, or Show all.
+            </p>
+          )}
+        </>
+      )}
+    </section>
+  );
+}
diff --git a/src/sidebar/components/SearchableLibraryFilter.tsx b/src/sidebar/components/SearchableLibraryFilter.tsx
new file mode 100644
index 0000000..9057092
--- /dev/null
+++ b/src/sidebar/components/SearchableLibraryFilter.tsx
@@ -0,0 +1,167 @@
+import { Popover } from '@hypothesis/frontend-shared';
+import { useEffect, useId, useRef, useState } from 'preact/hooks';
+
+type Option = { value: string; label: string };
+
+export default function SearchableLibraryFilter({
+  label,
+  value,
+  options,
+  onChange,
+  column = false,
+}: {
+  label: string;
+  value: string;
+  options: Option[];
+  onChange: (value: string) => void;
+  column?: boolean;
+}) {
+  const [open, setOpen] = useState(false);
+  const [search, setSearch] = useState('');
+  const [active, setActive] = useState(0);
+  const anchor = useRef<HTMLButtonElement>(null);
+  const input = useRef<HTMLInputElement>(null);
+  const list = useRef<HTMLUListElement>(null);
+  const id = useId();
+  const matches = options.filter(
+    option =>
+      !option.value ||
+      option.label
+        .toLocaleLowerCase()
+        .includes(search.trim().toLocaleLowerCase()),
+  );
+  const selected = options.find(option => option.value === value)?.label;
+  const choose = (option: Option) => {
+    onChange(option.value);
+    setOpen(false);
+  };
+  useEffect(() => {
+    if (open) {
+      input.current?.focus();
+    }
+  }, [open]);
+  useEffect(() => {
+    if (open) {
+      list.current?.children[active]?.scrollIntoView({ block: 'nearest' });
+    }
+  }, [active, open, search]);
+  return (
+    <div
+      className={`ld-searchable-filter ${column ? 'ld-column-filter' : 'ld-choice'}`}
+      onBlur={event => {
+        if (!event.currentTarget.contains(event.relatedTarget as Node | null)) {
+          setOpen(false);
+        }
+      }}
+    >
+      <button
+        type="button"
+        ref={anchor}
+        className={`ld-filter-trigger ${value ? 'is-active' : ''}`}
+        aria-label={`Filter by ${label.toLowerCase()}${column ? ' column' : ''}`}
+        aria-haspopup="dialog"
+        aria-expanded={open}
+        aria-controls={`${id}-popup`}
+        title={value || undefined}
+        onClick={() => {
+          setSearch('');
+          setActive(
+            Math.max(
+              0,
+              options.findIndex(option => option.value === value),
+            ),
+          );
+          setOpen(!open);
+        }}
+      >
+        <span>
+          {column ? (value ? `${label}: ${value}` : label) : selected}
+        </span>
+        <span aria-hidden="true">⌄</span>
+      </button>
+      <Popover
+        open={open}
+        onClose={() => setOpen(false)}
+        anchorElementRef={anchor}
+        classes="ld-column-menu"
+        variant="custom"
+      >
+        <div
+          id={`${id}-popup`}
+          role="dialog"
+          aria-label={`Filter by ${label.toLowerCase()}`}
+        >
+          <input
+            ref={input}
+            role="combobox"
+            aria-label={`Search ${label.toLowerCase()}`}
+            aria-autocomplete="list"
+            aria-expanded={open}
+            aria-controls={`${id}-options`}
+            aria-activedescendant={
+              matches[active] ? `${id}-option-${active}` : undefined
+            }
+            placeholder={`Search ${label.toLowerCase()}…`}
+            value={search}
+            onInput={event => {
+              const term = event.currentTarget.value.trim().toLocaleLowerCase();
+              setSearch(event.currentTarget.value);
+              setActive(
+                term &&
+                  options.some(
+                    option =>
+                      option.value &&
+                      option.label.toLocaleLowerCase().includes(term),
+                  )
+                  ? 1
+                  : 0,
+              );
+            }}
+            onKeyDown={event => {
+              if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+                event.preventDefault();
+                setActive(current =>
+                  Math.max(
+                    0,
+                    Math.min(
+                      matches.length - 1,
+                      current + (event.key === 'ArrowDown' ? 1 : -1),
+                    ),
+                  ),
+                );
+              } else if (event.key === 'Enter' && matches[active]) {
+                event.preventDefault();
+                choose(matches[active]);
+              } else if (event.key === 'Escape') {
+                event.preventDefault();
+                event.stopPropagation();
+                setOpen(false);
+              }
+            }}
+          />
+          <ul id={`${id}-options`} role="listbox" aria-label={label} ref={list}>
+            {matches.map((option, index) => (
+              // Keyboard navigation is handled by the search input.
+              // eslint-disable-next-line jsx-a11y/click-events-have-key-events
+              <li
+                key={option.value}
+                id={`${id}-option-${index}`}
+                role="option"
+                aria-selected={value === option.value}
+                className={index === active ? 'is-highlighted' : ''}
+                onMouseDown={event => event.preventDefault()}
+                onClick={() => choose(option)}
+              >
+                <span>{option.label}</span>
+                {value === option.value && <span aria-hidden="true">✓</span>}
+              </li>
+            ))}
+          </ul>
+          {search && matches.every(option => !option.value) && (
+            <p role="status">No matches found.</p>
+          )}
+        </div>
+      </Popover>
+    </div>
+  );
+}
