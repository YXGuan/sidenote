--- /dev/null
+++ b/src/sidebar/components/hooks/use-research-refresh.ts
@@ -0,0 +1,43 @@
+import { useEffect, useLayoutEffect, useRef } from 'preact/hooks';
+
+/** Refresh visible research views without overlapping timer or focus requests. */
+export function useResearchRefresh({
+  enabled,
+  interval,
+  refresh,
+}: {
+  enabled: boolean;
+  interval: number;
+  refresh: () => Promise<unknown>;
+}) {
+  const callback = useRef(refresh);
+  useLayoutEffect(() => {
+    callback.current = refresh;
+  }, [refresh]);
+  useEffect(() => {
+    if (!enabled) {
+      return undefined;
+    }
+    let pending = false;
+    const update = async () => {
+      if (pending || document.visibilityState !== 'visible') {
+        return;
+      }
+      pending = true;
+      try {
+        await callback.current();
+      } finally {
+        pending = false;
+      }
+    };
+    const timer = setInterval(() => void update(), interval);
+    const visible = () => void update();
+    window.addEventListener('focus', visible);
+    document.addEventListener('visibilitychange', visible);
+    return () => {
+      clearInterval(timer);
+      window.removeEventListener('focus', visible);
+      document.removeEventListener('visibilitychange', visible);
+    };
+  }, [enabled, interval]);
+}
