@@ -0,0 +1,58 @@
+import { createSelector } from 'reselect';
+
+import type { SidebarSettings } from '../../../types/config';
+import { createStoreModule, makeAction } from '../create-store';
+import type { State as AnnotationsState } from './annotations';
+import type { State as SessionState } from './session';
+
+export type AnnotationScope = 'mine' | 'all';
+export type State = { enabled: boolean; scope: AnnotationScope };
+type RootState = {
+  annotationVisibility: State;
+  annotations: AnnotationsState;
+  session: SessionState;
+};
+
+function initialState(
+  settings: Pick<SidebarSettings, 'localResearchAuth'> = {},
+): State {
+  return { enabled: settings.localResearchAuth === true, scope: 'mine' };
+}
+const reducers = {
+  SET_ANNOTATION_SCOPE(_state: State, action: { scope: AnnotationScope }) {
+    return action.scope === 'mine' || action.scope === 'all'
+      ? { scope: action.scope }
+      : {};
+  },
+};
+function setAnnotationScope(scope: AnnotationScope) {
+  return makeAction(reducers, 'SET_ANNOTATION_SCOPE', { scope });
+}
+function annotationScope(state: State): AnnotationScope {
+  return state.enabled ? state.scope : 'all';
+}
+function annotationScopeEnabled(state: State) {
+  return state.enabled;
+}
+
+/** Shared by the sidebar thread list and the page highlight/anchoring bridge.
+ * Filter before building threads so selection/search cannot reveal other authors.
+ * Keep the full loaded collection intact for switching back to Everyone.
+ */
+const annotationsForSidebar = createSelector(
+  (state: RootState) => state.annotations.annotations,
+  (state: RootState) => annotationScope(state.annotationVisibility),
+  (state: RootState) => state.session.profile.userid,
+  (annotations, scope, userid) =>
+    scope === 'all'
+      ? annotations
+      : annotations.filter(a => !!userid && a.user === userid),
+);
+
+export const annotationVisibilityModule = createStoreModule(initialState, {
+  namespace: 'annotationVisibility',
+  reducers,
+  actionCreators: { setAnnotationScope },
+  selectors: { annotationScope, annotationScopeEnabled },
+  rootSelectors: { annotationsForSidebar },
+});
diff --git a/src/sidebar/store/modules/test/annotation-visibility-test.js b/src/sidebar/store/modules/test/annotation-visibility-test.js
new file mode 100644
index 0000000..066d0b7
--- /dev/null
+++ b/src/sidebar/store/modules/test/annotation-visibility-test.js
@@ -0,0 +1,53 @@
+import { defaultAnnotation } from '../../../test/annotation-fixtures';
+import { createSidebarStore } from '../../index';
+
+const ME = 'acct:reader@hypothes.is';
+const OTHER = 'acct:other@hypothes.is';
+const makeAnnotation = (id, user) => ({ ...defaultAnnotation(), id, user });
+
+describe('personal annotation visibility', () => {
+  let store;
+  beforeEach(() => {
+    store = createSidebarStore({ localResearchAuth: true });
+    store.updateProfile({ userid: ME, features: {}, preferences: {} });
+    store.addAnnotations([
+      makeAnnotation('mine', ME),
+      makeAnnotation('other', OTHER),
+    ]);
+  });
+  const visible = () => store.annotationsForSidebar().map(a => a.id);
+
+  it('defaults to only the signed-in account while retaining everyone in the store', () => {
+    assert.equal(store.annotationScope(), 'mine');
+    assert.deepEqual(visible(), ['mine']);
+    assert.lengthOf(store.allAnnotations(), 2);
+  });
+  it('can switch to everyone and back without deleting or refetching annotations', () => {
+    store.setAnnotationScope('all');
+    assert.deepEqual(visible(), ['mine', 'other']);
+    store.setAnnotationScope('mine');
+    assert.deepEqual(visible(), ['mine']);
+    assert.lengthOf(store.allAnnotations(), 2);
+  });
+  it('keeps the scope when a new annotation is drafted, saved and updated', () => {
+    store.addAnnotations([{ ...makeAnnotation(undefined, ME), $tag: 'draft' }]);
+    assert.isTrue(store.annotationsForSidebar().some(a => a.$tag === 'draft'));
+    store.addAnnotations([{ ...makeAnnotation('saved', ME), $tag: 'draft' }]);
+    store.addAnnotations([makeAnnotation('streamed-other', OTHER)]);
+    assert.sameMembers(visible(), ['mine', 'saved']);
+    assert.equal(store.annotationScope(), 'mine');
+  });
+  it('follows account changes and hides all annotations when logged out', () => {
+    store.updateProfile({ userid: OTHER, features: {}, preferences: {} });
+    assert.deepEqual(visible(), ['other']);
+    store.updateProfile({ userid: null, features: {}, preferences: {} });
+    assert.deepEqual(visible(), []);
+  });
+  it('does not restrict other Hypothesis deployments', () => {
+    const original = createSidebarStore({});
+    original.addAnnotations([makeAnnotation('other', OTHER)]);
+    assert.equal(original.annotationScope(), 'all');
+    assert.isFalse(original.annotationScopeEnabled());
+    assert.lengthOf(original.annotationsForSidebar(), 1);
+  });
+});
