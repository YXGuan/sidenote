diff --git a/src/sidebar/components/ResearchEvidence.tsx b/src/sidebar/components/ResearchEvidence.tsx
new file mode 100644
index 0000000..7aa09ea
--- /dev/null
+++ b/src/sidebar/components/ResearchEvidence.tsx
@@ -0,0 +1,124 @@
+import type { Citation, ResearchEvidence } from '../helpers/research-types';
+import LibraryShowMore from './LibraryShowMore';
+import { useProgressiveList } from './hooks/use-progressive-list';
+
+function Passage({ item, quote }: { item: ResearchEvidence; quote?: string }) {
+  const origin = quote
+    ? item.highlight?.includes(quote)
+      ? 'Source highlight'
+      : item.comment?.includes(quote)
+        ? 'Your comment'
+        : item.personal_note?.includes(quote)
+          ? 'Your personal note'
+          : item.source_text?.includes(quote)
+            ? 'Saved source metadata'
+            : 'Saved passage'
+    : '';
+  return (
+    <div className="rw-passage">
+      <a href={item.url} target="_blank" rel="noreferrer">
+        {item.title}
+      </a>
+      {item.reaction === 'bad' && (
+        <small>You marked this source Disliked</small>
+      )}
+      {quote ? (
+        <>
+          <small>{origin}</small>
+          <blockquote>{quote}</blockquote>
+        </>
+      ) : (
+        <>
+          {item.highlight && (
+            <>
+              <small>Source highlight</small>
+              <blockquote>{item.highlight}</blockquote>
+            </>
+          )}
+          {item.source_text && <p>{item.source_text}</p>}
+          {item.personal_note && (
+            <p>
+              <b>Your personal note:</b> {item.personal_note}
+            </p>
+          )}
+        </>
+      )}
+      {item.comment && origin !== 'Your comment' && (
+        <p>
+          <b>Your comment:</b> {item.comment}
+        </p>
+      )}
+    </div>
+  );
+}
+
+export function CitationDetails({
+  citations,
+  evidence = [],
+}: {
+  citations: Citation[];
+  evidence?: ResearchEvidence[];
+}) {
+  const resolved = citations.map(ref => {
+    const record = evidence.find(item => item.id === ref.evidence_id);
+    return {
+      ref,
+      record:
+        record ??
+        (ref.title && ref.url
+          ? ({ ...ref, id: ref.evidence_id } as ResearchEvidence)
+          : undefined),
+    };
+  });
+  const list = useProgressiveList(resolved, JSON.stringify(citations));
+  return (
+    <details className="rw-citations">
+      <summary>
+        Evidence · {citations.length}{' '}
+        {citations.length === 1 ? 'passage' : 'passages'}
+      </summary>
+      {list.items.map(({ ref, record }, index) =>
+        record &&
+        ref.quote &&
+        record.text !== undefined &&
+        !record.text.includes(ref.quote) ? (
+          <p key={index}>
+            This quotation no longer matches the saved record. Update the wiki
+            and refresh synthesis.
+          </p>
+        ) : record ? (
+          <Passage
+            key={`${ref.evidence_id}-${index}`}
+            item={record}
+            quote={ref.quote}
+          />
+        ) : (
+          <p key={index}>
+            This saved passage is no longer available. Update the wiki.
+          </p>
+        ),
+      )}
+      {citations.length > 20 && (
+        <LibraryShowMore {...list} label="supporting passages" />
+      )}
+    </details>
+  );
+}
+
+export function SavedEvidence({
+  items,
+  pageID,
+}: {
+  items: ResearchEvidence[];
+  pageID: string;
+}) {
+  const list = useProgressiveList(items, pageID + JSON.stringify(items));
+  return (
+    <div className="rw-saved-evidence">
+      {list.items.map(item => (
+        <Passage key={item.id} item={item} />
+      ))}
+      <LibraryShowMore {...list} label="saved evidence" />
+    </div>
+  );
+}
