+import { Card, CardContent } from '@hypothesis/frontend-shared';
+
+import {
+  countAnnotationLabels,
+  countLabels,
+  pageKeywords,
+} from '../helpers/library';
+import type { Count, LibraryPage } from '../helpers/library';
+import LibraryShowMore from './LibraryShowMore';
+import { useProgressiveList } from './hooks/use-progressive-list';
+
+function RankedChart({
+  title,
+  rows,
+  onSelect,
+  unit,
+}: {
+  title: string;
+  rows: Count[];
+  onSelect: (label: string) => void;
+  unit: string;
+}) {
+  const maximum = rows[0]?.count ?? 1;
+  const batch = useProgressiveList(rows, JSON.stringify([title, rows]));
+  return (
+    <Card>
+      <CardContent classes="space-y-3">
+        <h2 className="text-sm font-bold">{title}</h2>
+        {!rows.length && (
+          <p className="text-xs text-color-text-light">
+            No data yet. Organize pages or capture their metadata.
+          </p>
+        )}
+        <ol className="space-y-2" aria-label={title}>
+          {batch.items.map(row => (
+            <li key={row.label}>
+              <button
+                className="block text-left w-full focus-visible-ring rounded"
+                title={`Filter ${row.label}`}
+                aria-label={`${row.label}: ${row.count} ${row.count === 1 ? unit.slice(0, -1) : unit}. Filter`}
+                onClick={() => onSelect(row.label)}
+              >
+                <span className="flex justify-between gap-2 text-xs mb-1">
+                  <span className="break-words">{row.label}</span>
+                  <span className="shrink-0 tabular-nums">{row.count}</span>
+                </span>
+                <span className="block h-2 rounded bg-grey-1">
+                  <span
+                    className="block h-2 rounded bg-red-6"
+                    style={{ width: `${(row.count / maximum) * 100}%` }}
+                  />
+                </span>
+              </button>
+            </li>
+          ))}
+        </ol>
+        <LibraryShowMore {...batch} label={title} />
+      </CardContent>
+    </Card>
+  );
+}
+
+export default function LibraryInsights({
+  pages,
+  onTopic,
+  onKeyword,
+  onAuthor,
+  compact = false,
+}: {
+  pages: LibraryPage[];
+  onTopic: (value: string) => void;
+  onKeyword: (value: string) => void;
+  onAuthor: (value: string) => void;
+  compact?: boolean;
+}) {
+  return (
+    <section
+      aria-label="Library insights"
+      className="library-insights space-y-2"
+    >
+      <div
+        className={
+          compact ? 'space-y-7' : 'grid grid-cols-1 md:grid-cols-3 gap-3'
+        }
+      >
+        {(['annotations', 'pages'] as const).map(metric => {
+          const count =
+            metric === 'annotations' ? countAnnotationLabels : countLabels;
+          const prefix = metric === 'annotations' ? 'Annotations' : 'Pages';
+          return [
+            <RankedChart
+              key={`${metric}:topic`}
+              title={`${prefix} by topic`}
+              unit={metric}
+              rows={count(pages, page => page.classification.topics)}
+              onSelect={onTopic}
+            />,
+            <RankedChart
+              key={`${metric}:keyword`}
+              title={`${prefix} by keyword`}
+              unit={metric}
+              rows={count(pages, pageKeywords)}
+              onSelect={onKeyword}
+            />,
+            <RankedChart
+              key={`${metric}:author`}
+              title={`${prefix} by authors`}
+              unit={metric}
+              rows={count(pages, page => page.metadata.authors ?? [])}
+              onSelect={onAuthor}
+            />,
+          ];
+        })}
+      </div>
+    </section>
+  );
+}
diff --git a/src/sidebar/components/LibraryRecommendations.tsx b/src/sidebar/components/LibraryRecommendations.tsx
