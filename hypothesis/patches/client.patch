+import { researchRequest } from './local-research';
+
+/** Optional worker capabilities must never hide a successfully loaded library. */
+export async function loadLibrary(request = researchRequest) {
+  const [library, status, organization] = await Promise.allSettled([
+    request('library'),
+    request('status'),
+    request('organization'),
+  ]);
+  if (library.status === 'rejected') {
+    throw library.reason;
+  }
+  if (!Array.isArray(library.value.documents)) {
+    throw new Error('The local service returned an invalid library response.');
+  }
+  const failures = [status, organization].filter(
+    result => result.status === 'rejected',
+  );
+  const unsupported = (result: PromiseSettledResult<unknown>) =>
+    result.status === 'rejected' &&
+    String(result.reason?.message).includes(
+      'Unsupported local research action',
+    );
+  return {
+    library: library.value,
+    status: status.status === 'fulfilled' ? status.value : null,
+    organization:
+      organization.status === 'fulfilled' ? organization.value : null,
+    needsReload: failures.some(unsupported),
+    warning: failures.some(result => !unsupported(result))
+      ? 'Some dashboard information is unavailable.'
+      : '',
+  };
+}
