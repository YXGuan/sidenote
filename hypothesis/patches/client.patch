@@ -0,0 +1,366 @@
+import { Button, Input } from '@hypothesis/frontend-shared';
+import { useState } from 'preact/hooks';
+
+import { pageKeywords } from '../helpers/library';
+import type { ResearchDocument } from '../helpers/local-research';
+
+const TYPES = [
+  'unknown',
+  'paper',
+  'blog',
+  'news',
+  'video',
+  'podcast',
+  'book',
+  'documentation',
+  'website',
+  'other',
+];
+export default function PageMetadataEditor({
+  doc,
+  busy,
+  onSave,
+}: {
+  doc: ResearchDocument;
+  busy: boolean;
+  onSave: (values: Record<string, unknown>) => Promise<boolean>;
+}) {
+  const [editing, setEditing] = useState(false);
+  const [draft, setDraft] = useState<Record<string, string>>({});
+  const [kind, setKind] = useState('unknown');
+  const [topics, setTopics] = useState('');
+  const [keywords, setKeywords] = useState('');
+  const arxiv = doc.metadata.arxiv_id;
+  const validArxiv =
+    arxiv && /^(?:\d{4}\.\d{4,5}|[a-zA-Z.-]+\/\d{7})(?:v\d+)?$/.test(arxiv);
+  const fields = [
+    ['authors', 'Authors', doc.metadata.authors?.join('; ')],
+    ['institutions', 'Institutions', doc.metadata.institutions?.join('; ')],
+    ['journal', 'Journal', doc.metadata.journal],
+    ['doi', 'DOI', doc.metadata.doi],
+    ['arxiv_id', 'arXiv ID', doc.metadata.arxiv_id],
+    ['published', 'Published', doc.metadata.published],
+  ] as const;
+  const begin = () => {
+    setDraft(
+      Object.fromEntries(fields.map(([key, , value]) => [key, value ?? ''])),
+    );
+    setKind(doc.classification.link_type);
+    setTopics(doc.classification.topics.join('; '));
+    setKeywords(pageKeywords(doc).join('; '));
+    setEditing(true);
+  };
+  const names = (s: string, delimiter: string) => [
+    ...new Set(
+      s
+        .split(delimiter)
+        .map(v => v.trim())
+        .filter(Boolean),
+    ),
+  ];
+  return (
+    <section className="research-metadata-editor">
+      <div className="flex items-center justify-between mb-2">
+        <h4 className="text-xs font-bold">Classification &amp; citation</h4>
+        <Button
+          size="sm"
+          variant="secondary"
+          disabled={busy}
+          onClick={() => (editing ? setEditing(false) : begin())}
+        >
+          {editing ? 'Cancel' : 'Edit details'}
+        </Button>
+      </div>
+      {editing ? (
+        <form
+          className="space-y-3"
+          onSubmit={async e => {
+            e.preventDefault();
+            const topicNames = names(topics, ';');
+            const keywordNames = names(keywords, ';');
+            const classificationChanged =
+              kind !== doc.classification.link_type ||
+              JSON.stringify(topicNames) !==
+                JSON.stringify(doc.classification.topics) ||
+              JSON.stringify(keywordNames) !==
+                JSON.stringify(pageKeywords(doc));
+            const metadata = Object.fromEntries(
+              fields.map(([key]) => [
+                key,
+                key === 'authors' || key === 'institutions'
+                  ? names(draft[key] ?? '', ';')
+                  : (draft[key] ?? '').trim(),
+              ]),
+            );
+            const success = await onSave({
+              metadata,
+              ...(classificationChanged
+                ? {
+                    classification: {
+                      link_type: kind,
+                      topics: topicNames,
+                      keywords: keywordNames,
+                      subtopics: [],
+                    },
+                  }
+                : {}),
+            });
+            if (success) {
+              setEditing(false);
+            }
+          }}
+        >
+          <label className="block text-xs space-y-1">
+            <span>Source type</span>
+            <select
+              className="research-field"
+              aria-label="Source type correction"
+              value={kind}
+              onChange={e => setKind(e.currentTarget.value)}
+            >
+              {TYPES.map(t => (
+                <option key={t} value={t}>
+                  {t === 'unknown' ? 'Unclassified' : t}
+                </option>
+              ))}
+            </select>
+          </label>
+          <label
+            htmlFor={`topics-${doc.id}`}
+            className="block text-xs space-y-1"
+          >
+            <span>Topics · separate with semicolons</span>
+            <Input
+              id={`topics-${doc.id}`}
+              aria-label="Topics correction"
+              value={topics}
+              onInput={e => setTopics(e.currentTarget.value)}
+            />
+          </label>
+          <label
+            htmlFor={`keywords-${doc.id}`}
+            className="block text-xs space-y-1"
+          >
+            <span>Keywords · separate with semicolons</span>
+            <Input
+              id={`keywords-${doc.id}`}
+              aria-label="Keywords correction"
+              placeholder="Machine learning; Metacognition"
+              value={keywords}
+              onInput={e => setKeywords(e.currentTarget.value)}
+            />
+          </label>
+          {fields.map(([key, label]) => (
+            <label key={key} className="block text-xs space-y-1">
+              <span>
+                {label}
+                {key === 'authors' || key === 'institutions'
+                  ? ' · separate names with semicolons'
+                  : ''}
+              </span>
+              <Input
+                aria-label={`${label} correction`}
+                value={draft[key] ?? ''}
+                onInput={e =>
+                  setDraft(current => ({
+                    ...current,
+                    [key]: e.currentTarget.value,
+                  }))
+                }
+              />
+            </label>
+          ))}
+          <p className="text-xs text-color-text-light">
+            Your corrections take priority over extraction. Clearing a field
+            keeps it empty.
+          </p>
+          <Button type="submit" size="sm" disabled={busy}>
+            Save corrections
+          </Button>
+        </form>
+      ) : (
+        <>
+          <p className="text-xs text-color-text-light mb-2">
+            {doc.classification_manual
+              ? 'Manually corrected'
+              : doc.classification_source === 'openalex'
+                ? 'Topics & keywords from OpenAlex'
+                : 'Automatically classified · local taxonomy'}
+            {doc.classification_manual && (
+              <button
+                className="research-reset"
+                disabled={busy}
+                onClick={() => onSave({ classification: null })}
+              >
+                Use automatic classification
+              </button>
+            )}
+          </p>
+          <dl className="text-sm space-y-2">
+            <div>
+              <dt>Link type</dt>
+              <dd>
+                {doc.classification.link_type === 'unknown'
+                  ? 'Unclassified'
+                  : doc.classification.link_type}
+              </dd>
+            </div>
+            <div>
+              <dt>Topics</dt>
+              <dd>{doc.classification.topics.join(', ') || 'Unclassified'}</dd>
+            </div>
+            <div>
+              <dt>Keywords</dt>
+              <dd>{pageKeywords(doc).join('; ') || 'Not available'}</dd>
+            </div>
+            {fields.map(([key, label, value]) => (
+              <div key={key}>
+                <dt>
+                  {label}
+                  {doc.metadata.provenance?.[key]?.source === 'manual' && (
+                    <small> · corrected</small>
+                  )}
+                </dt>
+                <dd>{value || 'Not available'}</dd>
+              </div>
+            ))}
+          </dl>
+        </>
+      )}
+      {doc.summary && (
+        <div className="research-summary">
+          <h4 className="text-xs font-bold">
+            {doc.analysis.summary
+              ? 'Summary · GPT-6 Luna'
+              : 'Source description / abstract excerpt'}
+          </h4>
+          <p>{doc.summary}</p>
+          {doc.analysis.stale && doc.analysis.summary && (
+            <small>
+              Source context changed. Refresh analysis to update this summary.
+            </small>
+          )}
+        </div>
+      )}
+      {(doc.metadata.openalex_id ||
+        doc.metadata.semantic_scholar_id ||
+        validArxiv) && (
+        <div className="research-indexes">
+          <h4 className="text-xs font-bold">Research indexes</h4>
+          {doc.metadata.openalex_id &&
+            /^https:\/\/openalex.org\/W\d+$/.test(doc.metadata.openalex_id) && (
+              <p>
+                <a
+                  href={doc.metadata.openalex_id}
+                  target="_blank"
+                  rel="noreferrer"
+                >
+                  OpenAlex {doc.metadata.openalex_id.split('/').pop()} ↗
+                </a>
+                {' · '}
+                <a
+                  href={`https://api.openalex.org/works/${doc.metadata.openalex_id.split('/').pop()}`}
+                  target="_blank"
+                  rel="noreferrer"
+                >
+                  API JSON ↗
+                </a>
+                {doc.metadata.citation_counts?.openalex !== undefined && (
+                  <span>
+                    {' '}
+                    · {doc.metadata.citation_counts.openalex.toLocaleString()}{' '}
+                    citations
+                  </span>
+                )}
+              </p>
+            )}
+          {doc.metadata.semantic_scholar_id &&
+            /^[a-f0-9]{40}$/i.test(doc.metadata.semantic_scholar_id) && (
+              <p>
+                <a
+                  href={`https://www.semanticscholar.org/paper/${doc.metadata.semantic_scholar_id}`}
+                  target="_blank"
+                  rel="noreferrer"
+                >
+                  Semantic Scholar ↗
+                </a>
+                {doc.metadata.citation_counts?.semantic_scholar !==
+                  undefined && (
+                  <span>
+                    {' '}
+                    ·{' '}
+                    {doc.metadata.citation_counts.semantic_scholar.toLocaleString()}{' '}
+                    citations
+                  </span>
+                )}
+              </p>
+            )}
+          {validArxiv && (
+            <p>
+              <a
+                href={`https://arxiv.org/abs/${arxiv}`}
+                target="_blank"
+                rel="noreferrer"
+              >
+                arXiv {arxiv} ↗
+              </a>
+            </p>
+          )}
+          {doc.metadata.citation_counts_as_of && (
+            <small>
+              Counts as of{' '}
+              {new Date(
+                doc.metadata.citation_counts_as_of,
+              ).toLocaleDateString()}
+              ; indexes count citations differently.
+            </small>
+          )}
+          <details>
+            <summary>Canonical author identities</summary>
+            {doc.metadata.author_identities?.map((a, i) => (
+              <div key={i}>
+                <b>{a.name}</b>
+                {a.openalex_id &&
+                  /^https:\/\/openalex.org\/A\d+$/.test(a.openalex_id) && (
+                    <a href={a.openalex_id} target="_blank" rel="noreferrer">
+                      {' '}
+                      OpenAlex ↗
+                    </a>
+                  )}
+                {a.semantic_scholar_id &&
+                  /^\d+$/.test(a.semantic_scholar_id) && (
+                    <a
+                      href={`https://www.semanticscholar.org/author/${a.semantic_scholar_id}`}
+                      target="_blank"
+                      rel="noreferrer"
+                    >
+                      {' '}
+                      Semantic Scholar ↗
+                    </a>
+                  )}
+                {a.orcid && /^https:\/\/orcid.org\/[\dX-]+$/.test(a.orcid) && (
+                  <a href={a.orcid} target="_blank" rel="noreferrer">
+                    {' '}
+                    ORCID ↗
+                  </a>
+                )}
+                <p>{a.institutions?.map(v => v.name).join(', ')}</p>
+              </div>
+            ))}
+          </details>
+        </div>
+      )}
+      {doc.metadata.scholarly_lookup && (
+        <p className="text-xs text-color-text-light mt-2">
+          Lookup:{' '}
+          {Object.entries(doc.metadata.scholarly_lookup.providers)
+            .map(
+              ([p, status]) =>
+                `${p === 'openalex' ? 'OpenAlex' : 'Semantic Scholar'} ${status}`,
+            )
+            .join(' · ')}
+        </p>
+      )}
+    </section>
+  );
+}
diff --git a/src/sidebar/components/PageResearch.tsx b/src/sidebar/components/PageResearch.tsx
new file mode 100644
index 0000000..e94489c
--- /dev/null
+++ b/src/sidebar/components/PageResearch.tsx
@@ -0,0 +1,406 @@
+import { Button, Card, CardContent, Input } from '@hypothesis/frontend-shared';
+import { useEffect, useState } from 'preact/hooks';
+
+import {
+  localResearchEnabled,
+  rememberResearchDocument,
+  researchRequest,
+} from '../helpers/local-research';
+import type { PageReaction, ResearchDocument } from '../helpers/local-research';
+import PageActivity from './PageActivity';
+import PageMetadataEditor from './PageMetadataEditor';
+import TagEditor from './TagEditor';
+import TagList from './TagList';
+import TagListItem from './TagListItem';
+import { useResearchDocument } from './hooks/local-research';
+
+export default function PageResearch({ uri }: { uri: string }) {
+  const storedDoc = useResearchDocument(uri);
+  const [optimistic, setOptimistic] = useState<Partial<ResearchDocument>>({});
+  const doc = storedDoc ? { ...storedDoc, ...optimistic } : storedDoc;
+  const [title, setTitle] = useState<string | null>(null);
+  const [newGroup, setNewGroup] = useState('');
+  const [groups, setGroups] = useState<string[]>(['For later', 'Likes']);
+  const [error, setError] = useState('');
+  const [saved, setSaved] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [suggesting, setSuggesting] = useState(false);
+  const enabled = localResearchEnabled();
+  const context = storedDoc
+    ? JSON.stringify([
+        storedDoc.title,
+        storedDoc.metadata,
+        storedDoc.manual_tags,
+        storedDoc.annotations?.map(a => [a.id, a.text, a.updated]),
+      ])
+    : '';
+
+  useEffect(() => {
+    if (!enabled) {
+      return undefined;
+    }
+    let active = true;
+    researchRequest('groups')
+      .then(result => {
+        if (active) {
+          setGroups(result.groups ?? ['For later', 'Likes']);
+        }
+      })
+      .catch(() => {});
+    return () => {
+      active = false;
+    };
+  }, [enabled, uri]);
+
+  useEffect(() => {
+    if (!enabled || !context) {
+      return undefined;
+    }
+    let active = true;
+    const timer = setTimeout(async () => {
+      setSuggesting(true);
+      try {
+        const result = await researchRequest('suggest-page', { uri });
+        if (active && result.document) {
+          rememberResearchDocument(uri, result.document as ResearchDocument);
+          setError('');
+        }
+      } catch (error) {
+        if (active) {
+          setError(error.message);
+        }
+      } finally {
+        if (active) {
+          setSuggesting(false);
+        }
+      }
+    }, 2000);
+    return () => {
+      active = false;
+      clearTimeout(timer);
+    };
+  }, [enabled, context, uri]);
+
+  if (!enabled) {
+    return null;
+  }
+  const update = async (values: Record<string, unknown>) => {
+    const pending: Partial<ResearchDocument> = {};
+    if (Array.isArray(values.tags)) {
+      pending.manual_tags = values.tags;
+      pending.page_tags = values.tags;
+    }
+    if (typeof values.title === 'string') {
+      pending.title = values.title;
+    }
+    if ('reaction' in values) {
+      pending.reaction = values.reaction as PageReaction;
+      pending.groups = (doc?.groups ?? []).filter(name => name !== 'Likes');
+      if (values.reaction === 'like') {
+        pending.groups.push('Likes');
+      }
+    } else if (Array.isArray(values.groups)) {
+      pending.groups = values.groups;
+      if (values.groups.includes('Likes') && doc?.reaction !== 'like') {
+        pending.reaction = 'like';
+      } else if (!values.groups.includes('Likes') && doc?.reaction === 'like') {
+        pending.reaction = null;
+      }
+    }
+    if (Array.isArray(values.excluded_auto_tags)) {
+      const excluded = values.excluded_auto_tags;
+      pending.excluded_auto_tags = excluded;
+      pending.auto_tags = (doc?.auto_tags ?? []).filter(
+        tag => !excluded.includes(tag),
+      );
+    }
+    setOptimistic(pending);
+    setBusy(true);
+    setError('');
+    setSaved(false);
+    try {
+      const result = await researchRequest('update', { uri, values });
+      rememberResearchDocument(uri, result.document as ResearchDocument);
+      setSaved(true);
+      if ('title' in values) {
+        setTitle(null);
+      }
+      return true;
+    } catch (error) {
+      setError(error.message);
+      return false;
+    } finally {
+      setOptimistic({});
+      setBusy(false);
+    }
+  };
+  const refreshAuto = async () => {
+    setSuggesting(true);
+    setError('');
+    try {
+      const result = await researchRequest('suggest-page', {
+        uri,
+        force: true,
+      });
+      if (result.document) {
+        rememberResearchDocument(uri, result.document as ResearchDocument);
+      }
+    } catch (error) {
+      setError(error.message);
+    } finally {
+      setSuggesting(false);
+    }
+  };
+  const tags = doc?.manual_tags ?? doc?.page_tags ?? [];
+  const automaticTags = doc?.auto_tags ?? doc?.analysis.tags ?? [];
+  const memberships = doc?.groups ?? [];
+  const addTag = (tag: string) => {
+    if (!tag.trim() || tags.includes(tag.trim()) || busy) {
+      return false;
+    }
+    void update({ tags: [...tags, tag.trim()] });
+    return true;
+  };
+  return (
+    <Card aria-label="Page details" data-testid="page-research" variant="flat">
+      <CardContent classes="space-y-4">
+        <div>
+          <h3 className="font-bold">Page details</h3>
+        </div>
+        {!doc && <p role="status">Connecting to your local library…</p>}
+        {doc && (
+          <>
+            <form
+              onSubmit={event => {
+                event.preventDefault();
+                void update({ title: title ?? doc.title });
+              }}
+            >
+              <label
+                className="block text-xs mb-1"
+                htmlFor={`page-title-${doc.id}`}
+              >
+                Personal title
+              </label>
+              <div className="flex gap-x-2">
+                <div className="min-w-0 grow">
+                  <Input
+                    id={`page-title-${doc.id}`}
+                    value={title ?? doc.title}
+                    onInput={event => setTitle(event.currentTarget.value)}
+                  />
+                </div>
+                <Button
+                  type="submit"
+                  size="sm"
+                  variant="secondary"
+                  disabled={busy}
+                >
+                  Save title
+                </Button>
+              </div>
+            </form>
+            <div>
+              <h4 className="text-xs font-bold mb-2">
+                Your reaction to this page
+              </h4>
+              <div
+                className="flex flex-wrap gap-2"
+                role="group"
+                aria-label="Page reaction"
+              >
+                {(
+                  [
+                    ['like', '👍', 'Like'],
+                    ['bad', '👎', 'Dislike'],
+                  ] as const
+                ).map(([reaction, icon, label]) => (
+                  <Button
+                    key={reaction}
+                    size="sm"
+                    variant={
+                      doc.reaction === reaction ? 'primary' : 'secondary'
+                    }
+                    pressed={doc.reaction === reaction}
+                    title={`Page reaction: ${label}`}
+                    disabled={busy}
+                    onClick={() =>
+                      update({
+                        reaction:
+                          doc.reaction === reaction
+                            ? null
+                            : (reaction as PageReaction),
+                      })
+                    }
+                  >
+                    {icon} {label}
+                  </Button>
+                ))}
+              </div>
+            </div>
+            <div>
+              <h4 className="text-xs font-bold mb-2">Manual groups</h4>
+              <div
+                className="flex flex-wrap gap-x-4 gap-y-2"
+                role="group"
+                aria-label="Manual groups"
+              >
+                {groups.map(group => (
+                  <label
+                    key={group}
+                    className="flex items-center gap-x-1 text-sm"
+                  >
+                    <input
+                      type="checkbox"
+                      checked={memberships.includes(group)}
+                      disabled={busy}
+                      onChange={event =>
+                        void update({
+                          groups: event.currentTarget.checked
+                            ? [...memberships, group]
+                            : memberships.filter(name => name !== group),
+                        })
+                      }
+                    />
+                    {group}
+                  </label>
+                ))}
+              </div>
+              <form
+                className="flex gap-2 mt-2"
+                onSubmit={async event => {
+                  event.preventDefault();
+                  if (!newGroup.trim()) {
+                    return;
+                  }
+                  try {
+                    const result = await researchRequest('create-group', {
+                      name: newGroup.trim(),
+                    });
+                    setGroups(result.groups);
+                    const name = result.groups.find(
+                      (name: string) =>
+                        name.toLocaleLowerCase() ===
+                        newGroup.trim().toLocaleLowerCase(),
+                    );
+                    await update({
+                      groups: Array.from(
+                        new Set([...memberships, name ?? newGroup.trim()]),
+                      ),
+                    });
+                    setNewGroup('');
+                  } catch (error) {
+                    setError(error.message);
+                  }
+                }}
+              >
+                <div className="min-w-0 grow">
+                  <Input
+                    aria-label="New group"
+                    placeholder="New group"
+                    value={newGroup}
+                    onInput={event => setNewGroup(event.currentTarget.value)}
+                  />
+                </div>
+                <Button
+                  type="submit"
+                  size="sm"
+                  variant="secondary"
+                  disabled={busy || !newGroup.trim()}
+                >
+                  Add group
+                </Button>
+              </form>
+            </div>
+            <fieldset disabled={busy}>
+              <h4 className="text-xs font-bold mb-1">Manual tags</h4>
+              <TagEditor
+                tagLabel="Manual tags"
+                tagList={tags}
+                onAddTag={addTag}
+                onRemoveTag={tag => {
+                  void update({ tags: tags.filter(value => value !== tag) });
+                  return true;
+                }}
+                onTagInput={() => {}}
+              />
+            </fieldset>
+            <div>
+              <div className="flex items-center justify-between gap-2 mb-2">
+                <h4 className="text-xs font-bold">Auto tags</h4>
+                <Button
+                  size="sm"
+                  variant="secondary"
+                  disabled={suggesting}
+                  onClick={refreshAuto}
+                >
+                  Refresh auto
+                </Button>
+              </div>
+              <div className="border rounded p-2" data-testid="auto-tags">
+                <TagList label="Auto tags">
+                  {automaticTags.map(tag => (
+                    <TagListItem
+                      key={tag}
+                      tag={tag}
+                      onRemoveTag={() =>
+                        void update({
+                          excluded_auto_tags: [
+                            ...(doc.excluded_auto_tags ?? []),
+                            tag,
+                          ],
+                        })
+                      }
+                    />
+                  ))}
+                </TagList>
+                {!automaticTags.length && (
+                  <p className="text-xs text-color-text-light">
+                    {suggesting ? 'Generating auto tags…' : 'No auto tags yet.'}
+                  </p>
+                )}
+              </div>
+            </div>
+            <PageMetadataEditor doc={doc} busy={busy} onSave={update} />
+            <Button
+              size="sm"
+              variant="secondary"
+              disabled={busy}
+              onClick={async () => {
+                setBusy(true);
+                setError('');
+                try {
+                  const result = await researchRequest('enrich', { uri });
+                  if (result.document) {
+                    rememberResearchDocument(
+                      uri,
+                      result.document as ResearchDocument,
+                    );
+                  }
+                } catch (error) {
+                  setError(error.message);
+                } finally {
+                  setBusy(false);
+                }
+              }}
+            >
+              Find research metadata
+            </Button>
+            <PageActivity doc={doc} />
+            {suggesting && (
+              <p role="status" className="text-xs text-color-text-light">
+                Organizing auto tags and topics…
+              </p>
+            )}
+          </>
+        )}
+        {saved && (
+          <p role="status" className="text-xs text-color-text-light">
+            Saved to your local library.
+          </p>
+        )}
+        {error && <p role="alert">{error}</p>}
+      </CardContent>
+    </Card>
+  );
+}
