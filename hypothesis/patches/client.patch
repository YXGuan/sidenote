+  font-size: 13px;
+}
+.library-recommendations .ld-notice {
+  margin-bottom: 0;
+}
+.library-recommendations a {
+  overflow-wrap: anywhere;
+}
+@media (max-width: 760px) {
+  .rec-controls {
+    flex-direction: column;
+    align-items: stretch;
+  }
+  .rec-source time {
+    display: block;
+    margin-top: 4px;
+    margin-left: 0;
+  }
+}
