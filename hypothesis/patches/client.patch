+}
+.ld-app[data-color-scheme='dark'] .ld-stat strong {
+  font-size: 32px;
+  font-weight: 500;
+}
+.ld-app[data-color-scheme='dark']
+  :is(.ld-stat span, .ld-stat small, .ld-hint, .ld-legend, .library-show-more) {
+  font-size: 12px;
+  color: var(--ld-muted);
+}
+.ld-app[data-color-scheme='dark'] .ld-panel h2,
+.ld-app[data-color-scheme='dark'] .library-insights h2 {
