+import { mount } from '@hypothesis/frontend-testing';
+import { act } from 'preact/test-utils';
+
+import LibraryRecommendations, { $imports } from '../LibraryRecommendations';
+
+describe('LibraryRecommendations', () => {
+  let request;
+  let data;
+  let clock;
+  beforeEach(() => {
+    clock = sinon.useFakeTimers();
+    sinon.stub(document, 'visibilityState').get(() => 'visible');
+    data = {
+      papers: Array.from({ length: 45 }, (_, i) => ({
+        paper_id: `paper-${i}`,
+        title: `Paper ${i}`,
+        url: 'https://example.org/paper',
+        authors: ['Ada Reader'],
+        year: 2026 - i,
+        venue: 'Example journal',
+        abstract: '',
+        citation_count: i,
+        pdf_url: '',
+      })),
+      seeds: [],
+      eligible_count: 25,
+      skipped_count: 0,
+      used_seed_count: 25,
+      unresolved_count: 0,
+      generated_at: '2026-10-24T12:00:00Z',
+      stale: false,
+      job: { state: 'idle' },
+    };
+    request = sinon.stub().callsFake(async () => data);
+    $imports.$mock({
+      '../helpers/local-research': { researchRequest: request },
+    });
+  });
+  afterEach(() => $imports.$restore());
+  const settle = () =>
+    act(async () => {
+      await clock.tickAsync(0);
+    });
+  const create = () =>
+    mount(<LibraryRecommendations navigate={sinon.stub()} />);
+
+  it('reads only cached data on opening and refreshes only after an explicit click', async () => {
+    const wrapper = create();
+    await settle();
+    wrapper.update();
+    assert.calledOnce(request);
+    assert.calledWith(request, 'recommendations');
+    await act(async () =>
+      wrapper
+        .find('button[aria-label="Refresh recommendations"]')
+        .props()
+        .onClick(),
+    );
+    assert.calledWith(request, 'refresh-recommendations', { approved: true });
+    assert.include(
+      wrapper.text(),
+      'Your highlights, comments, and personal notes stay local',
+    );
+  });
+
+  it('shows 20 at a time, retains expansion on unchanged reads, and resets after filtering', async () => {
+    const wrapper = create();
+    await settle();
+    wrapper.update();
+    assert.equal(wrapper.find('.rec-papers > li').length, 20);
+    act(() =>
+      wrapper
+        .find('button[aria-label="Show more recommendations"]')
+        .props()
+        .onClick(),
+    );
+    wrapper.update();
+    assert.equal(wrapper.find('.rec-papers > li').length, 40);
+    await act(async () => {
+      await clock.tickAsync(30_000);
+    });
+    wrapper.update();
+    assert.equal(wrapper.find('.rec-papers > li').length, 40);
+    act(() =>
+      wrapper
+        .find('input')
+        .props()
+        .onInput({ currentTarget: { value: 'Paper 44' } }),
+    );
+    wrapper.update();
+    assert.equal(wrapper.find('.rec-papers > li').length, 1);
+    assert.isFalse(
+      wrapper.find('button[aria-label="Show more recommendations"]').exists(),
+    );
+    act(() =>
+      wrapper
+        .find('input')
+        .props()
+        .onInput({ currentTarget: { value: '' } }),
+    );
+    wrapper.update();
+    assert.equal(wrapper.find('.rec-papers > li').length, 20);
+  });
+
+  it('keeps saved results visible when a refresh fails and reports unresolved seeds', async () => {
+    data = {
+      ...data,
+      unresolved_count: 3,
+      stale: true,
+      job: { state: 'failed', error: 'Rate limited; retry later.' },
+    };
+    const wrapper = create();
+    await settle();
+    wrapper.update();
+    assert.include(wrapper.find('[role="alert"]').text(), 'Rate limited');
+    assert.include(wrapper.text(), '3 papers could not be matched');
+    assert.equal(wrapper.find('.rec-papers > li').length, 20);
+    assert.notCalled(request.withArgs('refresh-recommendations'));
+  });
+});
