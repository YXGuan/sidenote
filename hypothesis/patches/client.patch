@@ -0,0 +1,336 @@
+import { useCallback, useEffect, useRef, useState } from 'preact/hooks';
+
+import { LIBRARY_HOME } from '../helpers/library-routes';
+import type { LibraryRoute } from '../helpers/library-routes';
+import { researchRequest } from '../helpers/local-research';
+import LibraryRouteLink from './LibraryRouteLink';
+import LibraryShowMore from './LibraryShowMore';
+import { useProgressiveList } from './hooks/use-progressive-list';
+
+type Paper = {
+  paper_id: string;
+  title: string;
+  url: string;
+  authors: string[];
+  year: number | null;
+  venue: string;
+  abstract: string;
+  citation_count: number | null;
+  pdf_url: string;
+};
+type Recommendations = {
+  papers: Paper[];
+  seeds: { document_id: string; title: string; status: string }[];
+  eligible_count: number;
+  skipped_count: number;
+  used_seed_count: number;
+  unresolved_count: number;
+  generated_at: string | null;
+  stale: boolean;
+  job: { state: string; error?: string };
+};
+
+export default function LibraryRecommendations({
+  navigate,
+}: {
+  navigate: (route: LibraryRoute) => void;
+}) {
+  const [data, setData] = useState<Recommendations | null>(null);
+  const [error, setError] = useState('');
+  const [starting, setStarting] = useState(false);
+  const [query, setQuery] = useState('');
+  const [sort, setSort] = useState('relevance');
+  const mounted = useRef(true);
+  const inFlight = useRef(false);
+  const load = useCallback(async () => {
+    if (inFlight.current) {
+      return;
+    }
+    inFlight.current = true;
+    try {
+      const result = await researchRequest('recommendations');
+      if (!Array.isArray(result.papers) || !Array.isArray(result.seeds)) {
+        throw new Error(
+          'Recommendations are unavailable. Restart the local service and reload the extension.',
+        );
+      }
+      if (mounted.current) {
+        setData(result as Recommendations);
+        setError('');
+      }
+    } catch (error) {
+      if (mounted.current) {
+        setError(error.message);
+      }
+    } finally {
+      inFlight.current = false;
+    }
+  }, []);
+  const running =
+    starting || ['queued', 'running'].includes(data?.job.state ?? '');
+  useEffect(() => {
+    mounted.current = true;
+    void load();
+    const onFocus = () => void load();
+    window.addEventListener('focus', onFocus);
+    return () => {
+      mounted.current = false;
+      window.removeEventListener('focus', onFocus);
+    };
+  }, [load]);
+  useEffect(() => {
+    const timer = window.setInterval(
+      () => {
+        if (document.visibilityState === 'visible') {
+          void load();
+        }
+      },
+      running ? 1000 : 30_000,
+    );
+    return () => window.clearInterval(timer);
+  }, [running, load]);
+
+  const refresh = async () => {
+    setStarting(true);
+    setError('');
+    try {
+      await researchRequest('refresh-recommendations', { approved: true });
+      await load();
+    } catch (error) {
+      setError(error.message);
+    } finally {
+      setStarting(false);
+    }
+  };
+  const words = query.trim().toLocaleLowerCase().split(/\s+/);
+  const papers = (data?.papers ?? []).filter(paper => {
+    const text = [paper.title, paper.venue, ...paper.authors]
+      .join(' ')
+      .toLocaleLowerCase();
+    return words.every(word => text.includes(word));
+  });
+  if (sort !== 'relevance') {
+    papers.sort((a, b) =>
+      sort === 'newest'
+        ? (b.year ?? 0) - (a.year ?? 0)
+        : (b.citation_count ?? 0) - (a.citation_count ?? 0),
+    );
+  }
+  const list = useProgressiveList(
+    papers,
+    JSON.stringify([query, sort, papers.map(p => p.paper_id)]),
+  );
+  const seeds = useProgressiveList(
+    data?.seeds ?? [],
+    JSON.stringify(data?.seeds ?? []),
+  );
+  return (
+    <section
+      className="library-recommendations"
+      aria-label="Paper recommendations"
+    >
+      <div className="rec-toolbar">
+        <p className="rec-source">
+          Based on{' '}
+          <LibraryRouteLink
+            to={{
+              ...LIBRARY_HOME,
+              tab: 'collections',
+              collection: 'liked-auto',
+            }}
+            navigate={navigate}
+          >
+            Liked (Auto)
+          </LibraryRouteLink>
+          {data?.generated_at && (
+            <time
+              dateTime={data.generated_at}
+              title={new Date(data.generated_at).toLocaleString()}
+            >
+              Updated {new Date(data.generated_at).toLocaleDateString()}
+            </time>
+          )}
+        </p>
+        <button
+          className="ld-button ld-primary"
+          aria-label="Refresh recommendations"
+          disabled={!data || running || data.eligible_count === 0}
+          onClick={refresh}
+        >
+          {running ? 'Finding papers…' : 'Refresh'}
+        </button>
+      </div>
+      <div className="rec-about">
+        <p className="ld-hint">
+          Refresh sends paper IDs and unmatched titles to Semantic Scholar. Your
+          notes stay local.
+        </p>
+        {data && (
+          <details className="rec-details">
+            <summary>
+              About these recommendations
+              {data.unresolved_count > 0 &&
+                ` · ${data.unresolved_count} unmatched`}
+            </summary>
+            <div className="rec-details-body">
+              <p>
+                Recommendations and bibliographic data from{' '}
+                <a
+                  href="https://www.semanticscholar.org/"
+                  target="_blank"
+                  rel="noreferrer"
+                >
+                  Semantic Scholar
+                </a>
+                , using every applicable paper in Liked (Auto). Saved papers are
+                excluded. Library filters do not limit the seeds.
+              </p>
+              <p>
+                Your highlights, comments, and personal notes stay local. Up to
+                500 suggestions per refresh; this is not a complete literature
+                search.
+              </p>
+              <p>
+                {data.eligible_count} eligible liked pages ·{' '}
+                {data.used_seed_count} unique seed papers used
+              </p>
+              {data.skipped_count > 0 && (
+                <p>
+                  {data.skipped_count} liked pages are not recognized as papers.
+                </p>
+              )}
+              {data.unresolved_count > 0 && (
+                <p>
+                  {data.unresolved_count} papers could not be matched
+                  confidently. Check their DOI, arXiv ID, or citation details in
+                  the library, then refresh.
+                </p>
+              )}
+              {data.eligible_count === 0 && (
+                <p>
+                  Positive comments can add papers to Liked (Auto); highlights
+                  alone do not count as liking.
+                </p>
+              )}
+              {data.seeds.length > 0 && (
+                <details className="rec-seeds">
+                  <summary>Seed papers ({data.seeds.length})</summary>
+                  <ul>
+                    {seeds.items.map(seed => (
+                      <li key={seed.document_id}>
+                        <LibraryRouteLink
+                          to={{ ...LIBRARY_HOME, page: seed.document_id }}
+                          navigate={navigate}
+                        >
+                          {seed.title}
+                        </LibraryRouteLink>
+                        <span>
+                          {seed.status === 'used' ? 'Used' : 'Unresolved'}
+                        </span>
+                      </li>
+                    ))}
+                  </ul>
+                  <LibraryShowMore {...seeds} label="seed papers" />
+                </details>
+              )}
+            </div>
+          </details>
+        )}
+      </div>
+      {error && (
+        <div className="ld-notice" role="alert">
+          {error} <button onClick={load}>Retry connection</button>
+        </div>
+      )}
+      {data?.job.state === 'failed' && (
+        <p className="ld-notice" role="alert">
+          {data.job.error}
+        </p>
+      )}
+      {!data && !error && <p role="status">Loading saved recommendations…</p>}
+      {data && (
+        <>
+          {data.stale && (
+            <p className="ld-notice">
+              Your liked papers have changed. Refresh for updated suggestions.
+            </p>
+          )}
+          {!!data.papers.length && (
+            <div className="rec-controls">
+              <label className="ld-search">
+                <span className="sr-only">Search recommendations</span>
+                <input
+                  type="search"
+                  aria-label="Search recommendations"
+                  placeholder="Search papers"
+                  value={query}
+                  onInput={e => setQuery(e.currentTarget.value)}
+                />
+              </label>
+              <label className="ld-choice">
+                <span>Sort recommendations</span>
+                <select
+                  aria-label="Sort recommendations"
+                  value={sort}
+                  onChange={e => setSort(e.currentTarget.value)}
+                >
+                  <option value="relevance">Recommended order</option>
+                  <option value="newest">Newest first</option>
+                  <option value="citations">Most cited</option>
+                </select>
+              </label>
+            </div>
+          )}
+          {!!papers.length && (
+            <ol className="rec-papers" aria-label="Recommended papers">
+              {list.items.map(paper => (
+                <li key={paper.paper_id}>
+                  <h2>
+                    <a href={paper.url} target="_blank" rel="noreferrer">
+                      {paper.title}
+                    </a>
+                  </h2>
+                  {!!paper.authors.length && (
+                    <p className="rec-authors">{paper.authors.join(', ')}</p>
+                  )}
+                  <p className="rec-paper-meta">
+                    {[paper.year, paper.venue].filter(Boolean).join(' · ')}
+                    {paper.citation_count !== null && (
+                      <span>
+                        {paper.year || paper.venue ? ' · ' : ''}
+                        {paper.citation_count.toLocaleString()} citations
+                      </span>
+                    )}
+                    {paper.pdf_url && (
+                      <a href={paper.pdf_url} target="_blank" rel="noreferrer">
+                        Open PDF ↗
+                      </a>
+                    )}
+                  </p>
+                  {paper.abstract && (
+                    <details>
+                      <summary>Abstract</summary>
+                      <p>{paper.abstract}</p>
+                    </details>
+                  )}
+                </li>
+              ))}
+            </ol>
+          )}
+          {!running && papers.length === 0 && (
+            <p className="rec-empty">
+              {data.papers.length
+                ? 'No recommendations match this search.'
+                : data.eligible_count === 0
+                  ? 'Add papers to Liked (Auto) to get recommendations.'
+                  : data.generated_at
+                    ? 'No new papers found. Try refreshing after liking more papers.'
+                    : 'Select Refresh to find papers from your liked collection.'}
+            </p>
+          )}
+          <LibraryShowMore {...list} label="recommendations" />
+        </>
+      )}
+    </section>
+  );
+}
