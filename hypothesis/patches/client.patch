+              className="text-xs text-color-text-light"
+              href={`https://hypothes.is/a/${annotation.id}`}
+              target="_blank"
+              rel="noreferrer"
+            >
+              View on Hypothesis
+            </a>
+            {annotation.target
+              ?.flatMap(target => target.selector ?? [])
+              .filter(selector => selector.type === 'TextQuoteSelector')
+              .map((selector, index) => (
+                <blockquote
+                  className="border-l-2 pl-3 text-color-text-light"
+                  key={index}
+                >
+                  {'exact' in selector ? selector.exact : ''}
+                </blockquote>
+              ))}
+            {annotation.text && (
+              <p className="whitespace-pre-wrap">{annotation.text}</p>
+            )}
+            <LocalResearchActions annotation={annotation as SavedAnnotation} />
+          </CardContent>
+        </Card>
+      ))}
+    </div>
+  );
+}
+
+type Job = {
+  state: string;
+  done: number;
+  total: number;
+  applied?: number;
+  matched?: number;
+  failed: number;
+  error?: string;
+};
+function Icon({ name, size = 18 }: { name: string; size?: number }) {
+  const paths: Record<string, string> = {
+    library: 'M4 4h4v16H4z M10 4h4v16h-4z M17 4l4 1-3 15-4-1z',
+    dashboard: 'M3 3v18h18 M7 16v-5 M12 16V6 M17 16V9',
+    collections: 'M3 7V5h6l2 2h10v13H3z',
+    recommendations:
+      'M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z',
+    settings: 'M4 7h16 M4 17h16 M8 4v6 M16 14v6',
+    moon: 'M20 15a8 8 0 0 1-11-11 8 8 0 1 0 11 11z',
+    sun: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8 M12 2v2 M12 20v2 M2 12h2 M20 12h2 M5 5l1 1 M18 18l1 1 M5 19l1-1 M18 6l1-1',
+    search: 'M21 21l-6-6 M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0',
+    filter: 'M4 6h16 M7 12h10 M10 18h4 M8 4v4 M15 10v4',
