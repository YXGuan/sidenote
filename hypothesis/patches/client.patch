--- /dev/null
+++ b/src/sidebar/components/OpenPageLink.tsx
@@ -0,0 +1,44 @@
+import type { LibraryPage } from '../helpers/library';
+
+/** A direct source link that keeps the library open in the current tab. */
+export default function OpenPageLink({
+  page,
+}: {
+  page: Pick<LibraryPage, 'url' | 'title'>;
+}) {
+  let href: string | undefined;
+  try {
+    const url = new URL(page.url);
+    if (url.protocol === 'https:' || url.protocol === 'http:') {
+      href = url.href;
+    }
+  } catch {
+    // Imported PDFs can have an identifier instead of a source URL.
+  }
+
+  const label = (
+    <>
+      Open page <span aria-hidden="true">↗</span>
+    </>
+  );
+  return href ? (
+    <a
+      className="ld-open-page"
+      href={href}
+      target="_blank"
+      rel="noopener noreferrer"
+      aria-label={`Open page: ${page.title} (opens in a new tab)`}
+      title={href}
+    >
+      {label}
+    </a>
+  ) : (
+    <span
+      className="ld-open-page"
+      aria-disabled="true"
+      title="This saved item has no source URL to open."
+    >
+      {label}
+    </span>
+  );
+}
