+    await tick(30_000);
+    wrapper.update();
+    assert.lengthOf(wrapper.find('.kura-tree-topic'), 40);
+    more().simulate('click');
+    assert.lengthOf(wrapper.find('.kura-tree-topic'), 45);
+    assert.isFalse(more().exists());
+    assert.include(wrapper.text(), 'Showing 45 of 45');
+    wrapper.setProps({ route: { ...LIBRARY_HOME, kuraView: 'sizes' } });
+    assert.lengthOf(wrapper.find('.kura-sizes li'), 20);
+    wrapper.find('button[aria-label="Show more topics"]').simulate('click');
