+++ b/src/sidebar/components/KuraWorkspace.tsx
@@ -0,0 +1,917 @@
+import { useCallback, useEffect, useRef, useState } from 'preact/hooks';
+
+import { KURA_VIEWS } from '../helpers/library-routes';
+import type { LibraryRoute } from '../helpers/library-routes';
+import { researchRequest } from '../helpers/local-research';
+import { researchUpdatedAt } from '../helpers/research-updates';
+import LibraryShowMore from './LibraryShowMore';
+import { useProgressiveList } from './hooks/use-progressive-list';
+import { useResearchRefresh } from './hooks/use-research-refresh';
+
+type Cluster = {
+  id: string;
+  name: string;
+  description: string;
+  count: number;
+  chat_ids: string[];
+  parent_id: string | null;
+  children: string[];
+  root_id: string;
+  level: number;
+  x: number;
+  y: number;
+};
+type Kura = {
+  available: boolean;
+  stale: boolean;
+  runtime_ready: boolean;
+  generated_at?: string;
+  clusters?: Cluster[];
+  cluster_aliases?: Record<string, string>;
+  current_counts: { annotation: number; note: number };
+  counts?: { annotation: number; note: number };
+};
+type Evidence = {
+  id: string;
+  kind: string;
+  title: string;
+  url: string;
+  source_url: string;
+  summary: string;
+  highlight: string;
+  comment: string;
+  text: string;
+  reaction: string | null;
+  page_reaction: string | null;
+};
+type Members = {
+  total: number;
+  results: Evidence[];
+  offset: number;
+  limit: number;
+};
+type Job = {
+  id: string;
+  operation: string;
+  state: string;
+  error?: string;
+  result?: Kura;
+  progress?: { stage: string; done?: number; total?: number };
+};
+
+const COLORS = ['#4b7594', '#bc724d', '#649074', '#a281af', '#bb9d46'];
+
+function webURL(value: string) {
+  return /^https?:\/\//i.test(value) ? value : undefined;
+}
+
+function TopicTree({
+  clusters,
+  parent = null,
+  depth = 0,
+  color,
+  selected,
+  selectedPath,
+  collapsed,
+  onToggle,
+  onSelect,
+}: {
+  clusters: Cluster[];
+  parent?: string | null;
+  depth?: number;
+  color: (cluster: Cluster) => string;
+  selected: string;
+  selectedPath: Set<string>;
+  collapsed: Set<string>;
+  onToggle: (id: string) => void;
+  onSelect: (id: string) => void;
+}) {
+  const children = clusters.filter(c => c.parent_id === parent);
+  const list = useProgressiveList(
+    children,
+    JSON.stringify(children.map(c => [c.id, c.name, c.count])),
+    children.findIndex(c => selectedPath.has(c.id)) + 1,
+  );
+  return (
+    <>
+      <ul className="kura-tree">
+        {list.items.map(c => (
+          <li key={c.id}>
+            <div
+              className="kura-tree-row"
+              style={{ paddingLeft: `${8 + depth * 16}px` }}
+            >
+              {c.children.length ? (
+                <button
+                  className="kura-tree-toggle"
+                  aria-label={`${collapsed.has(c.id) ? 'Expand' : 'Collapse'} ${c.name}`}
+                  aria-expanded={!collapsed.has(c.id)}
+                  aria-controls={`kura-children-${c.id}`}
+                  onClick={() => onToggle(c.id)}
+                >
+                  <span aria-hidden="true">
+                    {collapsed.has(c.id) ? '▸' : '▾'}
+                  </span>
+                </button>
+              ) : (
+                <span className="kura-tree-spacer" />
+              )}
+              <button
+                className="kura-tree-topic"
+                aria-pressed={selected === c.id}
+                onClick={() => onSelect(c.id)}
+              >
+                <span
+                  className="kura-swatch"
+                  style={{ background: color(c) }}
+                />
+                <span>{c.name}</span>
+                <small>{c.count}</small>
+              </button>
+            </div>
+            {!!c.children.length && (
+              <div id={`kura-children-${c.id}`} hidden={collapsed.has(c.id)}>
+                <TopicTree
+                  clusters={clusters}
+                  parent={c.id}
+                  depth={depth + 1}
+                  color={color}
+                  selected={selected}
+                  selectedPath={selectedPath}
+                  collapsed={collapsed}
+                  onToggle={onToggle}
+                  onSelect={onSelect}
+                />
+              </div>
+            )}
+          </li>
+        ))}
+      </ul>
+      <LibraryShowMore
+        {...list}
+        label={
+          parent
+            ? `${clusters.find(c => c.id === parent)!.name} subtopics`
+            : 'topic families'
+        }
+      />
+    </>
+  );
+}
+
+function ClusterMap({
+  clusters,
+  color,
+  selected,
+  onSelect,
+}: {
+  clusters: Cluster[];
+  color: (cluster: Cluster) => string;
+  selected: string;
+  onSelect: (id: string) => void;
+}) {
+  const [zoom, setZoom] = useState(1);
+  const [pan, setPan] = useState({ x: 0, y: 0 });
+  const drag = useRef<{ x: number; y: number } | null>(null);
+  const xs = clusters.map(c => c.x);
+  const ys = clusters.map(c => c.y);
+  const minX = Math.min(...xs);
+  const minY = Math.min(...ys);
+  const rangeX = Math.max(...xs) - minX || 1;
+  const rangeY = Math.max(...ys) - minY || 1;
+  return (
+    <>
+      <div className="rw-controls kura-map-tools">
+        <span>Cluster map</span>
+        <button
+          aria-label="Zoom in"
+          onClick={() => setZoom(Math.min(zoom * 1.4, 6))}
+        >
+          +
+        </button>
+        <button
+          aria-label="Zoom out"
+          onClick={() => setZoom(Math.max(zoom / 1.4, 0.6))}
+        >
+          −
+        </button>
+        <button
+          onClick={() => {
+            setZoom(1);
+            setPan({ x: 0, y: 0 });
+          }}
+        >
+          Reset map
+        </button>
+      </div>
+      <svg
+        className="kura-map"
+        viewBox={`${pan.x + 500 - 500 / zoom} ${pan.y + 300 - 300 / zoom} ${1000 / zoom} ${600 / zoom}`}
+        role="group"
+        aria-label="Kura cluster map"
+        onPointerDown={e => {
+          if ((e.target as Element).closest('[role="button"]')) {
+            return;
+          }
+          drag.current = { x: e.clientX, y: e.clientY };
+          e.currentTarget.setPointerCapture(e.pointerId);
+        }}
+        onPointerMove={e => {
+          if (!drag.current) {
+            return;
+          }
+          const scale =
+            1000 / e.currentTarget.getBoundingClientRect().width / zoom;
+          setPan({
+            x: pan.x - (e.clientX - drag.current.x) * scale,
+            y: pan.y - (e.clientY - drag.current.y) * scale,
+          });
+          drag.current = { x: e.clientX, y: e.clientY };
+        }}
+        onPointerUp={() => {
+          drag.current = null;
+        }}
+        onPointerCancel={() => {
+          drag.current = null;
+        }}
+      >
+        {[100, 200, 300, 400, 500].map(y => (
+          <line
+            key={y}
+            x1="0"
+            x2="1000"
+            y1={y}
+            y2={y}
+            stroke="var(--ld-line, #e5e8e3)"
+          />
+        ))}
+        {clusters.map(cluster => {
+          const x =
+            clusters.length === 1
+              ? 500
+              : 95 + ((cluster.x - minX) / rangeX) * 810;
+          const y =
+            clusters.length === 1
+              ? 300
+              : 75 + ((cluster.y - minY) / rangeY) * 440;
+          const radius =
+            13 +
+            Math.sqrt(cluster.count / Math.max(...clusters.map(c => c.count))) *
+              30;
+          return (
+            <g
+              key={cluster.id}
+              role="button"
+              tabindex={0}
+              aria-label={`${cluster.name}, ${cluster.count} items`}
+              aria-pressed={selected === cluster.id}
+              onClick={() => onSelect(cluster.id)}
+              onKeyDown={e => {
+                if (e.key === 'Enter' || e.key === ' ') {
+                  e.preventDefault();
+                  onSelect(cluster.id);
+                }
+              }}
+              className="kura-bubble"
+            >
+              <title>
+                {cluster.name} · {cluster.count} items
+              </title>
+              <circle
+                cx={x}
+                cy={y}
+                r={radius + 7}
+                fill={color(cluster)}
+                opacity="0.09"
+              />
+              <circle
+                cx={x}
+                cy={y}
+                r={radius}
+                fill={color(cluster)}
+                fillOpacity="0.8"
+                stroke={
+                  selected === cluster.id
+                    ? 'var(--ld-accent, #203e32)'
+                    : 'var(--ld-surface, #fff)'
+                }
+                strokeWidth={selected === cluster.id ? 4 : 2}
+              />
+              <text
+                x={x}
+                y={y + 5}
+                textAnchor="middle"
+                fill="white"
+                fontSize="15"
+              >
+                {cluster.count}
+              </text>
+              <text
+                className="kura-map-label"
+                x={x}
+                y={y + radius + 22}
+                textAnchor="middle"
+              >
+                {cluster.name.length > 34
+                  ? cluster.name.slice(0, 32) + '…'
+                  : cluster.name}
+              </text>
+            </g>
+          );
+        })}
+      </svg>
+    </>
+  );
+}
+
+export default function KuraWorkspace({
+  route,
+  navigate,
+  autoRefresh,
+  refreshInterval,
+}: {
+  route: LibraryRoute;
+  navigate: (route: LibraryRoute) => void;
+  autoRefresh: boolean;
+  refreshInterval: number;
+}) {
+  const { kuraView: view, cluster: selected } = route;
+  const setSelected = (cluster: string) => navigate({ ...route, cluster });
+  const [data, setData] = useState<Kura | null>(null);
+  const [job, setJob] = useState<Job | null>(null);
+  const [error, setError] = useState('');
+  const [level, setLevel] = useState('leaves');
+  const [kind, setKind] = useState('all');
+  const [query, setQuery] = useState('');
+  const [collapsed, setCollapsed] = useState<Set<string>>(() => new Set());
+  const [members, setMembers] = useState<Members | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [refreshing, setRefreshing] = useState(false);
+  const reading = useRef(false);
+  const active = useRef(true);
+  const requestID = useRef(0);
+  const running = job?.state === 'running' || job?.state === 'queued';
+
+  const refresh = useCallback(async () => {
+    if (reading.current) {
+      return;
+    }
+    reading.current = true;
+    setRefreshing(true);
+    try {
+      const result = await researchRequest('kura');
+      if (typeof result.available !== 'boolean' || !result.current_counts) {
+        throw new Error(
+          'Kura data is unavailable. Update the local service and reload the extension.',
+        );
+      }
+      if (active.current) {
+        setData(result as Kura);
+      }
+    } finally {
+      reading.current = false;
+      if (active.current) {
+        setRefreshing(false);
+      }
+    }
+  }, []);
+  const reloadSaved = async (quiet = false) => {
+    if (!quiet) {
+      setError('');
+    }
+    try {
+      await refresh();
+    } catch (e) {
+      if (active.current) {
+        setError(e.message);
+      }
+    }
+  };
+  useResearchRefresh({
+    enabled: autoRefresh && !running,
+    interval: refreshInterval,
+    refresh: () => reloadSaved(true),
+  });
+  const watch = useCallback(
+    async (id: string) => {
+      while (active.current) {
+        const { job: current } = (await researchRequest('research-job')) as {
+          job: Job;
+        };
+        if (!active.current) {
+          return;
+        }
+        if (current.id !== id) {
+          await refresh();
+          setJob(null);
+          return;
+        }
+        setJob(current);
+        if (current.state === 'failed') {
+          setError(current.error ?? 'Kura failed');
+          return;
+        }
+        if (current.state === 'completed') {
+          await refresh();
+          return;
+        }
+        await new Promise(resolve => setTimeout(resolve, 1500));
+      }
+    },
+    [refresh],
+  );
+  useEffect(() => {
+    active.current = true;
+    void (async () => {
+      await refresh();
+      const { job: current } = (await researchRequest('research-job')) as {
+        job: Job;
+      };
+      if (
+        current.operation === 'kura' &&
+        ['running', 'queued'].includes(current.state)
+      ) {
+        setJob(current);
+        await watch(current.id);
+      }
+    })().catch(e => {
+      if (active.current) {
+        setError(e.message);
+      }
+    });
+    return () => {
+      active.current = false;
+    };
+  }, [refresh, watch]);
+
+  useEffect(() => {
+    setMembers(null);
+    setLoading(false);
+    const id = ++requestID.current;
+    if (!selected || data?.stale) {
+      return;
+    }
+    setLoading(true);
+    void researchRequest('kura-members', { values: { cluster_id: selected } })
+      .then(result => {
+        if (active.current && requestID.current === id) {
+          setMembers(result as Members);
+        }
+      })
+      .catch(e => {
+        if (active.current && requestID.current === id) {
+          setError(e.message);
+        }
+      })
+      .finally(() => {
+        if (active.current && requestID.current === id) {
+          setLoading(false);
+        }
+      });
+  }, [selected, data]);
+
+  const run = async () => {
+    setError('');
+    setSelected('');
+    setJob({ id: '', operation: 'kura', state: 'queued' });
+    try {
+      const start = await researchRequest('research', {
+        values: { operation: 'kura', approved: true },
+      });
+      await watch(start.job.id);
+    } catch (e) {
+      if (active.current) {
+        setError(e.message);
+        setJob(null);
+      }
+    }
+  };
+  const clusters = data?.clusters ?? [];
+  const roots = clusters.filter(c => !c.parent_id);
+  const color = (c: Cluster) =>
+    COLORS[
+      Math.max(
+        0,
+        roots.findIndex(r => r.id === c.root_id),
+      ) % COLORS.length
+    ];
+  const matches = (c: Cluster) =>
+    (!query ||
+      `${c.name} ${c.description}`
+        .toLowerCase()
+        .includes(query.toLowerCase())) &&
+    (kind === 'all' || c.chat_ids.some(id => id.startsWith(kind + ':')));
+  const visible = clusters.filter(
+    c =>
+      matches(c) &&
+      (level === 'all' ||
+        (level === 'roots' ? !c.parent_id : !c.children.length)),
+  );
+  const selectedID = data?.cluster_aliases?.[selected] ?? selected;
+  const chosen = clusters.find(c => c.id === selectedID);
+  const ancestors: string[] = [];
+  let ancestor = chosen;
+  while (ancestor?.parent_id) {
+    ancestors.push(ancestor.parent_id);
+    ancestor = clusters.find(c => c.id === ancestor!.parent_id);
+  }
+  const ancestorKey = JSON.stringify(ancestors);
+  useEffect(() => {
+    const path = new Set<string>(JSON.parse(ancestorKey));
+    setCollapsed(current => {
+      if (![...current].some(id => path.has(id))) {
+        return current;
+      }
+      return new Set([...current].filter(id => !path.has(id)));
+    });
+  }, [selected, ancestorKey]);
+  const sizes = [...visible].sort((a, b) => b.count - a.count);
+  const sizeList = useProgressiveList(
+    sizes,
+    JSON.stringify([
+      query,
+      kind,
+      level,
+      sizes.map(c => [c.id, c.name, c.count]),
+    ]),
+    sizes.findIndex(c => c.id === selectedID) + 1,
+  );
+  const total = (data?.counts?.annotation ?? 0) + (data?.counts?.note ?? 0);
+  return (
+    <div className="kura-workspace">
+      <div className="kura-heading">
+        <div>
+          <h2>Topic classification</h2>
+        </div>
+        <div className="rw-controls">
+          <button
+            className="ld-button"
+            disabled={refreshing || running}
+            onClick={() => void reloadSaved()}
+          >
+            Refresh saved results
+          </button>
+          <button
+            className="ld-button ld-primary"
+            disabled={
+              running ||
+              !data ||
+              !data.runtime_ready ||
+              !(data.current_counts.annotation + data.current_counts.note)
+            }
+            onClick={() => void run()}
+          >
+            {running
+              ? 'Kura is running…'
+              : data?.available
+                ? 'Update topic classification'
+                : 'Classify all notes'}
+          </button>
+        </div>
+      </div>
+      <p className="rw-freshness" role="status">
+        {refreshing
+          ? 'Refreshing saved topics…'
+          : data
+            ? `${researchUpdatedAt(data.generated_at, data.available)}${data.stale ? ' · Changes pending' : ''} · Analysis runs manually`
+            : error
+              ? 'Saved topics unavailable. Retry Refresh saved results.'
+              : 'Loading saved topics…'}
+      </p>
+      {error && (
+        <p className="ld-notice" role="alert">
+          {error}
+        </p>
+      )}
+      {running && (
+        <div className="kura-progress" role="status">
+          <b>{job?.progress?.stage ?? 'Starting Kura…'}</b>
+          {!!job?.progress?.total && (
+            <>
+              <progress
+                value={job.progress.done ?? 0}
+                max={job.progress.total}
+              />
+              <span>
+                {job.progress.done ?? 0} / {job.progress.total}
+              </span>
+            </>
+          )}
+        </div>
+      )}
+      {data?.stale && (
+        <p className="ld-notice">
+          Your annotations or notes have changed since this map was built.
+          Update topic classification to include the changes.
+        </p>
+      )}
+      {data && !data.available && !running && (
+        <div className="kura-empty">
+          <h3>No topic classification yet</h3>
+          <p>
+            {data.current_counts.annotation} annotations and{' '}
+            {data.current_counts.note} personal notes are ready to analyze.
+          </p>
+          {!data.runtime_ready && (
+            <p>
+              Install the optional runtime in your terminal:{' '}
+              <code>./research-partner/setup-kura</code>
+            </p>
+          )}
+          {!(data.current_counts.annotation + data.current_counts.note) && (
+            <p>
+              Save annotations or personal notes first. Bookmarks without notes
+              are not classification evidence.
+            </p>
+          )}
+        </div>
+      )}
+      {data?.available && (
+        <>
+          <div className="kura-stats">
+            {[
+              [data.counts?.annotation ?? 0, 'Annotations'],
+              [data.counts?.note ?? 0, 'Personal notes'],
+              [
+                clusters.filter(c => !c.children.length).length,
+                'Specific subjects',
+              ],
+              [roots.length, 'Topic families'],
+            ].map(([value, label]) => (
+              <div key={label}>
+                <small>{label}</small>
+                <strong>{value}</strong>
+              </div>
+            ))}
+          </div>
+          <div className="rw-controls kura-filters">
+            {KURA_VIEWS.map(name => (
+              <button
+                key={name}
+                aria-pressed={view === name}
+                onClick={() => navigate({ ...route, kuraView: name })}
+              >
+                {
+                  { map: 'Map', hierarchy: 'Hierarchy', sizes: 'Topic sizes' }[
+                    name
+                  ]
+                }
+              </button>
+            ))}
+            {view !== 'hierarchy' && (
+              <>
+                <label>
+                  Show{' '}
+                  <select
+                    aria-label="Cluster level"
+                    value={level}
+                    onChange={e => setLevel(e.currentTarget.value)}
+                  >
+                    <option value="leaves">Specific subjects</option>
+                    <option value="roots">Topic families</option>
+                    <option value="all">All levels</option>
+                  </select>
+                </label>
+                <label className="sr-only" htmlFor="kura-search">
+                  Find a cluster
+                </label>
+                <input
+                  id="kura-search"
+                  placeholder="Find a cluster…"
+                  value={query}
+                  onInput={e => setQuery(e.currentTarget.value)}
+                />
+                <select
+                  aria-label="Evidence kind"
+                  value={kind}
+                  onChange={e => setKind(e.currentTarget.value)}
+                >
+                  <option value="all">All evidence</option>
+                  <option value="annotation">With annotations</option>
+                  <option value="note">With personal notes</option>
+                </select>
+              </>
+            )}
+          </div>
+          <div className="kura-legend">
+            {roots.map(c => (
+              <button key={c.id} onClick={() => setSelected(c.id)}>
+                <span
+                  className="kura-swatch"
+                  style={{ background: color(c) }}
+                />
+                {c.name}
+              </button>
+            ))}
+          </div>
+          {!clusters.length && (
+            <p>No annotations or personal notes to cluster yet.</p>
+          )}
+          {!!clusters.length && (
+            <div className="kura-layout">
+              <section className="kura-panel" aria-label="Explore clusters">
+                {view === 'map' &&
+                  (visible.length ? (
+                    <ClusterMap
+                      clusters={visible}
+                      color={color}
+                      selected={selectedID}
+                      onSelect={setSelected}
+                    />
+                  ) : (
+                    <p>No clusters match these filters.</p>
+                  ))}
+                {view === 'hierarchy' && (
+                  <TopicTree
+                    clusters={clusters}
+                    color={color}
+                    selected={selectedID}
+                    selectedPath={new Set([selectedID, ...ancestors])}
+                    collapsed={collapsed}
+                    onToggle={id =>
+                      setCollapsed(current => {
+                        const next = new Set(current);
+                        if (next.has(id)) {
+                          next.delete(id);
+                        } else {
+                          next.add(id);
+                        }
+                        return next;
+                      })
+                    }
+                    onSelect={setSelected}
+                  />
+                )}
+                {view === 'sizes' && (
+                  <>
+                    <ul className="kura-sizes">
+                      {sizeList.items.map(c => (
+                        <li key={c.id}>
+                          <button
+                            aria-pressed={selectedID === c.id}
+                            onClick={() => setSelected(c.id)}
+                          >
+                            <span>{c.name}</span>
+                            <b>{c.count}</b>
+                            <span
+                              className="kura-bar"
+                              style={{
+                                width: `${Math.max(1, (c.count / Math.max(total, 1)) * 100)}%`,
+                                background: color(c),
+                              }}
+                            />
+                          </button>
+                        </li>
+                      ))}
+                    </ul>
+                    <LibraryShowMore {...sizeList} label="topics" />
+                  </>
+                )}
+              </section>
+              <aside
+                className="kura-panel kura-details"
+                aria-label="Cluster evidence"
+              >
+                {!chosen ? (
+                  <>
+                    <h3>Select a topic to view evidence</h3>
+                  </>
+                ) : (
+                  <>
+                    {chosen.parent_id && (
+                      <button
+                        className="kura-back"
+                        onClick={() => setSelected(chosen.parent_id!)}
+                      >
+                        ↑ {clusters.find(c => c.id === chosen.parent_id)?.name}
+                      </button>
+                    )}
+                    <h3>{chosen.name}</h3>
+                    <p>{chosen.description}</p>
+                    <small>
+                      {chosen.count} items ·{' '}
+                      {total ? Math.round((chosen.count / total) * 100) : 0}% of
+                      your evidence
+                    </small>
+                    {!!chosen.children.length && (
+                      <div className="kura-subtopics">
+                        {chosen.children.map(id => {
+                          const child = clusters.find(c => c.id === id)!;
+                          return (
+                            <button key={id} onClick={() => setSelected(id)}>
+                              {child.name}
+                              <small>{child.count}</small>
+                            </button>
+                          );
+                        })}
+                      </div>
+                    )}
+                    {loading && <p role="status">Loading evidence…</p>}
+                    {members?.results.map(item => (
+                      <article className="kura-evidence" key={item.id}>
+                        <small>
+                          {item.kind === 'note'
+                            ? 'PERSONAL NOTE'
+                            : 'ANNOTATION'}
+                          {item.reaction
+                            ? ` · Your reaction: ${item.reaction}`
+                            : ''}
+                          {item.page_reaction
+                            ? ` · Page reaction: ${item.page_reaction}`
+                            : ''}
+                        </small>
+                        <h4>
+                          <a
+                            href={webURL(item.url)}
+                            target="_blank"
+                            rel="noreferrer"
+                          >
+                            {item.title}
+                          </a>
+                        </h4>
+                        <p className="kura-summary">{item.summary}</p>
+                        <details>
+                          <summary>Read original evidence</summary>
+                          {item.highlight && (
+                            <blockquote>{item.highlight}</blockquote>
+                          )}
+                          {item.comment && (
+                            <p className="kura-original">
+                              <b>Your comment:</b> {item.comment}
+                            </p>
+                          )}
+                          {item.text && (
+                            <p className="kura-original">{item.text}</p>
+                          )}
+                          {webURL(item.source_url) && (
+                            <a
+                              href={item.source_url}
+                              target="_blank"
+                              rel="noreferrer"
+                            >
+                              Open source page
+                            </a>
+                          )}
+                        </details>
+                      </article>
+                    ))}
+                    {members &&
+                      members.offset + members.results.length <
+                        members.total && (
+                        <button
+                          className="ld-button"
+                          disabled={loading}
+                          onClick={() => {
+                            const id = requestID.current;
+                            setLoading(true);
+                            void researchRequest('kura-members', {
+                              values: {
+                                cluster_id: selected,
+                                offset: members.offset + members.results.length,
+                              },
+                            })
+                              .then(result => {
+                                if (
+                                  active.current &&
+                                  requestID.current === id
+                                ) {
+                                  const next = result as Members;
+                                  setMembers({
+                                    ...next,
+                                    offset: 0,
+                                    results: [
+                                      ...members.results,
+                                      ...next.results,
+                                    ],
+                                  });
+                                }
+                              })
+                              .catch(e => {
+                                if (active.current) {
+                                  setError(e.message);
+                                }
+                              })
+                              .finally(() => {
+                                if (
+                                  active.current &&
+                                  requestID.current === id
+                                ) {
+                                  setLoading(false);
+                                }
+                              });
+                          }}
+                        >
+                          Load more evidence (
+                          {members.total - members.results.length} remaining)
+                        </button>
+                      )}
+                  </>
+                )}
+              </aside>
+            </div>
+          )}
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/src/sidebar/components/LibraryDashboard.tsx b/src/sidebar/components/LibraryDashboard.tsx
