#!/usr/bin/env python3
"""Reconstruct the optional, pinned upstream Kura runtime without replacing work."""
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
PIN = "956d95ac6a19c841c59eefe692f3341dfc2ba410"
checkout = ROOT / "upstream/kura"
if not checkout.exists():
    subprocess.run(["git", "clone", "https://github.com/jxnl/kura.git", str(checkout)], check=True)
head = subprocess.check_output(["git", "-C", str(checkout), "rev-parse", "HEAD"], text=True).strip()
if head != PIN:
    dirty = subprocess.check_output(["git", "-C", str(checkout), "status", "--porcelain"], text=True)
    if dirty:
        sys.exit("Kura checkout has changes at another revision; preserve and reconcile them before setup.")
    subprocess.run(["git", "-C", str(checkout), "checkout", "--detach", PIN], check=True)
python = shutil.which("python3.12") or sys.executable
runtime = ROOT / ".local-tools/kura"
if not (runtime / "bin/python").exists():
    subprocess.run([python, "-m", "venv", str(runtime)], check=True)
subprocess.run([str(runtime / "bin/python"), "-m", "pip", "install", "--disable-pip-version-check",
                "-r", str(ROOT / "requirements-kura.txt")], check=True)
print("Kura runtime ready. Run: ./research-partner/notes kura run --allow-private-context")
