+import { mount } from '@hypothesis/frontend-testing';
+import { act } from 'preact/test-utils';
+
+import { useResearchRefresh } from '../use-research-refresh';
+
+describe('useResearchRefresh', () => {
+  let clock;
+  let visibility;
+  let refresh;
+  beforeEach(() => {
+    clock = sinon.useFakeTimers();
+    visibility = 'visible';
+    sinon.stub(document, 'visibilityState').get(() => visibility);
+    refresh = sinon.stub().resolves();
+  });
+  function TestRefresh(props) {
+    useResearchRefresh(props);
+    return null;
+  }
+  const create = enabled =>
+    mount(
+      <TestRefresh enabled={enabled} interval={30_000} refresh={refresh} />,
+    );
+  const tick = time =>
+    act(async () => {
+      await clock.tickAsync(time);
+    });
+  it('refreshes on the chosen interval, pauses when hidden and resumes on focus', async () => {
+    create(true);
+    await tick(30_000);
+    assert.calledOnce(refresh);
+    visibility = 'hidden';
+    await tick(60_000);
+    assert.calledOnce(refresh);
+    visibility = 'visible';
+    await act(async () => window.dispatchEvent(new Event('focus')));
+    assert.calledTwice(refresh);
+  });
+  it('does not overlap requests or continue after disabling or unmounting', async () => {
+    let complete;
+    refresh.returns(
+      new Promise(resolve => {
+        complete = resolve;
+      }),
+    );
+    const wrapper = create(true);
+    await tick(90_000);
+    assert.calledOnce(refresh);
+    await act(async () => complete());
+    wrapper.setProps({ enabled: false });
+    await tick(60_000);
+    assert.calledOnce(refresh);
+    wrapper.setProps({ enabled: true });
+    wrapper.unmount();
+    await tick(60_000);
+    assert.calledOnce(refresh);
+  });
+});
diff --git a/src/sidebar/components/hooks/use-library-route.ts b/src/sidebar/components/hooks/use-library-route.ts
