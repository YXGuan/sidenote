@@ -0,0 +1,146 @@
+import {
+  activityBuckets,
+  activityPreferences,
+  ACTIVITY_PREFERENCE_KEY,
+} from '../library-activity';
+
+describe('library activity', () => {
+  const today = new Date('2026-01-05T08:00:00Z');
+  const pages = [
+    {
+      created_at: '2025-12-28T23:30:00-02:00',
+      annotation_activity: {
+        '2025-12-28': 2,
+        '2025-12-29': 3,
+        '2026-01-04': 4,
+        '2026-01-05': 5,
+        '2026-01-06': 99,
+        '2025-02-30': 99,
+      },
+      activity: {
+        visits_by_day: {
+          '2025-12-28': 1,
+          '2025-12-29': 2,
+          '2026-01-04': 3,
+          '2026-01-05': 4,
+          '2026-01-06': 99,
+        },
+      },
+    },
+    {
+      created_at: '2026-01-05T05:00:00Z',
+      annotation_activity: { '2026-01-05': 1 },
+    },
+  ];
+
+  it('uses UTC dates, sums every page, and includes zero-activity days', () => {
+    const result = activityBuckets(pages, 'daily', 8, today);
+    assert.equal(result.length, 8);
+    assert.equal(result[0].key, '2025-12-29');
+    assert.deepInclude(result[0], { pages: 1, annotations: 3, visits: 2 });
+    assert.deepInclude(result.at(-1), {
+      key: '2026-01-05',
+      pages: 1,
+      annotations: 6,
+      visits: 4,
+    });
+    assert.deepInclude(result[1], { pages: 0, annotations: 0, visits: 0 });
+    assert.equal(
+      result.reduce((sum, b) => sum + b.annotations, 0),
+      13,
+    );
+  });
+
+  it('groups Sunday with the previous Monday and handles the year boundary', () => {
+    const result = activityBuckets(pages, 'weekly', 2, today);
+    assert.deepEqual(
+      result.map(({ key, pages, annotations, visits }) => ({
+        key,
+        pages,
+        annotations,
+        visits,
+      })),
+      [
+        { key: '2025-12-29', pages: 1, annotations: 7, visits: 5 },
+        { key: '2026-01-05', pages: 1, annotations: 6, visits: 4 },
+      ],
+    );
+  });
+
+  it('aggregates calendar months and excludes dates after today within the current month', () => {
+    const result = activityBuckets(pages, 'monthly', 2, today);
+    assert.deepEqual(
+      result.map(({ key, pages, annotations, visits }) => ({
+        key,
+        pages,
+        annotations,
+        visits,
+      })),
+      [
+        { key: '2025-12', pages: 1, annotations: 5, visits: 3 },
+        { key: '2026-01', pages: 1, annotations: 10, visits: 7 },
+      ],
+    );
+  });
+
+  it('handles leap days, invalid dates/counts and an empty library', () => {
+    const result = activityBuckets(
+      [
+        {
+          created_at: 'invalid',
+          annotation_activity: {
+            '2024-02-29': 2,
+            '2024-02-30': 30,
+            '2024-03-01': -1,
+          },
+          activity: { visits_by_day: { '2024-02-29': NaN } },
+        },
+      ],
+      'daily',
+      3,
+      new Date('2024-03-01T12:00:00Z'),
+    );
+    assert.deepEqual(
+      result.map(b => b.key),
+      ['2024-02-28', '2024-02-29', '2024-03-01'],
+    );
+    assert.equal(result[1].annotations, 2);
+    assert.equal(
+      result.reduce((sum, b) => sum + b.pages + b.visits, 0),
+      0,
+    );
+    assert.isTrue(
+      activityBuckets([], 'monthly', 12, today).every(
+        b => b.pages + b.annotations + b.visits === 0,
+      ),
+    );
+  });
+
+  it('restores valid per-interval ranges and falls back safely for malformed/unavailable storage', () => {
+    const saved = {
+      interval: 'weekly',
+      periods: { daily: 90, weekly: 26, monthly: 12 },
+    };
+    const getItem = sinon.stub().returns(JSON.stringify(saved));
+    assert.deepEqual(activityPreferences({ getItem }), saved);
+    assert.calledWith(getItem, ACTIVITY_PREFERENCE_KEY);
+    for (const value of [
+      'null',
+      '{',
+      JSON.stringify({ interval: 'hourly', periods: { daily: 999 } }),
+    ]) {
+      assert.deepEqual(activityPreferences({ getItem: () => value }), {
+        interval: 'monthly',
+        periods: { daily: 30, weekly: 12, monthly: 6 },
+      });
+    }
+    assert.equal(
+      activityPreferences({
+        getItem: () => {
+          throw new Error('Storage unavailable');
+        },
+      }).interval,
+      'monthly',
+    );
+  });
+});
