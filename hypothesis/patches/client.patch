+import { mount } from '@hypothesis/frontend-testing';
+import { act } from 'preact/test-utils';
+
+import PageMetadataEditor from '../PageMetadataEditor';
+
+describe('PageMetadataEditor', () => {
+  let props;
+  beforeEach(() => {
+    props = {
+      doc: {
+        id: 'paper',
+        classification: {
+          link_type: 'paper',
+          topics: ['AI, reasoning and cognition'],
+          keywords: ['Metacognition'],
+          subtopics: [],
+        },
+        classification_source: 'openalex',
+        metadata: {
+          openalex_id: 'https://openalex.org/W123',
+          semantic_scholar_id: 'a'.repeat(40),
+          arxiv_id: '1706.03762v2',
+          authors: ['Ada Reader'],
+        },
+        analysis: {},
+      },
+      busy: false,
+      onSave: sinon.stub().resolves(true),
+    };
+  });
+  const create = () => mount(<PageMetadataEditor {...props} />);
+  const edit = wrapper =>
+    wrapper
+      .find('button')
+      .filterWhere(button => button.text() === 'Edit details')
+      .simulate('click');
+  const input = (wrapper, label, value) => {
+    const field = wrapper.find(`input[aria-label="${label}"]`);
+    field.getDOMNode().value = value;
+    field.simulate('input');
+  };
+  const submit = async wrapper =>
+    act(async () =>
+      wrapper
+        .find('form')
+        .props()
+        .onSubmit({ preventDefault() {} }),
+    );
+
+  it('shows OpenAlex topics and flat keywords with all three index links', () => {
+    const wrapper = create();
+    assert.include(wrapper.text(), 'Topics & keywords from OpenAlex');
+    assert.include(wrapper.text(), 'AI, reasoning and cognition');
+    assert.include(wrapper.text(), 'Metacognition');
+    assert.notInclude(wrapper.text(), 'Subtopics');
+    assert.isTrue(
+      wrapper.find('a[href="https://api.openalex.org/works/W123"]').exists(),
+    );
+    assert.isTrue(
+      wrapper.find('a[href="https://arxiv.org/abs/1706.03762v2"]').exists(),
+    );
+    assert.isTrue(
+      wrapper
+        .find(
+          `a[href="https://www.semanticscholar.org/paper/${'a'.repeat(40)}"]`,
+        )
+        .exists(),
+    );
+  });
+
+  it('shows arXiv as the only available index and rejects malformed identifiers', () => {
+    props.doc.metadata = { arxiv_id: 'hep-th/9901001v2' };
+    const wrapper = create();
+    assert.isTrue(
+      wrapper.find('a[href="https://arxiv.org/abs/hep-th/9901001v2"]').exists(),
+    );
+    wrapper.setProps({
+      doc: { ...props.doc, metadata: { arxiv_id: 'javascript:alert(1)' } },
+    });
+    assert.isFalse(wrapper.find('.research-indexes').exists());
+  });
+
+  it('keeps citation-only corrections from freezing the automatic classification', async () => {
