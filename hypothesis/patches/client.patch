@@ -0,0 +1,199 @@
+/** Local additions to the original client. The bridge key stays in the worker. */
+import type { Annotation } from '../../types/api';
+
+export type PageReaction = 'like' | 'bad' | null;
+export type PageClassification = {
+  link_type: string;
+  topics: string[];
+  subtopics: { topic: string; name: string }[];
+  keywords?: string[];
+};
+
+export type ResearchDocument = {
+  id: string;
+  title: string;
+  url: string;
+  reaction: PageReaction;
+  page_tags: string[];
+  manual_tags: string[];
+  auto_tags: string[];
+  excluded_auto_tags: string[];
+  classification: PageClassification;
+  groups: string[];
+  automatic_collections?: string[];
+  collection_signals?: {
+    positive_comments: number;
+    negative_comments: number;
+    question_annotations: number;
+    visits_30_days: number;
+  };
+  created_at: string;
+  updated_at: string;
+  classification_manual?: boolean;
+  classification_source?: string;
+  summary?: string;
+  activity?: {
+    visit_count?: number;
+    last_visit_at?: string;
+    visits_by_day?: Record<string, number>;
+  };
+  annotations: Annotation[];
+  annotation_states: Record<
+    string,
+    {
+      reaction?: 'like' | 'dislike' | null;
+      analysis?: {
+        sentiment: string;
+        confidence: number;
+        reason: string;
+        stale?: boolean;
+      };
+    }
+  >;
+  metadata: {
+    authors?: string[];
+    institutions?: string[];
+    journal?: string;
+    doi?: string;
+    title?: string;
+    published?: string;
+    arxiv_id?: string;
+    openalex_id?: string;
+    openalex_api_url?: string;
+    openalex_fetched_at?: string;
+    openalex_topics?: { id: string; display_name: string; score?: number }[];
+    openalex_keywords?: { id: string; display_name: string; score?: number }[];
+    semantic_scholar_id?: string;
+    description?: string;
+    abstract?: string;
+    citation_counts?: Record<string, number>;
+    citation_counts_as_of?: string;
+    scholarly_lookup?: {
+      checked_at: string;
+      providers: Record<string, string>;
+    };
+    author_identities?: {
+      name: string;
+      openalex_id?: string;
+      semantic_scholar_id?: string;
+      orcid?: string;
+      institutions?: { name: string; id?: string }[];
+    }[];
+    provenance?: Record<string, { source: string }>;
+  };
+  analysis: {
+    input_hash?: string;
+    summary?: string;
+    stale?: boolean;
+    tags?: string[];
+    sentiments?: {
+      annotation_id: string;
+      sentiment: string;
+      reason: string;
+      confidence: number;
+    }[];
+  };
+};
+
+type Runtime = {
+  id?: string;
+  sendMessage: (message: unknown) => Promise<{
+    ok: boolean;
+    error?: string;
+    data?: Record<string, any>;
+  }>;
+};
+
+function runtime(): Runtime | undefined {
+  return (
+    globalThis as typeof globalThis & {
+      chrome?: { runtime?: Runtime };
+    }
+  ).chrome?.runtime;
+}
+
+export function localResearchEnabled() {
+  return !!runtime()?.id;
+}
+
+export async function researchRequest(
+  action: string,
+  payload: Record<string, unknown> = {},
+) {
+  const extension = runtime();
+  if (!extension?.id) {
+    throw new Error('Local research is available in the sidenote extension');
+  }
+  const response = await extension.sendMessage({
+    type: 'local-research',
+    action,
+    ...payload,
+  });
+  if (!response?.ok) {
+    throw new Error(response?.error || 'Local research is unavailable');
+  }
+  return response.data ?? {};
+}
+
+const documents = new Map<string, ResearchDocument | null>();
+const pending = new Map<string, Promise<ResearchDocument | null>>();
+const listeners = new Set<() => void>();
+
+export function subscribeResearch(listener: () => void) {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export function cachedResearchDocument(uri: string) {
+  return documents.get(uri) ?? null;
+}
+
+export function rememberResearchDocument(uri: string, doc: ResearchDocument) {
+  documents.set(uri, doc);
+  listeners.forEach(listener => listener());
+  return doc;
+}
+
+export async function loadResearchDocument(uri: string) {
+  if (documents.has(uri)) {
+    return documents.get(uri)!;
+  }
+  if (!pending.has(uri)) {
+    const request = researchRequest('document', { uri })
+      .then(result => {
+        const doc = (result.document as ResearchDocument) ?? null;
+        documents.set(uri, doc);
+        listeners.forEach(listener => listener());
+        return doc;
+      })
+      .finally(() => pending.delete(uri));
+    pending.set(uri, request);
+  }
+  return pending.get(uri)!;
+}
+
+export async function mirrorResearchAnnotation(
+  annotation: Annotation,
+  document: unknown,
+) {
+  if (!localResearchEnabled()) {
+    return;
+  }
+  const result = await researchRequest('annotation', { annotation, document });
+  if (result.document) {
+    rememberResearchDocument(
+      annotation.uri,
+      result.document as ResearchDocument,
+    );
+  }
+}
+
+export async function captureResearchDocument(uri: string, document: unknown) {
+  if (!localResearchEnabled()) {
+    return;
+  }
+  const result = await researchRequest('capture', { uri, document });
+  if (result.document) {
+    rememberResearchDocument(uri, result.document as ResearchDocument);
+  }
+}
