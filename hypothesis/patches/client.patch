@@ -0,0 +1,41 @@
+export type ResearchUpdates = {
+  wiki: boolean;
+  graph: boolean;
+  kura: boolean;
+  interval: number;
+};
+
+export const RESEARCH_UPDATES_KEY = 'hypothesis.local-research.updates.v1';
+export const REFRESH_INTERVALS = [30_000, 60_000, 300_000] as const;
+export const DEFAULT_RESEARCH_UPDATES: ResearchUpdates = {
+  wiki: false,
+  graph: true,
+  kura: true,
+  interval: 60_000,
+};
+
+export function researchUpdates(
+  storage: Pick<Storage, 'getItem'>,
+): ResearchUpdates {
+  try {
+    const saved = JSON.parse(storage.getItem(RESEARCH_UPDATES_KEY) ?? '{}');
+    const defaults = DEFAULT_RESEARCH_UPDATES;
+    return {
+      wiki: typeof saved.wiki === 'boolean' ? saved.wiki : defaults.wiki,
+      graph: typeof saved.graph === 'boolean' ? saved.graph : defaults.graph,
+      kura: typeof saved.kura === 'boolean' ? saved.kura : defaults.kura,
+      interval: REFRESH_INTERVALS.includes(saved.interval)
+        ? saved.interval
+        : defaults.interval,
+    };
+  } catch {
+    return { ...DEFAULT_RESEARCH_UPDATES };
+  }
+}
+
+export function researchUpdatedAt(value?: string, built = false) {
+  if (!value || !Number.isFinite(Date.parse(value))) {
+    return built ? 'Build time unavailable' : 'Not built yet';
+  }
+  return `Updated ${new Date(value).toLocaleString()}`;
+}
