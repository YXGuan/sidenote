+const sampleEvidence = docs.slice(0, 3).map(d => ({
+  id: d.annotation_ids[0] ?? d.id,
+  document_id: d.id,
+  title: d.title,
+  url: d.url,
+  text: d.summary,
+  highlight: d.summary,
+  comment: 'Illustrative reader note; no model was called.',
+  kind: 'annotations',
+}));
+const sampleCitations = [
+  { evidence_id: sampleEvidence[0].id, quote: sampleEvidence[0].highlight },
+];
+const sampleRelation = {
+  id: 'preview-relation',
+  source: 'topic-demo-0',
+  target: 'concept-demo-network',
+  relation: 'studies',
+  basis: 'inferred',
+  explanation:
+    'Illustrative connection: network structure is one lens for studying social behavior. No model was called.',
+  evidence: sampleCitations,
+};
+const sampleWiki = () => ({
+  pages: [
+    ...docs.slice(0, 3).map((d, i) => ({
+      id: `topic-demo-${i}`,
+      title: i === 0 ? 'Computational social science' : d.title,
+      kind: i === 0 ? 'topic' : 'source',
+      provider: 'local',
+      evidence_ids: sampleEvidence.map(e => e.id),
+      related: ['concept-demo-network'],
+      claims: [],
+      relationships: [],
+      markdown: '',
+    })),
+    {
+      id: 'concept-demo-network',
+      title: 'Network structure',
+      aliases: ['Network topology'],
+      kind: 'concept',
+      provider: 'illustrative-fixture',
+      evidence_ids: [sampleEvidence[0].id],
+      related: ['topic-demo-0'],
+      relationships: [],
+      markdown: '',
+      claims: [
+        {
+          kind: 'overview',
+          text: 'Illustrative concept page: network structure describes how connections are arranged. No model was called.',
+          evidence: sampleCitations,
+        },
+      ],
+    },
+  ],
+  evidence: sampleEvidence,
+  stale: false,
+});
+
+(globalThis as any).chrome = {
+  runtime: {
+    id: 'synthetic-preview',
+    sendMessage: async (m: any) => {
+      const doc = docs.find(d => d.url === m.uri);
+      let data: any = {};
+      if (m.action === 'refresh-recommendations') {
+        previewRecommendations = {
+          ...previewRecommendations,
+          generated_at: new Date().toISOString(),
+          used_seed_count: 2,
+          seeds: docs
+            .slice(0, 2)
+            .map(d => ({ document_id: d.id, title: d.title, status: 'used' })),
+          papers: Array.from({ length: 45 }, (_, i) => ({
+            paper_id: `illustrative-${i}`,
+            title: `Illustrative recommendation ${i + 1}: understanding connected ideas`,
+            url: `https://example.org/recommendation/${i}`,
+            authors: ['Ada Reader', 'Taylor Scholar'],
+            venue: i % 2 ? 'Example research journal' : 'Example conference',
+            year: 2026 - (i % 5),
+            abstract:
+              'Synthetic paper for the design preview. No recommendation API or model was called.',
+            citation_count: i * 3,
+            pdf_url: '',
+          })),
+          job: { state: 'completed' },
+        };
+        data = { job: previewRecommendations.job };
+      } else if (m.action === 'recommendations') {
+        data = previewRecommendations;
+      } else if (m.action === 'wiki') {
+        data = previewWiki;
+      } else if (m.action === 'graph') {
+        const nodes = [
+          ...docs.slice(0, 8).map(d => ({
+            id: d.id,
+            label: d.title,
+            kind: 'source',
+            url: d.url,
+          })),
+          {
+            id: 'topic-demo-0',
+            label: 'Computational social science',
+            kind: 'topic',
+            page_id: 'topic-demo-0',
+          },
+          {
+            id: 'concept-demo-network',
+            label: 'Network structure',
+            kind: 'concept',
+            page_id: 'concept-demo-network',
+          },
+        ];
+        const edges = [
+          ...docs.slice(0, 8).map((d, i) => ({
+            id: `e${i}`,
+            source: d.id,
+            target: 'topic-demo-0',
+            relation: 'discusses',
+            basis: 'metadata',
+            evidence: [
+              {
+                ...sampleEvidence[i % 3],
+                evidence_id: sampleEvidence[i % 3].id,
+                quote: '',
+              },
+            ],
+          })),
+          {
+            ...sampleRelation,
+            evidence: [{ ...sampleEvidence[0], ...sampleCitations[0] }],
+          },
+        ];
+        const query = String(m.values?.query ?? '').toLowerCase();
+        const matches = query
+          ? nodes.filter(n => n.label.toLowerCase().includes(query))
+          : [];
+        const focus =
+          m.values?.focus ||
+          (m.values?.overview ? '' : (matches[0]?.id ?? 'topic-demo-0'));
+        const visible = new Set(focus ? [focus] : nodes.map(n => n.id));
+        for (let i = 0; i < (m.values?.depth ?? 1); i++) {
+          const previous = new Set(visible);
+          for (const e of edges) {
+            if (previous.has(e.source) || previous.has(e.target)) {
+              visible.add(e.source);
+              visible.add(e.target);
+            }
+          }
+        }
+        data = {
+          nodes: nodes.filter(n => visible.has(n.id)),
+          edges: edges.filter(
+            e => visible.has(e.source) && visible.has(e.target),
+          ),
+          matches,
+          focus,
+          depth: m.values?.depth ?? 1,
+          total_nodes: visible.size,
+          library_nodes: nodes.length,
+          truncated: false,
+          notice:
+            'Illustrative graph using synthetic preview records. No model was called.',
+        };
+      } else if (m.action === 'research-job') {
+        data = { job: researchJob };
+      } else if (m.action === 'research') {
+        const v = m.values;
+        let result: any;
+        if (v.operation === 'build-wiki') {
+          previewWiki = sampleWiki();
+          result = previewWiki;
+        } else if (v.operation === 'synthesize') {
+          previewWiki.pages = previewWiki.pages.map((p: any) =>
+            p.id === v.page_id
+              ? {
+                  ...p,
+                  provider: 'illustrative-fixture',
+                  claims: [
+                    {
+                      kind: 'overview',
+                      text: 'Illustrative overview: computational social science combines models and observations to understand social behavior. No model was called.',
