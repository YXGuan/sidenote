+);
+const previewSettings = JSON.parse(
+  sessionStorage.getItem('preview-maintenance-settings') ?? 'null',
+) ?? {
+  preferences: {
+    backup_enabled: false,
+    backup_time: '03:00',
+    backup_public_only: true,
