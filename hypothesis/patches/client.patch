+}
+const formatDate = (value: string) =>
+  value && Number.isFinite(Date.parse(value))
+    ? new Date(value).toLocaleDateString(undefined, {
+        month: 'short',
+        day: 'numeric',
+        year: 'numeric',
+      })
+    : 'Unknown';
+const sourceType = (p: LibraryPage) =>
+  p.classification.link_type === 'unknown'
+    ? 'Unclassified'
+    : p.classification.link_type;
+
+export default function LocalLibraryView() {
+  const [initial] = useState(() =>
+    libraryPreferences(localStorage, location.search),
+  );
+  const [developerMode, setDeveloperMode] = useState(initial.developerMode);
+  const [pages, setPages] = useState<LibraryPage[]>([]);
+  const [groups, setGroups] = useState<string[]>(['For later', 'Likes']);
+  const [query, setQuery] = useState('');
+  const [filters, setFilters] = useState<LibraryFilters>(EMPTY_FILTERS);
+  const [sort, setSort] = useState<LibrarySort>(initial.sort);
+  const [colorScheme, setColorScheme] = useState<LibraryColorScheme>(
+    initial.colorScheme,
+  );
+  const [systemDark, setSystemDark] = useState(
+    () => matchMedia('(prefers-color-scheme: dark)').matches,
+  );
+  const resolvedColorScheme =
+    colorScheme === 'system' ? (systemDark ? 'dark' : 'light') : colorScheme;
+  useEffect(() => {
+    const media = matchMedia('(prefers-color-scheme: dark)');
+    const update = () => setSystemDark(media.matches);
+    media.addEventListener('change', update);
+    update();
+    return () => media.removeEventListener('change', update);
+  }, []);
+  const { route, navigate } = useLibraryRoute(initial.tab);
+  const { tab, collection, page: selected } = route;
+  const [newGroup, setNewGroup] = useState('');
+  const [moreFilters, setMoreFilters] = useState(false);
+  const [error, setError] = useState('');
+  const [warning, setWarning] = useState('');
+  const [needsReload, setNeedsReload] = useState<boolean | null>(null);
+  const [loaded, setLoaded] = useState(false);
+  const [busy, setBusy] = useState(true);
+  const [pending, setPending] = useState<string[]>([]);
+  const [removedPage, setRemovedPage] = useState<LibraryPage | null>(null);
+  const [lastBackup, setLastBackup] = useState('');
+  const [job, setJob] = useState<Job | null>(null);
+  const [enrichment, setEnrichment] = useState<Job | null>(null);
+  const [backup, setBackup] = useState<MaintenanceJob | null>(null);
+  const [provider, setProvider] = useState('local');
+  const running = (j: MaintenanceJob | null) =>
+    j?.state === 'running' || j?.state === 'queued';
+  const working = running(job) || running(enrichment) || running(backup);
+  const selectPage = useCallback(
+    (page: string | null) => navigate({ ...route, page }),
+    [route, navigate],
+  );
+  const chooseTab = (tab: LibraryTab) => navigate({ ...LIBRARY_HOME, tab });
+  const refresh = useCallback(async (quiet = false) => {
+    if (!quiet) {
+      setBusy(true);
+    }
+    setError('');
+    try {
+      const result = await loadLibrary();
+      setPages(result.library.documents.map(normalizePage));
+      setGroups(result.library.groups ?? ['For later', 'Likes']);
+      setLastBackup(result.status?.last_sync?.completed ?? '');
+      setJob(result.organization?.job ?? null);
+      setEnrichment(result.organization?.enrichment ?? null);
+      setBackup(result.organization?.backup ?? null);
+      setWarning(result.warning);
+      setNeedsReload(result.needsReload);
+      setLoaded(true);
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      if (!quiet) {
+        setBusy(false);
+      }
+    }
+  }, []);
+  useEffect(() => {
+    void refresh();
+  }, [refresh]);
+  useEffect(() => {
+    const update = () => {
+      if (document.visibilityState === 'visible') {
+        void refresh(true);
+      }
+    };
+    window.addEventListener('focus', update);
+    const timer = setInterval(update, 30_000);
+    return () => {
+      window.removeEventListener('focus', update);
+      clearInterval(timer);
+    };
+  }, [refresh]);
+  useEffect(() => {
+    if (!working) {
+      return undefined;
+    }
+    const timer = setInterval(() => {
+      void refresh(true);
+    }, 3000);
+    return () => clearInterval(timer);
+  }, [working, refresh]);
+  useEffect(
+    () =>
+      subscribeResearch(() =>
+        setPages(current =>
+          current.map(p => {
+            const doc = cachedResearchDocument(p.url);
+            return doc ? pageFromDocument(p, doc) : p;
+          }),
+        ),
+      ),
+    [],
+  );
+  useLayoutEffect(() => {
+    try {
+      localStorage.setItem(
+        LIBRARY_PREFERENCE_KEY,
+        JSON.stringify({ developerMode, design: 'compact', sort, colorScheme }),
+      );
+    } catch {
+      /* Optional preference. */
+    }
+  }, [sort, colorScheme, developerMode]);
+  useEffect(() => {
+    const close = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') {
+        selectPage(null);
+      }
+    };
+    window.addEventListener('keydown', close);
+    return () => window.removeEventListener('keydown', close);
+  }, [selectPage]);
+  const changeFilter = (key: keyof LibraryFilters, value: string) =>
+    setFilters(current => ({
+      ...current,
+      [key]: value,
+      ...(key === 'topic' ? { subtopic: '', keyword: '' } : {}),
+    }));
+  const inspectFilter = (key: string, value: string) => {
+    changeFilter(key as keyof LibraryFilters, value);
+    chooseTab('library');
+  };
+  const clear = () => {
+    setQuery('');
+    setFilters(EMPTY_FILTERS);
+  };
+  const filtered = filterPages(pages, query, filters);
+  const visible = sortPages(
+    tab === 'collections' && collection
+      ? filtered.filter(p => pageInCollection(p, collection))
+      : filtered,
+    sort,
+  );
+  const pageBatch = useProgressiveList(
+    visible,
+    JSON.stringify([
+      tab,
+      collection,
+      query,
+      filters,
+      sort,
+      visible.map(page => page.id),
+    ]),
+  );
+  const active = Object.entries(filters).filter(([, value]) => value);
+  const collections = [
+    ...groups,
+    ...AUTOMATIC_COLLECTIONS.map(item => item.id),
+  ];
+  const automaticCollection = AUTOMATIC_COLLECTIONS.find(
+    item => item.id === collection,
+  );
+  const chooseCollection = (id: string) => {
+    navigate({ ...LIBRARY_HOME, tab: 'collections', collection: id });
+  };
+  useEffect(() => {
+    if (collection === 'visit-often') {
+      setSort('visits');
+    }
+  }, [collection]);
+  const all = (label: string, values: { label: string; count: number }[]) => [
+    { value: '', label },
+    ...values.map(v => ({ value: v.label, label: `${v.label} (${v.count})` })),
+  ];
+  const topics = countLabels(pages, p => p.classification.topics);
+  const types = countLabels(pages, p => [p.classification.link_type]);
+  const keywords = countLabels(
+    pages.filter(
+      p => !filters.topic || p.classification.topics.includes(filters.topic),
+    ),
+    pageKeywords,
+  );
+  const authors = countLabels(pages, p => p.metadata.authors ?? []);
+  const institutions = countLabels(pages, p => p.metadata.institutions ?? []);
+  const annotations = pages.reduce(
+    (sum, p) => sum + p.annotation_ids.length,
+    0,
+  );
+  const liked = pages.filter(p => p.reaction === 'like').length;
+  const later = pages.filter(p => p.groups.includes('For later')).length;
+  const selectedPage = pages.find(p => p.id === selected);
+  const selectedURL = selectedPage?.url;
+  useEffect(() => {
+    if (!selectedURL) {
+      return undefined;
+    }
+    let active = true;
+    researchRequest('document', { uri: selectedURL })
+      .then(result => {
+        if (active && result.document) {
+          rememberResearchDocument(
+            selectedURL,
+            result.document as ResearchDocument,
+          );
+        }
+      })
+      .catch(error => {
+        if (active) {
+          setError(error.message);
+        }
+      });
+    return () => {
+      active = false;
+    };
+  }, [selectedURL, enrichment?.state]);
+  const save = async (page: LibraryPage, values: Record<string, unknown>) => {
+    setPending(current => [...current, page.id]);
+    setError('');
+    try {
+      const result = await researchRequest('update', { uri: page.url, values });
+      if (result.document) {
+        rememberResearchDocument(page.url, result.document as ResearchDocument);
+      }
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setPending(current => current.filter(id => id !== page.id));
+    }
+  };
+  const organize = async () => {
+    if (
+      provider === 'codex' &&
+      !(await confirm({
+        title: 'Organize with GPT-6 Luna?',
+        message: `Send titles, URLs, citation metadata and selected saved notes for ${pages.length} pages to your signed-in Codex service. Manual corrections are preserved.`,
+        confirmAction: 'Organize pages',
+      }))
+    ) {
+      return;
+    }
+    try {
+      const result = await researchRequest('organize', {
