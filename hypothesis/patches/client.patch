@@ -0,0 +1,315 @@
+import type { ComponentChildren } from 'preact';
+import { useEffect, useState } from 'preact/hooks';
+
+import type { LibraryColorScheme } from '../helpers/library-preferences';
+import { researchRequest } from '../helpers/local-research';
+
+type Preferences = {
+  backup_enabled: boolean;
+  backup_time: string;
+  backup_public_only: boolean;
+  enrichment_enabled: boolean;
+};
+export type MaintenanceJob = {
+  state: string;
+  completed?: string;
+  local_snapshot_at?: string;
+  error?: string;
+  done?: number;
+  total?: number;
+  skipped?: number;
+  matched?: number;
+  failed?: number;
+};
+type KeyName = 'OPENALEX_API_KEY' | 'S2_API_KEY';
+const KEYS: { name: KeyName; label: string }[] = [
+  { name: 'OPENALEX_API_KEY', label: 'OpenAlex API key' },
+  { name: 'S2_API_KEY', label: 'Semantic Scholar API key' },
+];
+type Settings = {
+  preferences: Preferences;
+  api_keys: Record<KeyName, { configured: boolean; editable: boolean }>;
+};
+const running = (job?: MaintenanceJob | null) =>
+  job?.state === 'queued' || job?.state === 'running';
+const timestamp = (value?: string) =>
+  value ? new Date(value).toLocaleString() : 'Not yet';
+
+export default function LibrarySettings({
+  developerMode,
+  onDeveloperModeChange,
+  colorScheme,
+  onColorSchemeChange,
+  backup,
+  enrichment,
+  onBackup,
+  onEnrich,
+  organization,
+}: {
+  developerMode: boolean;
+  onDeveloperModeChange: (value: boolean) => void;
+  colorScheme: LibraryColorScheme;
+  onColorSchemeChange: (value: LibraryColorScheme) => void;
+  backup: MaintenanceJob | null;
+  enrichment: MaintenanceJob | null;
+  onBackup: () => void;
+  onEnrich: () => void;
+  organization: ComponentChildren;
+}) {
+  const [saved, setSaved] = useState<Settings | null>(null);
+  const [preferences, setPreferences] = useState<Preferences | null>(null);
+  const [keys, setKeys] = useState<Partial<Record<KeyName, string | null>>>({});
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const load = async () => {
+    setError('');
+    try {
+      const result = (await researchRequest('settings')) as Settings;
+      setSaved(result);
+      setPreferences(result.preferences);
+    } catch (error) {
+      setError(error.message);
+    }
+  };
+  useEffect(() => {
+    void load();
+  }, []);
+  const save = async (event: Event) => {
+    event.preventDefault();
+    setBusy(true);
+    setError('');
+    setMessage('');
+    try {
+      // Blank fields keep existing values. Removed keys are sent as null.
+      const api_keys = Object.fromEntries(
+        Object.entries(keys).filter(([, value]) => value !== ''),
+      );
+      const result = (await researchRequest('save-settings', {
+        values: { preferences, api_keys },
+      })) as Settings;
+      setSaved(result);
+      setPreferences(result.preferences);
+      setKeys({});
+      setMessage('Settings saved.');
+    } catch (error) {
+      setError(error.message);
+    } finally {
+      setBusy(false);
+    }
+  };
+  return (
+    <div className="ld-settings-page">
+      <section
+        className="ld-panel ld-appearance"
+        aria-label="Appearance settings"
+      >
+        <h2>Appearance</h2>
+        <label className="ld-choice">
+          <span>Color mode</span>
+          <select
+            aria-label="Color mode"
+            value={colorScheme}
+            onChange={event =>
+              onColorSchemeChange(
+                event.currentTarget.value as LibraryColorScheme,
+              )
+            }
+          >
+            <option value="system">System</option>
+            <option value="light">Light</option>
+            <option value="dark">Dark</option>
+          </select>
+        </label>
+      </section>
+      <section className="ld-panel" aria-label="Developer settings">
+        <h2>Developer mode</h2>
+        <label className="ld-setting-switch">
+          <input
+            type="checkbox"
+            checked={developerMode}
+            onChange={event =>
+              onDeveloperModeChange(event.currentTarget.checked)
+            }
+          />
+          Enable developer mode
+        </label>
+        <p className="ld-hint">
+          Show experimental Wiki and Knowledge graph views in Research. This
+          choice is saved automatically in this browser.
+        </p>
+      </section>
+      {error && (
+        <div className="ld-notice" role="alert">
+          {error}
+          <button onClick={load}>Retry settings</button>
+        </div>
+      )}
+      {message && (
+        <p className="ld-success" role="status">
+          {message}
+        </p>
+      )}
+      {!preferences || !saved ? (
+        <p role="status">Loading settings…</p>
+      ) : (
+        <form onSubmit={save}>
+          <fieldset disabled={busy}>
+            <section className="ld-panel" aria-label="Backup settings">
+              <h2>Backup</h2>
+              <label className="ld-setting-switch">
+                <input
+                  type="checkbox"
+                  checked={preferences.backup_enabled}
+                  onChange={event =>
+                    setPreferences({
+                      ...preferences,
+                      backup_enabled: event.currentTarget.checked,
+                    })
+                  }
+                />
+                Back up automatically every day
+              </label>
+              <label className="ld-choice">
+                <span>Daily backup time (local)</span>
+                <input
+                  type="time"
+                  aria-label="Daily backup time"
+                  value={preferences.backup_time}
+                  required
+                  onInput={event =>
+                    setPreferences({
+                      ...preferences,
+                      backup_time: event.currentTarget.value,
+                    })
+                  }
+                />
+              </label>
+              <label className="ld-setting-switch">
+                <input
+                  type="checkbox"
+                  checked={preferences.backup_public_only}
+                  onChange={event =>
+                    setPreferences({
+                      ...preferences,
+                      backup_public_only: event.currentTarget.checked,
+                    })
+                  }
+                />
+                Import public annotations only
+              </label>
+              <p className="ld-hint">
+                Private imports require a configured Hypothesis account.
+              </p>
+              <p className="ld-hint">
+                Last successful backup: {timestamp(backup?.completed)}
+                {backup?.local_snapshot_at && (
+                  <> · Local snapshot: {timestamp(backup.local_snapshot_at)}</>
+                )}
+              </p>
+              {backup?.error && <p role="alert">{backup.error}</p>}
+              <button
+                className="ld-button ld-primary"
+                type="button"
+                disabled={running(backup)}
+                onClick={onBackup}
+              >
+                {running(backup) ? 'Backing up…' : 'Back up now'}
+              </button>
+            </section>
+            <section className="ld-panel" aria-label="Enrichment settings">
+              <h2>Research enrichment</h2>
+              <label className="ld-setting-switch">
+                <input
+                  type="checkbox"
+                  checked={preferences.enrichment_enabled}
+                  onChange={event =>
+                    setPreferences({
+                      ...preferences,
+                      enrichment_enabled: event.currentTarget.checked,
+                    })
+                  }
+                />
+                Enrich research automatically
+              </label>
+              <p className="ld-hint">
+                Automatic enrichment requires an API key below.
+              </p>
+              <p className="ld-hint">
+                Last run: {timestamp(enrichment?.completed)}
+                {enrichment?.skipped !== undefined && (
+                  <> · {enrichment.skipped} cached pages skipped</>
+                )}
+              </p>
+              <button
+                className="ld-button"
+                type="button"
+                disabled={running(enrichment)}
+                onClick={onEnrich}
+              >
+                {running(enrichment)
+                  ? `Enriching ${enrichment?.done ?? 0}/${enrichment?.total ?? 0}…`
+                  : 'Enrich research'}
+              </button>
+            </section>
+            <section className="ld-panel" aria-label="API keys">
+              <h2>API keys</h2>
+              <p>Leave a field blank to keep its saved key.</p>
+              {KEYS.map(({ name, label }) => (
+                <div className="ld-key-setting" key={name}>
+                  <label className="ld-choice">
+                    <span>{label}</span>
+                    <input
+                      type="password"
+                      aria-label={label}
+                      autoComplete="off"
+                      spellcheck={false}
+                      disabled={!saved.api_keys[name].editable}
+                      value={keys[name] ?? ''}
+                      onInput={event =>
+                        setKeys({ ...keys, [name]: event.currentTarget.value })
+                      }
+                      placeholder={
+                        saved.api_keys[name].configured
+                          ? 'Configured · enter a replacement'
+                          : 'Enter API key'
+                      }
+                    />
+                  </label>
+                  <span className="ld-hint">
+                    {!saved.api_keys[name].editable
+                      ? 'Managed by the service environment'
+                      : keys[name] === null
+                        ? 'Will be removed when saved'
+                        : saved.api_keys[name].configured
+                          ? 'Configured'
+                          : 'Not configured'}
+                  </span>
+                  {saved.api_keys[name].configured &&
+                    saved.api_keys[name].editable && (
+                      <button
+                        type="button"
+                        className="ld-button"
+                        onClick={() =>
+                          setKeys({
+                            ...keys,
+                            [name]: keys[name] === null ? '' : null,
+                          })
+                        }
+                      >
+                        {keys[name] === null ? 'Keep key' : 'Remove key'}
+                      </button>
+                    )}
+                </div>
+              ))}
+            </section>
+            <button type="submit" className="ld-button ld-primary">
+              {busy ? 'Saving…' : 'Save settings'}
+            </button>
+          </fieldset>
+        </form>
+      )}
+      {organization}
+    </div>
+  );
+}
