+import { mount } from '@hypothesis/frontend-testing';
+
+import { EMPTY_FILTERS } from '../../helpers/library';
+import LibraryTableHeader from '../LibraryTableHeader';
+import SearchableLibraryFilter from '../SearchableLibraryFilter';
+
+describe('LibraryTableHeader', () => {
+  let props;
+  beforeEach(() => {
+    props = {
+      sort: 'newest',
+      onSort: sinon.stub(),
+      filters: EMPTY_FILTERS,
+      onFilter: sinon.stub(),
+      topics: [{ label: 'Learning', count: 2 }],
+      authors: [{ label: 'Ada Reader', count: 1 }],
+      showVisits: false,
+    };
+  });
+  const create = () =>
+    mount(
+      <table>
+        <LibraryTableHeader {...props} />
+      </table>,
+    );
+
+  it('provides both sort directions for each sortable column, and none on Actions', () => {
+    const wrapper = create();
+    const expected = [
+      'title',
+      'title-desc',
+      'fewest-annotations',
+      'annotations',
+      'oldest',
+      'newest',
+      'oldest-updated',
+      'updated',
+    ];
+    wrapper.find('.ld-sort-arrows button').forEach((button, index) => {
+      button.simulate('click');
+      assert.calledWith(props.onSort, expected[index]);
+    });
+    assert.equal(props.onSort.callCount, expected.length);
+    assert.equal(wrapper.find('th[aria-sort="descending"]').text(), 'Added↑↓');
+    assert.isFalse(wrapper.find('th').last().find('button').exists());
+    assert.lengthOf(wrapper.find(SearchableLibraryFilter), 2);
+  });
+
+  it('adds both visit sort directions in Visit Often', () => {
+    props.showVisits = true;
+    const wrapper = create();
+    wrapper
+      .find('button[aria-label="Sort visits (30d) ascending"]')
+      .simulate('click');
+    wrapper
+      .find('button[aria-label="Sort visits (30d) descending"]')
+      .simulate('click');
+    assert.calledWith(props.onSort, 'fewest-visits');
+    assert.calledWith(props.onSort, 'visits');
+  });
+
+  it('uses the shared topic and author filters', () => {
+    const wrapper = create();
+    wrapper.find(SearchableLibraryFilter).at(0).props().onChange('Learning');
+    wrapper.find(SearchableLibraryFilter).at(1).props().onChange('Ada Reader');
+    assert.calledWith(props.onFilter, 'topic', 'Learning');
+    assert.calledWith(props.onFilter, 'author', 'Ada Reader');
+  });
+});
+
+describe('SearchableLibraryFilter', () => {
+  let onChange;
+  const search = (wrapper, value) => {
+    wrapper.find('input').getDOMNode().value = value;
+    wrapper.find('input').simulate('input');
+  };
+  const create = () =>
+    mount(
+      <SearchableLibraryFilter
+        label="Authors"
+        value="Ada Reader"
+        onChange={onChange}
+        options={[
+          { value: '', label: 'All authors' },
+          { value: 'Ada Reader', label: 'Ada Reader (2)' },
+          { value: 'Bea Writer', label: 'Bea Writer (1)' },
+        ]}
+      />,
+      { connected: true },
+    );
+  beforeEach(() => {
+    onChange = sinon.stub();
+  });
+
+  it('searches without changing the selected filter, and selects a matching author', () => {
+    const wrapper = create();
+    wrapper.find('button').simulate('click');
+    search(wrapper, 'bEA');
+    assert.deepEqual(
+      wrapper.find('[role="option"]').map(option => option.text()),
+      ['All authors', 'Bea Writer (1)'],
+    );
+    assert.notCalled(onChange);
+    wrapper.find('[role="option"]').last().simulate('click');
+    assert.calledWith(onChange, 'Bea Writer');
+    assert.isFalse(wrapper.find('button').prop('aria-expanded'));
+  });
+
+  it('supports keyboard selection and clearing the filter after an empty search result', () => {
+    const wrapper = create();
+    wrapper.find('button').simulate('click');
+    search(wrapper, 'Nobody');
+    assert.include(wrapper.text(), 'No matches found.');
+    assert.lengthOf(wrapper.find('[role="option"]'), 1);
+    wrapper.find('input').simulate('keydown', { key: 'Enter' });
+    assert.calledWith(onChange, '');
+  });
+
+  it('moves through search results with arrow keys and closes with Escape', () => {
+    const wrapper = create();
+    wrapper.find('button').simulate('click');
+    wrapper.find('input').simulate('keydown', { key: 'ArrowDown' });
+    wrapper.find('input').simulate('keydown', { key: 'Enter' });
+    assert.calledWith(onChange, 'Bea Writer');
+    wrapper.find('button').simulate('click');
+    wrapper.find('input').simulate('keydown', { key: 'Escape' });
+    assert.isFalse(wrapper.find('button').prop('aria-expanded'));
+  });
+
+  it('selects the first search match with Enter', () => {
+    const wrapper = create();
+    wrapper.find('button').simulate('click');
+    search(wrapper, 'Bea');
+    wrapper.find('input').simulate('keydown', { key: 'Enter' });
+    assert.calledWith(onChange, 'Bea Writer');
+  });
+});
