@@ -0,0 +1,105 @@
+import {
+  LIBRARY_HOME,
+  libraryRouteHash,
+  parseLibraryRoute,
+} from '../library-routes';
+
+describe('local library routes', () => {
+  const cases = [
+    ['#/library', {}],
+    ['#/dashboard', { tab: 'dashboard' }],
+    ['#/settings', { tab: 'settings' }],
+    ['#/recommendations', { tab: 'recommendations' }],
+    ['#/collections', { tab: 'collections' }],
+    [
+      '#/collections/For%20later',
+      { tab: 'collections', collection: 'For later' },
+    ],
+    ['#/library/pages/saved-123', { page: 'saved-123' }],
+    [
+      '#/collections/Likes/pages/saved-123',
+      { tab: 'collections', collection: 'Likes', page: 'saved-123' },
+    ],
+    ['#/research/ask', { tab: 'research' }],
+    ['#/research/find', { tab: 'research', researchView: 'find' }],
+    [
+      '#/research/wiki/topic-123',
+      { tab: 'research', researchView: 'wiki', wikiPage: 'topic-123' },
+    ],
+    ['#/research/graph', { tab: 'research', researchView: 'graph' }],
+    [
+      '#/research/graph/concept-123',
+      { tab: 'research', researchView: 'graph', graphNode: 'concept-123' },
+    ],
+    [
+      '#/research/kura/map',
+      { tab: 'research', researchView: 'kura', kuraView: 'map' },
+    ],
+    [
+      '#/research/kura/hierarchy',
+      { tab: 'research', researchView: 'kura', kuraView: 'hierarchy' },
+    ],
+    [
+      '#/research/kura/sizes/clusters/topic-123',
+      {
+        tab: 'research',
+        researchView: 'kura',
+        kuraView: 'sizes',
+        cluster: 'topic-123',
+      },
+    ],
+  ];
+  cases.forEach(([hash, values]) => {
+    it(`restores and links to ${hash}`, () => {
+      const route = { ...LIBRARY_HOME, ...values };
+      assert.deepEqual(parseLibraryRoute(hash), route);
+      assert.equal(libraryRouteHash(route), hash);
+    });
+  });
+
+  it('encodes collection names and IDs without treating data as path segments', () => {
+    const route = {
+      ...LIBRARY_HOME,
+      tab: 'collections',
+      collection: '日本語 / AI?#%',
+      page: 'source/a?b#c',
+    };
+    const hash = libraryRouteHash(route);
+    assert.include(hash, '%2F');
+    assert.include(hash, '%23');
+    assert.deepEqual(parseLibraryRoute(hash), route);
+  });
+
+  it('keeps old query links as a fallback while explicit routes take precedence', () => {
+    assert.equal(parseLibraryRoute('', 'dashboard').tab, 'dashboard');
+    assert.equal(parseLibraryRoute('#/library', 'dashboard').tab, 'library');
+    assert.equal(
+      libraryRouteHash(parseLibraryRoute('#/research')),
+      '#/research/ask',
+    );
+    assert.equal(
+      libraryRouteHash(parseLibraryRoute('#/research/kura')),
+      '#/research/kura/hierarchy',
+    );
+  });
+
+  it('safely falls back for unknown or malformed routes', () => {
+    for (const hash of [
+      '#unknown',
+      '#/missing',
+      '#/%E0%A4%A',
+      '#/library/pages',
+      '#/library/pages/',
+      '#/dashboard/extra',
+      '#/settings/extra',
+      '#/collections//pages/a',
+      '#/research/other',
+      '#/research/wiki/a/extra',
+      '#/research/graph/a/extra',
+      '#/research/kura/other',
+      '#/research/kura/map/clusters',
+    ]) {
+      assert.deepEqual(parseLibraryRoute(hash), LIBRARY_HOME, hash);
+    }
+  });
+});
diff --git a/src/sidebar/helpers/test/library-test.js b/src/sidebar/helpers/test/library-test.js
new file mode 100644
index 0000000..d17c53f
--- /dev/null
+++ b/src/sidebar/helpers/test/library-test.js
@@ -0,0 +1,391 @@
+import {
+  boardGroups,
+  countAnnotationLabels,
+  countLabels,
+  EMPTY_FILTERS,
+  filterPages,
+  matchesQuery,
+  monthBuckets,
+  normalizePage,
+  pageFromDocument,
+  pageInCollection,
+  sortPages,
+  sourceDomain,
+} from '../library';
+
+describe('local library search, groups and sorting', () => {
+  const page = (id, values = {}) =>
+    normalizePage({
+      id,
+      url: `https://example.org/${id}`,
+      title: id,
+      ...values,
+    });
+
+  it('searches and filters OpenAlex topics and keywords independently', () => {
+    const items = [
+      page('indexed', {
+        classification: {
+          link_type: 'paper',
+          topics: ['AI and cognition'],
+          keywords: ['Metacognition'],
+          subtopics: [],
+        },
+      }),
+      page('other'),
+    ];
+    assert.isTrue(matchesQuery(items[0], 'keyword:Metacognition'));
+    assert.isTrue(matchesQuery(items[0], 'topic:"AI and cognition"'));
+    assert.isFalse(matchesQuery(items[0], 'keyword:cognition'));
+    assert.deepEqual(
+      filterPages(items, '', {
+        ...EMPTY_FILTERS,
+        topic: 'AI and cognition',
+        keyword: 'Metacognition',
+      }).map(item => item.id),
+      ['indexed'],
+    );
+    assert.deepEqual(
+      filterPages(items, '', { ...EMPTY_FILTERS, keyword: 'Other' }),
+      [],
+    );
+  });
+
+  it('ranks by annotation count rather than by number of saved pages', () => {
+    const items = [
+      page('many-notes', {
+        annotation_ids: ['a', 'b', 'c'],
+        metadata: { authors: ['Ada', 'Bea'] },
+      }),
+      page('one-note', {
+        annotation_ids: ['d'],
+        metadata: { authors: ['Cy'] },
+      }),
+      page('another-note', {
+        annotation_ids: ['e'],
+        metadata: { authors: ['Cy'] },
+      }),
+      page('empty', { annotation_ids: [], metadata: { authors: ['Nobody'] } }),
+    ];
+    assert.deepEqual(
+      countAnnotationLabels(items, p => p.metadata.authors ?? []),
+      [
+        { label: 'Ada', count: 3 },
+        { label: 'Bea', count: 3 },
+        { label: 'Cy', count: 2 },
+      ],
+    );
+  });
+
+  it('counts an annotation once per label across repeated labels and source aliases', () => {
+    const items = [
+      page('first', {
+        annotation_ids: ['a', 'b', 'b'],
+        manual_tags: ['AI', 'ai', ''],
+      }),
+      page('alias', { annotation_ids: ['b', 'c'], manual_tags: ['ai'] }),
+      page('unlabeled', { annotation_ids: ['d'] }),
+    ];
+    assert.deepEqual(
+      countAnnotationLabels(items, p => p.manual_tags),
+      [{ label: 'AI', count: 3 }],
+    );
+  });
+
+  it('searches quoted metadata fields, both tag sources, and saved note text', () => {
+    const item = page('paper', {
+      metadata: {
+        authors: ['Ada Reader'],
+        institutions: ['Example University'],
+      },
+      manual_tags: ['read-again'],
+      auto_tags: ['ai'],
+      search_text: 'Compare the reproducibility baseline',
+      classification: {
+        link_type: 'paper',
+        topics: ['research'],
+        subtopics: [{ topic: 'research', name: 'ai' }],
+      },
+    });
+    assert.isTrue(
+      matchesQuery(
+        item,
+        'author:"Ada Reader" topic:research tag:ai reproducibility',
+      ),
+    );
+    assert.isTrue(
+      matchesQuery(item, 'institution:"Example University" tag:read-again'),
+    );
+    assert.isFalse(matchesQuery(item, 'topic:finance'));
+  });
+
+  it('combines manual group, type, topic and reaction filters', () => {
+    const items = [
+      page('one', {
+        groups: ['For later'],
+        reaction: 'love',
+        classification: {
+          link_type: 'paper',
+          topics: ['research'],
+          subtopics: [],
+        },
+      }),
+      page('two'),
+    ];
+    assert.deepEqual(
+      filterPages(items, '', {
+        ...EMPTY_FILTERS,
+        group: 'For later',
+        type: 'paper',
+        topic: 'research',
+        reaction: 'love',
+      }).map(item => item.id),
+      ['one'],
+    );
+    assert.deepEqual(
+      filterPages(items, '', { ...EMPTY_FILTERS, group: '__ungrouped__' }).map(
+        item => item.id,
+      ),
+      ['two'],
+    );
+  });
+
+  it('filters automatic collections without treating them as manual groups', () => {
+    const items = [
+      page('positive', { automatic_collections: ['liked-auto'], groups: [] }),
+      page('question', {
+        automatic_collections: ['questions-auto'],
+        groups: ['For later'],
+      }),
+      page('unknown'),
+    ];
+    assert.isTrue(pageInCollection(items[0], 'liked-auto'));
+    assert.isFalse(pageInCollection(items[0], 'Likes'));
+    assert.deepEqual(
+      filterPages(items, '', { ...EMPTY_FILTERS, group: 'questions-auto' }).map(
+        p => p.id,
+      ),
+      ['question'],
+    );
+    assert.deepEqual(items[0].groups, []);
+  });
+
+  it('ranks visit frequency using the rolling thirty-day count', () => {
+    const items = [
+      page('old-favorite', {
+        activity: { visit_count: 100 },
+        collection_signals: { visits_30_days: 1 },
+      }),
+      page('frequent', {
+        activity: { visit_count: 6 },
+        collection_signals: { visits_30_days: 6 },
+      }),
+      page('unvisited'),
+    ];
+    assert.deepEqual(
+      sortPages(items, 'visits').map(p => p.id),
+      ['frequent', 'old-favorite', 'unvisited'],
+    );
+  });
+
+  it('combines author, institution, inclusive date boundaries and metadata-gap filters', () => {
+    const items = [
+      page('complete', {
+        created_at: '2026-10-22T13:00:00Z',
+        metadata: {
+          authors: ['Ada'],
+          institutions: ['Example University'],
+          doi: '10.1000/example',
+        },
+      }),
+      page('missing', { created_at: '2026-10-22T13:00:00Z' }),
+      page('undated'),
+    ];
+    assert.deepEqual(
+      filterPages(items, '', {
+        ...EMPTY_FILTERS,
+        author: 'Ada',
+        institution: 'Example University',
+        dateFrom: '2026-10-22',
+        dateTo: '2026-10-22',
+      }).map(p => p.id),
+      ['complete'],
+    );
+    assert.deepEqual(
+      filterPages(items, '', {
+        ...EMPTY_FILTERS,
+        metadata: 'missing-authors',
+        dateFrom: '2026-10-22',
+      }).map(p => p.id),
+      ['missing'],
+    );
+    assert.deepEqual(
+      filterPages(items, '', { ...EMPTY_FILTERS, metadata: 'missing-ids' }).map(
+        p => p.id,
+      ),
+      ['missing', 'undated'],
+    );
+  });
+
+  it('sorts all four reactions with unrated in between positive and negative, without mutating the input', () => {
+    const items = [
+      page('bad', { reaction: 'bad' }),
+      page('like', { reaction: 'like' }),
+      page('unrated'),
+      page('hate', { reaction: 'hate' }),
+      page('love', { reaction: 'love' }),
+    ];
+    assert.deepEqual(
+      sortPages(items, 'liked').map(item => item.id),
+      ['love', 'like', 'unrated', 'bad', 'hate'],
+    );
+    assert.deepEqual(
+      sortPages(items, 'least-liked').map(item => item.id),
+      ['hate', 'bad', 'unrated', 'like', 'love'],
+    );
+    assert.equal(items[0].id, 'bad');
+  });
+
+  it('sorts by dates while keeping unknown dates last', () => {
+    const items = [
+      page('unknown'),
+      page('old', { created_at: '2020-01-01' }),
+      page('new', { created_at: '2026-10-17' }),
+    ];
+    assert.deepEqual(
+      sortPages(items, 'newest').map(item => item.id),
+      ['new', 'old', 'unknown'],
+    );
+    assert.deepEqual(
+      sortPages(items, 'oldest').map(item => item.id),
+      ['old', 'new', 'unknown'],
+    );
+  });
+
+  it('sorts annotation counts numerically in both directions, with date tie breaks', () => {
+    const items = [
+      page('two', { annotation_ids: ['a', 'b'] }),
+      page('twelve', {
+        annotation_ids: Array.from({ length: 12 }, (_, i) => String(i)),
+      }),
+      page('zero-old', { created_at: '2020-01-01' }),
+      page('zero-new', { created_at: '2026-10-18' }),
+    ];
+    assert.deepEqual(
+      sortPages(items, 'annotations').map(item => item.id),
+      ['twelve', 'two', 'zero-new', 'zero-old'],
+    );
+    assert.deepEqual(
+      sortPages(items, 'fewest-annotations').map(item => item.id),
+      ['zero-new', 'zero-old', 'two', 'twelve'],
+    );
+    assert.equal(items[0].id, 'two');
+    assert.deepEqual(
+      monthBuckets(sortPages(items, 'annotations'), 'annotations')[0].pages.map(
+        item => item.id,
+      ),
+      ['twelve', 'two', 'zero-new', 'zero-old'],
+    );
+  });
+
+  it('sorts titles and visit counts in both directions without changing the input', () => {
+    const items = [
+      page('Beta', { collection_signals: { visits_30_days: 12 } }),
+      page('Alpha', { collection_signals: { visits_30_days: 2 } }),
+      page('Gamma'),
+    ];
+    for (const [sort, expected] of [
+      ['title', ['Alpha', 'Beta', 'Gamma']],
+      ['title-desc', ['Gamma', 'Beta', 'Alpha']],
+      ['visits', ['Beta', 'Alpha', 'Gamma']],
+      ['fewest-visits', ['Gamma', 'Alpha', 'Beta']],
+    ]) {
+      assert.deepEqual(
+        sortPages(items, sort).map(item => item.id),
+        expected,
+      );
+    }
+    assert.deepEqual(
+      items.map(item => item.id),
+      ['Beta', 'Alpha', 'Gamma'],
+    );
+  });
+
+  it('sorts modification timestamps independently of added dates, with unknowns last', () => {
+    const items = [
+      page('unknown', { created_at: '2026-10-23' }),
+      page('recent', { created_at: '2020-01-01', updated_at: '2026-10-22' }),
+      page('earlier', { created_at: '2026-10-23', updated_at: '2026-10-21' }),
+      page('invalid', { updated_at: 'invalid' }),
+    ];
+    assert.deepEqual(
+      sortPages(items, 'updated').map(item => item.id),
+      ['recent', 'earlier', 'unknown', 'invalid'],
+    );
+    assert.deepEqual(
+      sortPages(items, 'oldest-updated').map(item => item.id),
+      ['earlier', 'recent', 'unknown', 'invalid'],
+    );
+  });
+
+  it('updates counts and manual fields from a saved document while retaining searchable note context', () => {
+    const before = page('saved', {
+      annotation_ids: ['one'],
+      search_text: 'Personal context',
+    });
+    const updated = pageFromDocument(before, {
+      ...before,
+      page_tags: ['manual'],
+      manual_tags: ['manual'],
+      annotations: [{ id: 'one' }, { id: 'two' }],
+      title: 'Renamed',
+    });
+    assert.deepEqual(updated.annotation_ids, ['one', 'two']);
+    assert.equal(updated.search_text, 'Personal context');
+    assert.isTrue(matchesQuery(updated, 'Renamed tag:manual'));
+  });
+
+  it('counts a page once per author and represents multi-topic pages on both boards', () => {
+    const items = [
+      page('one', {
+        metadata: { authors: ['Ada Reader', 'ada reader'] },
+        classification: {
+          link_type: 'paper',
+          topics: ['research', 'technology'],
+          subtopics: [],
+        },
+      }),
+    ];
+    assert.deepEqual(
+      countLabels(items, item => item.metadata.authors),
+      [{ label: 'Ada Reader', count: 1 }],
+    );
+    assert.deepEqual(
+      boardGroups(items, 'topic', []).map(column => column.pages.length),
+      [1, 1],
+    );
+    assert.deepEqual(
+      boardGroups([], 'manual', ['For later', 'Likes']).map(
+        column => column.name,
+      ),
+      ['For later', 'Likes', 'Ungrouped'],
+    );
+  });
+
+  it('groups a chronological profile by month without regrouping a rating sort', () => {
+    const items = [
+      page('first', { created_at: '2026-10-17' }),
+      page('second', { created_at: '2026-09-15' }),
+      page('unknown'),
+    ];
+    assert.deepEqual(
+      monthBuckets(items, 'newest').map(bucket =>
+        bucket.pages.map(item => item.id),
+      ),
+      [['first'], ['second'], ['unknown']],
+    );
+    assert.deepEqual(monthBuckets(items, 'liked')[0].pages, items);
+    assert.equal(sourceDomain('https://www.example.org/paper'), 'example.org');
+    assert.equal(sourceDomain('urn:x-pdf:synthetic'), 'PDF');
+  });
+});
