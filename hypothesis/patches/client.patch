@@ -0,0 +1,71 @@
+import type { ResearchDocument } from '../helpers/local-research';
+
+export default function PageActivity({ doc }: { doc: ResearchDocument }) {
+  const stamp = (s?: string) =>
+    s ? new Date(s).toLocaleString() : 'Not recorded';
+  const today = new Date();
+  const history = Array.from({ length: 6 }, (_, i) => {
+    const date = new Date(
+      Date.UTC(today.getUTCFullYear(), today.getUTCMonth() - 5 + i, 1),
+    );
+    const key = date.toISOString().slice(0, 7);
+    return {
+      key,
+      label: date.toLocaleDateString(undefined, {
+        month: 'short',
+        timeZone: 'UTC',
+      }),
+      notes: doc.annotations.filter(a => a.created?.startsWith(key)).length,
+      visits: Object.entries(doc.activity?.visits_by_day ?? {})
+        .filter(([day]) => day.startsWith(key))
+        .reduce((n, [, count]) => n + count, 0),
+    };
+  });
+  const maximum = Math.max(1, ...history.flatMap(h => [h.notes, h.visits]));
+  return (
+    <section className="research-history">
+      <h4 className="text-xs font-bold">Page activity</h4>
+      <dl>
+        <div>
+          <dt>First added</dt>
+          <dd>{stamp(doc.created_at)}</dd>
+        </div>
+        <div>
+          <dt>Last modified</dt>
+          <dd>{stamp(doc.updated_at)}</dd>
+        </div>
+        <div>
+          <dt>Last recorded visit</dt>
+          <dd>{stamp(doc.activity?.last_visit_at)}</dd>
+        </div>
+        <div>
+          <dt>Recorded visits</dt>
+          <dd>{doc.activity?.visit_count ?? 0}</dd>
+        </div>
+      </dl>
+      <ol
+        className="research-history-bars"
+        aria-label="Six months of annotation and reading activity (UTC)"
+      >
+        {history.map(h => (
+          <li
+            key={h.key}
+            aria-label={`${h.key}: ${h.notes} annotations, ${h.visits} recorded visits`}
+          >
+            <span className="research-history-count">
+              {h.notes}/{h.visits}
+            </span>
+            <span className="research-history-pair">
+              <i style={{ height: `${(h.notes / maximum) * 100}%` }} />
+              <i style={{ height: `${(h.visits / maximum) * 100}%` }} />
+            </span>
+            <small>{h.label}</small>
+          </li>
+        ))}
+      </ol>
+      <p className="text-xs text-color-text-light">
+        Green: annotations · Gold: recorded visits
+      </p>
+    </section>
+  );
+}
diff --git a/src/sidebar/components/PageMetadataEditor.tsx b/src/sidebar/components/PageMetadataEditor.tsx
