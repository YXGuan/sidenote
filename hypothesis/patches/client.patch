--- /dev/null
+++ b/src/sidebar/components/hooks/use-progressive-list.ts
@@ -0,0 +1,33 @@
+import { useEffect, useState } from 'preact/hooks';
+
+const BATCH_SIZE = 20;
+
+/** Reveal sorted/filtered results in batches, retaining expansion on refresh. */
+export function useProgressiveList<T>(
+  items: T[],
+  resetKey: string,
+  minimumCount = 0,
+) {
+  const minimum = Math.max(
+    BATCH_SIZE,
+    Math.ceil(minimumCount / BATCH_SIZE) * BATCH_SIZE,
+  );
+  const [state, setState] = useState({ key: resetKey, limit: minimum });
+  const limit = Math.max(
+    minimum,
+    state.key === resetKey ? state.limit : BATCH_SIZE,
+  );
+  useEffect(() => {
+    setState(current =>
+      current.key === resetKey && current.limit >= minimum
+        ? current
+        : { key: resetKey, limit: minimum },
+    );
+  }, [resetKey, minimum]);
+  return {
+    items: items.slice(0, limit),
+    visibleCount: Math.min(limit, items.length),
+    total: items.length,
+    showMore: () => setState({ key: resetKey, limit: limit + BATCH_SIZE }),
+  };
+}
