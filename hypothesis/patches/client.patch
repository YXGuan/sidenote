+        .find('ol')
+        .at(5)
+        .find('button')
+        .map(button => button.prop('aria-label')),
+      ['Ada: 1 page. Filter', 'Bea: 1 page. Filter'],
+    );
+  });
+  it('filters using the original labels from every chart', () => {
+    const wrapper = mount(<LibraryInsights {...props} />);
+    wrapper.find('ol').forEach(chart => {
+      chart.find('button').first().simulate('click');
+    });
+    assert.calledTwice(props.onTopic);
+    assert.alwaysCalledWith(props.onTopic, 'Computer science');
+    assert.calledTwice(props.onKeyword);
+    assert.alwaysCalledWith(props.onKeyword, 'AI');
+    assert.calledTwice(props.onAuthor);
+    assert.alwaysCalledWith(props.onAuthor, 'Ada');
+  });
+  it('counts saved pages without annotations and keeps annotation charts empty', () => {
+    props.pages[0].annotation_ids = [];
+    const wrapper = mount(<LibraryInsights {...props} />);
+    assert.deepEqual(
+      wrapper.find('ol').map(chart => chart.find('button').length),
+      [0, 0, 0, 1, 1, 2],
+    );
+    assert.include(
+      wrapper.find('ol').at(3).find('button').prop('aria-label'),
+      '1 page.',
+    );
+    assert.include(wrapper.text(), 'No data yet');
+  });
+
+  it('counts each page once per label regardless of its annotation count or repeated labels', () => {
+    props.pages[0].classification.topics.push('Computer science');
+    props.pages[0].metadata.authors.push('Ada');
+    props.pages.push(
+      normalizePage({
+        ...props.pages[0],
+        id: 'unannotated',
+        annotation_ids: [],
+      }),
+    );
+    const wrapper = mount(<LibraryInsights {...props} />);
+    wrapper
+      .find('ol')
+      .slice(0, 3)
+      .forEach(chart => {
+        assert.include(
+          chart.find('button').first().prop('aria-label'),
+          '3 annotations',
+        );
+      });
+    wrapper
+      .find('ol')
+      .slice(3)
+      .forEach(chart => {
+        chart.find('button').forEach(button => {
+          assert.include(button.prop('aria-label'), '2 pages');
+        });
+      });
+  });
+
+  it('charts OpenAlex keywords without inventing parent topics or retaining old subtopics', () => {
+    props.pages[0].classification.keywords = ['Metacognition'];
+    const wrapper = mount(<LibraryInsights {...props} />);
+    for (const index of [1, 4]) {
+      const chart = wrapper.find('ol').at(index);
+      assert.include(chart.text(), 'Metacognition');
+      assert.notInclude(chart.text(), 'AI');
+      chart.find('button').simulate('click');
+    }
+    assert.alwaysCalledWith(props.onKeyword, 'Metacognition');
+  });
+  it('shows every topic, subtopic, and author beyond the former top-six limit', () => {
+    props.pages = Array.from({ length: 9 }, (_, i) =>
+      normalizePage({
+        id: `page-${i}`,
+        url: `https://example.org/${i}`,
+        title: `Page ${i}`,
+        annotation_ids: Array.from({ length: i + 1 }, (_, j) => `${i}-${j}`),
+        metadata: { authors: [`Author ${i}`] },
+        classification: {
+          link_type: 'paper',
+          topics: [`Topic ${i}`],
+          subtopics: [{ topic: `Topic ${i}`, name: `Subtopic ${i}` }],
+        },
+      }),
+    );
+    const wrapper = mount(<LibraryInsights {...props} />);
+    wrapper.find('ol').forEach(chart => assert.lengthOf(chart.find('li'), 9));
+    wrapper.find('ol').at(0).find('button').last().simulate('click');
+    wrapper.find('ol').at(1).find('button').last().simulate('click');
+    wrapper.find('ol').at(2).find('button').last().simulate('click');
+    assert.calledWith(props.onTopic, 'Topic 0');
+    assert.calledWith(props.onKeyword, 'Subtopic 0');
+    assert.calledWith(props.onAuthor, 'Author 0');
+  });
+
+  it('reveals rankings independently and keeps newly revealed labels filterable', () => {
+    props.pages = Array.from({ length: 45 }, (_, i) =>
+      normalizePage({
+        id: `page-${i}`,
+        url: `https://example.org/${i}`,
+        annotation_ids: [`annotation-${i}`],
+        metadata: { authors: [`Author ${i}`] },
+        classification: {
+          topics: [`Topic ${i}`],
+          keywords: [`Keyword ${i}`],
+        },
+      }),
+    );
+    const wrapper = mount(<LibraryInsights {...props} />);
+    const more = title =>
+      wrapper.find(`button[aria-label="Show more ${title}"]`);
+    const lengths = () =>
+      wrapper.find('ol').map(chart => chart.find('li').length);
+    assert.deepEqual(lengths(), [20, 20, 20, 20, 20, 20]);
+    assert.include(wrapper.text(), 'Showing 20 of 45');
+    more('Pages by keyword').simulate('click');
+    assert.deepEqual(lengths(), [20, 20, 20, 20, 40, 20]);
+    more('Pages by keyword').simulate('click');
+    assert.deepEqual(lengths(), [20, 20, 20, 20, 45, 20]);
+    assert.isFalse(more('Pages by keyword').exists());
+    const lastKeyword = wrapper.find('ol').at(4).find('button').last();
+    const label = lastKeyword.find('.break-words').text();
+    lastKeyword.simulate('click');
+    assert.calledWith(props.onKeyword, label);
+
+    // Re-reading identical records must not collapse a chart being explored.
+    wrapper.setProps({ pages: props.pages.map(page => ({ ...page })) });
+    assert.deepEqual(lengths(), [20, 20, 20, 20, 45, 20]);
+    wrapper.setProps({ pages: props.pages.slice(0, 44) });
+    assert.deepEqual(lengths(), [20, 20, 20, 20, 20, 20]);
+    assert.include(wrapper.text(), 'Showing 20 of 44');
+
+    // Counts changing with the same labels also reset expansion.
+    more('Pages by topic').simulate('click');
+    assert.deepEqual(lengths(), [20, 20, 20, 40, 20, 20]);
+    wrapper.setProps({
+      pages: [...props.pages.slice(0, 44), { ...props.pages[0], id: 'extra' }],
+    });
+    assert.deepEqual(lengths(), [20, 20, 20, 20, 20, 20]);
+    assert.include(
+      wrapper.find('ol').at(3).find('button').first().prop('aria-label'),
+      '2 pages',
+    );
+    more('Annotations by topic').simulate('click');
+    assert.deepEqual(lengths(), [40, 20, 20, 20, 20, 20]);
+    assert.include(wrapper.text(), 'Showing 40 of 44');
+  });
+});
