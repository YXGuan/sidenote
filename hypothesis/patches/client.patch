@@ -0,0 +1,76 @@
+import type { LibrarySort } from './library';
+
+export type LibraryColorScheme = 'light' | 'dark' | 'system';
+export type LibraryTab =
+  | 'library'
+  | 'dashboard'
+  | 'collections'
+  | 'research'
+  | 'recommendations'
+  | 'settings';
+
+// Retain sorting from older installations; Compact is the only layout.
+export const LIBRARY_PREFERENCE_KEY = 'hypothesis.local-library.preferences.v3';
+const LEGACY_KEY = 'hypothesis.local-library.preferences.v2';
+
+export function libraryPreferences(
+  storage: Pick<Storage, 'getItem'>,
+  search: string,
+) {
+  const read = (key: string): Record<string, unknown> => {
+    try {
+      const value = JSON.parse(storage.getItem(key) ?? '{}');
+      return value && typeof value === 'object' && !Array.isArray(value)
+        ? value
+        : {};
+    } catch {
+      return {};
+    }
+  };
+  const saved = read(LIBRARY_PREFERENCE_KEY);
+  const sort = saved.sort ?? read(LEGACY_KEY).sort;
+  const params = new URLSearchParams(search);
+  const legacyView = params.get('view');
+  const tab =
+    params.get('tab') ??
+    (legacyView === 'overview'
+      ? 'dashboard'
+      : legacyView === 'board'
+        ? 'collections'
+        : 'library');
+  return {
+    design: 'compact' as const,
+    developerMode: saved.developerMode === true,
+    colorScheme: (['light', 'dark', 'system'].includes(
+      String(saved.colorScheme),
+    )
+      ? saved.colorScheme
+      : 'system') as LibraryColorScheme,
+    tab: ([
+      'library',
+      'dashboard',
+      'collections',
+      'research',
+      'recommendations',
+      'settings',
+    ].includes(tab)
+      ? tab
+      : 'library') as LibraryTab,
+    sort: ([
+      'newest',
+      'oldest',
+      'liked',
+      'least-liked',
+      'updated',
+      'oldest-updated',
+      'annotations',
+      'fewest-annotations',
+      'title',
+      'title-desc',
+      'visits',
+      'fewest-visits',
+    ].includes(String(sort))
+      ? sort
+      : 'newest') as LibrarySort,
+  };
+}
diff --git a/src/sidebar/helpers/library-routes.ts b/src/sidebar/helpers/library-routes.ts
new file mode 100644
index 0000000..1a49833
--- /dev/null
+++ b/src/sidebar/helpers/library-routes.ts
@@ -0,0 +1,130 @@
+import type { LibraryTab } from './library-preferences';
+
+export const RESEARCH_VIEWS = ['ask', 'find', 'wiki', 'graph', 'kura'] as const;
+export const KURA_VIEWS = ['hierarchy', 'map', 'sizes'] as const;
+
+export type LibraryRoute = {
+  tab: LibraryTab;
+  collection: string;
+  page: string | null;
+  researchView: (typeof RESEARCH_VIEWS)[number];
+  wikiPage: string;
+  graphNode: string;
+  kuraView: (typeof KURA_VIEWS)[number];
+  cluster: string;
+};
+
+export const LIBRARY_HOME: LibraryRoute = {
+  tab: 'library',
+  collection: '',
+  page: null,
+  researchView: 'ask',
+  wikiPage: '',
+  graphNode: '',
+  kuraView: 'hierarchy',
+  cluster: '',
+};
+
+/** Hash paths keep bookmarked routes inside the extension's static HTML entry. */
+export function libraryRouteHash(route: LibraryRoute) {
+  const parts: string[] = [route.tab];
+  if (route.tab === 'collections' && route.collection) {
+    parts.push(route.collection);
+  }
+  if (
+    route.page &&
+    (route.tab === 'library' ||
+      (route.tab === 'collections' && route.collection))
+  ) {
+    parts.push('pages', route.page);
+  }
+  if (route.tab === 'research') {
+    parts.push(route.researchView);
+    if (route.researchView === 'wiki' && route.wikiPage) {
+      parts.push(route.wikiPage);
+    }
+    if (route.researchView === 'graph' && route.graphNode) {
+      parts.push(route.graphNode);
+    }
+    if (route.researchView === 'kura') {
+      parts.push(route.kuraView);
+      if (route.cluster) {
+        parts.push('clusters', route.cluster);
+      }
+    }
+  }
+  return '#/' + parts.map(encodeURIComponent).join('/');
+}
+
+export function parseLibraryRoute(
+  hash: string,
+  legacyTab: LibraryTab = 'library',
+): LibraryRoute {
+  if (!hash || hash === '#' || hash === '#/') {
+    return { ...LIBRARY_HOME, tab: legacyTab };
+  }
+  let parts: string[];
+  try {
+    if (!hash.startsWith('#/')) {
+      return { ...LIBRARY_HOME };
+    }
+    parts = hash.slice(2).split('/').map(decodeURIComponent);
+  } catch {
+    return { ...LIBRARY_HOME };
+  }
+  const [tab, ...rest] = parts;
+  const route = { ...LIBRARY_HOME };
+  if (tab === 'library' || tab === 'collections') {
+    route.tab = tab;
+    if (tab === 'collections' && rest.length) {
+      route.collection = rest.shift()!;
+      if (!route.collection) {
+        return { ...LIBRARY_HOME };
+      }
+    }
+    if (rest.length === 2 && rest[0] === 'pages' && rest[1]) {
+      route.page = rest[1];
+    } else if (rest.length) {
+      return { ...LIBRARY_HOME };
+    }
+    return route;
+  }
+  if (
+    (tab === 'dashboard' || tab === 'settings' || tab === 'recommendations') &&
+    !rest.length
+  ) {
+    return { ...route, tab };
+  }
+  if (tab === 'research') {
+    route.tab = tab;
+    if (!rest.length) {
+      return route;
+    }
+    const requestedView = rest.shift();
+    const view = RESEARCH_VIEWS.find(view => view === requestedView);
+    if (!view) {
+      return { ...LIBRARY_HOME };
+    }
+    route.researchView = view;
+    if (view === 'wiki' && rest.length === 1 && rest[0]) {
+      route.wikiPage = rest.pop()!;
+    }
+    if (view === 'graph' && rest.length === 1 && rest[0]) {
+      route.graphNode = rest.pop()!;
+    }
+    if (view === 'kura' && rest.length) {
+      const kuraView = rest.shift();
+      const knownView = KURA_VIEWS.find(view => view === kuraView);
+      if (!knownView) {
+        return { ...LIBRARY_HOME };
+      }
+      route.kuraView = knownView;
+      if (rest.length === 2 && rest[0] === 'clusters' && rest[1]) {
+        route.cluster = rest[1];
+        rest.length = 0;
+      }
+    }
+    return rest.length ? { ...LIBRARY_HOME } : route;
+  }
+  return { ...LIBRARY_HOME };
+}
