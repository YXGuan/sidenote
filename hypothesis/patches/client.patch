+import { useResearchDocument } from '../hooks/local-research';
+
+function Thumb({ down = false }: { down?: boolean }) {
+  return (
+    <svg
+      viewBox="0 0 24 24"
+      className={`w-4 h-4 ${down ? 'rotate-180' : ''}`}
+      fill="none"
+      stroke="currentColor"
+      stroke-width="1.5"
+      aria-hidden="true"
+    >
+      <path d="M7 10H3v11h4zm0 10h11a2 2 0 0 0 2-1.6l1.4-7A2 2 0 0 0 19.4 9H14l1-5a2 2 0 0 0-3-2L7 10z" />
+    </svg>
+  );
+}
+
+export default function LocalResearchActions({
+  annotation,
+}: {
+  annotation: SavedAnnotation;
+}) {
+  const doc = useResearchDocument(annotation.uri);
+  const viewer = useSidebarStore().profile().userid;
+  const [expanded, setExpanded] = useState(false);
+  const [{ busy, error }, setOperation] = useState({ busy: false, error: '' });
+  if (!localResearchEnabled() || viewer !== annotation.user) {
+    return null;
+  }
+  const state = doc?.annotation_states?.[annotation.id];
+  const sentiment =
+    state?.analysis ??
+    doc?.analysis.sentiments?.find(
+      item => item.annotation_id === annotation.id,
+    );
+  const run = async (action: string, values?: Record<string, unknown>) => {
+    setOperation({ busy: true, error: '' });
+    try {
+      const result = await researchRequest(action, {
+        uri: annotation.uri,
+        annotation,
+        values,
+      });
+      rememberResearchDocument(
+        annotation.uri,
+        result.document as ResearchDocument,
+      );
+      setOperation({ busy: false, error: '' });
+    } catch (error) {
+      setOperation({ busy: false, error: error.message });
+      setExpanded(true);
+    }
+  };
+  return (
+    <div className="relative flex" data-testid="local-research-actions">
+      <IconButton
+        title="Like this annotation"
+        pressed={state?.reaction === 'like'}
+        disabled={busy}
+        onClick={() =>
+          run('annotation-reaction', {
+            reaction: state?.reaction === 'like' ? null : 'like',
+          })
+        }
+      >
+        <Thumb />
+      </IconButton>
+      <IconButton
+        title="Dislike this annotation"
+        pressed={state?.reaction === 'dislike'}
+        disabled={busy}
+        onClick={() =>
+          run('annotation-reaction', {
+            reaction: state?.reaction === 'dislike' ? null : 'dislike',
+          })
+        }
+      >
+        <Thumb down />
+      </IconButton>
+      <IconButton
+        icon={InfoIcon}
+        title="Annotation sentiment"
+        expanded={expanded}
+        onClick={() => setExpanded(!expanded)}
+      />
+      {expanded && (
+        <section
+          aria-label="Annotation sentiment"
+          className="absolute right-0 bottom-full z-10 w-64 p-3 mb-1 bg-white border rounded shadow-lg space-y-2 text-base"
+        >
+          <p className="font-bold">This annotation</p>
+          {state?.reaction && <p>Your reaction: {state.reaction}</p>}
+          {sentiment ? (
+            <p title={sentiment.reason}>
+              Inferred stance: {sentiment.sentiment} (
+              {Math.round(sentiment.confidence * 100)}%)
+            </p>
+          ) : (
+            <p>No inferred stance yet.</p>
+          )}
+          {sentiment && 'stale' in sentiment && sentiment.stale && (
+            <p>Annotation changed; analyze again.</p>
+          )}
+          <p className="text-xs text-color-text-light">
+            A highlight alone does not indicate agreement.
+          </p>
+          <Button
+            variant="secondary"
+            size="sm"
+            disabled={busy}
+            onClick={() => run('analyze-annotation')}
+          >
+            Analyze this annotation
+          </Button>
+          {error && <p role="alert">{error}</p>}
+        </section>
+      )}
+    </div>
+  );
+}
