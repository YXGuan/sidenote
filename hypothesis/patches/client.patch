+import { mount } from '@hypothesis/frontend-testing';
+
+import { LIBRARY_HOME } from '../../helpers/library-routes';
+import LibraryRouteLink from '../LibraryRouteLink';
+
+describe('LibraryRouteLink', () => {
+  const route = {
+    ...LIBRARY_HOME,
+    tab: 'collections',
+    collection: 'For later',
+  };
+
+  it('provides a bookmarkable href and navigates ordinary clicks without reloading', () => {
+    const navigate = sinon.stub();
+    const wrapper = mount(
+      <LibraryRouteLink to={route} navigate={navigate}>
+        For later
+      </LibraryRouteLink>,
+    );
+    assert.equal(wrapper.find('a').prop('href'), '#/collections/For%20later');
+    const preventDefault = sinon.stub();
+    wrapper.find('a').simulate('click', { button: 0, preventDefault });
+    assert.calledOnce(preventDefault);
+    assert.calledWith(navigate, route);
+  });
+
+  it('preserves modifier and middle clicks for opening routes in another tab', () => {
+    const navigate = sinon.stub();
+    const wrapper = mount(
+      <LibraryRouteLink to={route} navigate={navigate}>
+        For later
+      </LibraryRouteLink>,
+    );
+    for (const event of [
+      { button: 1 },
+      { button: 0, metaKey: true },
+      { button: 0, ctrlKey: true },
+      { button: 0, shiftKey: true },
+      { button: 0, altKey: true },
+    ]) {
+      const preventDefault = sinon.stub();
+      wrapper.find('a').simulate('click', { ...event, preventDefault });
+      assert.notCalled(preventDefault);
+    }
+    assert.notCalled(navigate);
+  });
+});
