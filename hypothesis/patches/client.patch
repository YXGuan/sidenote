+
+function SavedPage({ uri }: { uri: string }) {
+  const doc = useResearchDocument(uri);
+  return (
+    <div className="space-y-3">
+      <PageResearch uri={uri} />
+      {doc?.annotations.map(annotation => (
+        <Card key={annotation.id}>
