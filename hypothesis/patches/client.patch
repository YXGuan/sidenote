diff --git a/src/sidebar/components/hooks/local-research.ts b/src/sidebar/components/hooks/local-research.ts
new file mode 100644
index 0000000..437fd55
--- /dev/null
+++ b/src/sidebar/components/hooks/local-research.ts
@@ -0,0 +1,26 @@
+import { useEffect, useState } from 'preact/hooks';
+
+import {
+  cachedResearchDocument,
+  loadResearchDocument,
+  localResearchEnabled,
+  subscribeResearch,
+} from '../../helpers/local-research';
+
+export function useResearchDocument(uri: string) {
+  const [doc, setDoc] = useState(() => cachedResearchDocument(uri));
+  useEffect(() => {
+    if (!localResearchEnabled()) {
+      return undefined;
+    }
+    const update = () => setDoc(cachedResearchDocument(uri));
+    const unsubscribe = subscribeResearch(update);
+    update();
+    // The normal Hypothesis workflow must still work if the local service is offline.
+    loadResearchDocument(uri).catch(() => {});
+    return () => {
+      unsubscribe();
+    };
+  }, [uri]);
+  return doc;
+}
diff --git a/src/sidebar/components/hooks/test/use-library-route-test.js b/src/sidebar/components/hooks/test/use-library-route-test.js
new file mode 100644
index 0000000..e2f23ff
--- /dev/null
+++ b/src/sidebar/components/hooks/test/use-library-route-test.js
@@ -0,0 +1,99 @@
+import { mount } from '@hypothesis/frontend-testing';
+import { act } from 'preact/test-utils';
+
+import { LIBRARY_HOME } from '../../../helpers/library-routes';
+import { useLibraryRoute } from '../use-library-route';
+
+describe('useLibraryRoute', () => {
+  let fakeWindow;
+  let navigation;
+  beforeEach(() => {
+    fakeWindow = new EventTarget();
+    fakeWindow.location = new URL(
+      'http://localhost/client/notebook.html?local-library=1&design=paper',
+    );
+    fakeWindow.history = {
+      state: { shell: 'preserved' },
+      pushState: sinon.stub().callsFake((_state, _title, url) => {
+        fakeWindow.location = new URL(url);
+      }),
+      replaceState: sinon.stub().callsFake((_state, _title, url) => {
+        fakeWindow.location = new URL(url);
+      }),
+    };
+  });
+  function TestRoute({ legacyTab = 'library' }) {
+    navigation = useLibraryRoute(legacyTab, fakeWindow);
+    return <div>{navigation.route.tab}</div>;
+  }
+
+  it('canonicalizes legacy links while keeping the static entry and shell parameters', () => {
+    mount(<TestRoute legacyTab="dashboard" />);
+    assert.equal(fakeWindow.location.hash, '#/dashboard');
+    assert.equal(fakeWindow.location.pathname, '/client/notebook.html');
+    assert.equal(fakeWindow.location.search, '?local-library=1&design=paper');
+    assert.calledOnce(fakeWindow.history.replaceState);
+    assert.notCalled(fakeWindow.history.pushState);
+  });
+
+  it('restores direct links before rendering without adding history entries', () => {
+    fakeWindow.location.hash = '#/research/wiki/topic-123';
+    mount(<TestRoute />);
+    assert.equal(navigation.route.wikiPage, 'topic-123');
+    assert.equal(navigation.route.researchView, 'wiki');
+    assert.notCalled(fakeWindow.history.replaceState);
+    assert.notCalled(fakeWindow.history.pushState);
+  });
+
+  it('pushes only changed routes and preserves the shell history state', () => {
+    mount(<TestRoute />);
+    const route = {
+      ...LIBRARY_HOME,
+      tab: 'collections',
+      collection: 'For later',
+    };
+    act(() => navigation.navigate(route));
+    act(() => navigation.navigate(route));
+    assert.deepEqual(navigation.route, route);
+    assert.equal(fakeWindow.location.hash, '#/collections/For%20later');
+    assert.calledOnce(fakeWindow.history.pushState);
+    assert.calledWith(
+      fakeWindow.history.pushState,
+      fakeWindow.history.state,
+      '',
+      fakeWindow.location.href,
+    );
+  });
+
+  it('restores Back/Forward and manually edited hash routes without pushing new entries', () => {
+    mount(<TestRoute />);
+    act(() => {
+      fakeWindow.location.hash = '#/library/pages/saved-123';
+      fakeWindow.dispatchEvent(new Event('popstate'));
+    });
+    assert.equal(navigation.route.page, 'saved-123');
+    act(() => {
+      fakeWindow.location.hash = '#/research/kura/sizes';
+      fakeWindow.dispatchEvent(new Event('hashchange'));
+    });
+    assert.equal(navigation.route.kuraView, 'sizes');
+    assert.isNull(navigation.route.page);
+    assert.notCalled(fakeWindow.history.pushState);
+  });
+
+  it('repairs malformed routes and removes listeners on unmount', () => {
+    const add = sinon.spy(fakeWindow, 'addEventListener');
+    const remove = sinon.spy(fakeWindow, 'removeEventListener');
+    const wrapper = mount(<TestRoute />);
+    act(() => {
+      fakeWindow.location.hash = '#/%E0%A4%A';
+      fakeWindow.dispatchEvent(new Event('hashchange'));
+    });
+    assert.deepEqual(navigation.route, LIBRARY_HOME);
+    assert.equal(fakeWindow.location.hash, '#/library');
+    wrapper.unmount();
+    for (const [event, handler] of add.args) {
+      assert.calledWith(remove, event, handler);
+    }
+  });
+});
