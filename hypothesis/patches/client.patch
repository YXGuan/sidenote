+    document_id: 'source',
+    title: 'Original reading',
+    url: 'https://example.org/reading',
+    text: 'Structure matters. I disagree.',
+    highlight: 'Structure matters.',
+    comment: 'I disagree.',
+    reaction: 'bad',
+  };
+  const page = index => ({
+    id: `concept-${index}`,
+    title: `Concept ${index}`,
+    kind: 'concept',
+    provider: 'codex-exec',
+    markdown: '',
+    related: [],
+    evidence_ids: ['highlight'],
+    aliases: index === 0 ? ['Topology'] : [],
+    claims: [
+      {
+        kind: 'overview',
+        text: 'A cited explanation.',
+        evidence: [{ evidence_id: 'highlight', quote: 'Structure matters.' }],
