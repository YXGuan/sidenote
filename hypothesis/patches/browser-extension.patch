diff --git a/src/background/local-research.ts b/src/background/local-research.ts
new file mode 100644
index 0000000..4675ba7
--- /dev/null
+++ b/src/background/local-research.ts
@@ -0,0 +1,318 @@
+/** Local persistence behind the original Hypothesis UI. Never expose the key to a page. */
+import { initSavedPageVisits } from './saved-page-visits';
+
+const BASE = 'http://127.0.0.1:8765';
+
+type ResearchMessage = {
+  type: 'local-research';
+  action: string;
+  uri?: string;
+  annotation?: Record<string, any>;
+  document?: Record<string, any>;
+  values?: Record<string, unknown>;
+  annotationId?: string;
+  name?: string;
+  force?: boolean;
+  approved?: boolean;
+  provider?: 'local' | 'codex';
+};
+
+function citationMetadata(document: Record<string, any> = {}) {
+  const highwire = document.highwire ?? {};
+  return {
+    title: highwire.title ?? document.title,
+    authors: highwire.author ?? document.dc?.creator,
+    institutions: highwire.author_institution ?? highwire.author_affiliation,
+    journal: highwire.journal_title,
+    doi: highwire.doi,
+    published: highwire.publication_date ?? highwire.date,
+    publisher: highwire.publisher,
+    abstract: highwire.abstract ?? document.dc?.description?.join(' '),
+    description: document.description,
+    arxiv_id: highwire.arxiv_id,
+  };
+}
+
+export async function handleResearchMessage(message: ResearchMessage) {
+  const preferences = await chrome.storage.local.get({
+    researchKey: '',
+    researchAutoTags: true,
+  });
+  if (!preferences.researchKey) {
+    throw new Error(
+      'Enter your local storage key in sidenote extension settings.',
+    );
+  }
+  async function request(path: string, body?: unknown) {
+    let response;
+    try {
+      response = await fetch(BASE + path, {
+        method: body === undefined ? 'GET' : 'POST',
+        headers: {
+          Authorization: `Bearer ${preferences.researchKey}`,
+          ...(body === undefined ? {} : { 'Content-Type': 'application/json' }),
+        },
+        ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+      });
+    } catch {
+      throw new Error('Start the local sidenote storage service, then retry.');
+    }
+    const result = await response.json();
+    if (!response.ok) {
+      throw new Error(result.error || 'Local storage request failed');
+    }
+    return result;
+  }
+  const uri = message.uri ?? message.annotation?.uri;
+  const ensureDocument = async () => {
+    if (typeof uri !== 'string') {
+      throw new Error('A source identifier is required');
+    }
+    const result = await request(
+      '/api/document?url=' + encodeURIComponent(uri),
+    );
+    if (result.document) {
+      return result.document;
+    }
+    return (
+      await request('/api/capture', {
+        url: uri,
+        metadata: citationMetadata(
+          message.document ?? message.annotation?.document,
+        ),
+      })
+    ).document;
+  };
+  switch (message.action) {
+    case 'dashboard':
+      await chrome.tabs.create({
+        url: chrome.runtime.getURL('client/notebook.html?local-library=1'),
+      });
+      return {};
+    case 'account':
+      return request('/api/account');
+    case 'status':
+      return request('/api/status');
+    case 'library':
+      return request('/api/library');
+    case 'recommendations':
+      return request('/api/recommendations');
+    case 'refresh-recommendations':
+      return request('/api/recommendations', {
+        approved: message.approved === true,
+      });
+    case 'research':
+      return request('/api/research', message.values);
+    case 'research-job':
+      return request('/api/research');
+    case 'wiki':
+      return request('/api/wiki');
+    case 'kura':
+      return request('/api/kura');
+    case 'kura-members':
+      return request(
+        '/api/kura?cluster_id=' +
+          encodeURIComponent(String(message.values?.cluster_id ?? '')) +
+          '&offset=' +
+          encodeURIComponent(String(message.values?.offset ?? 0)),
+      );
+    case 'graph':
+      return request(
+        '/api/graph?' +
+          new URLSearchParams({
+            query: String(message.values?.query ?? ''),
+            focus: String(message.values?.focus ?? ''),
+            depth: String(message.values?.depth ?? 1),
+            overview: String(message.values?.overview ?? false),
+          }).toString(),
+      );
+    case 'saved-urls':
+      return request('/api/saved-urls');
+    case 'visit':
+      return request('/api/visit', { url: uri });
+    case 'remove':
+    case 'restore':
+      return request(`/api/${message.action}`, { url: uri });
+    case 'groups':
+      return request('/api/groups');
+    case 'create-group':
+      return request('/api/groups', { name: message.name });
+    case 'organization':
+      return request('/api/organization');
+    case 'settings':
+      return request('/api/settings');
+    case 'import-references':
+      return request('/api/references/import', message.values);
+    case 'import-zotero-desktop':
+      return request('/api/references/desktop', {});
+    case 'import-zotero-online':
+      return request('/api/references/online', {});
+    case 'zotero-connection':
+      return request('/api/zotero');
+    case 'zotero-import-status':
+      return request('/api/zotero/import');
+    case 'save-zotero-connection':
+      return request('/api/zotero', message.values);
+    case 'export-references':
+      return request('/api/references/export', message.values);
+    case 'save-settings':
+      return request('/api/settings', message.values);
+    case 'backup':
+      return request('/api/backup', {});
+    case 'enrich-library':
+      return request('/api/enrich-library', { force: message.force === true });
+    case 'enrich': {
+      const doc = await ensureDocument();
+      return request('/api/enrich', { document_id: doc.id, force: true });
+    }
+    case 'organize':
+      return request('/api/organize', {
+        force: message.force ?? false,
+        approved: message.approved === true,
+        ...(message.provider ? { provider: message.provider } : {}),
+      });
+    case 'document':
+      if (typeof uri !== 'string') {
+        throw new Error('A source identifier is required');
+      }
+      return request('/api/document?url=' + encodeURIComponent(uri));
+    case 'annotation':
+      return request('/api/annotation', {
+        annotation: message.annotation,
+        document: message.document,
+      });
+    case 'suggest':
+      if (!preferences.researchAutoTags && !message.force) {
+        return { analysis: { tags: [] } };
+      }
+      return request('/api/suggest', { annotation: message.annotation });
+    case 'capture':
+      return request('/api/capture', {
+        url: uri,
+        metadata: citationMetadata(message.document),
+        visit: true,
+      });
+    case 'suggest-page': {
+      const doc = await ensureDocument();
+      if (!preferences.researchAutoTags && !message.force) {
+        return { document: doc };
+      }
+      return request('/api/suggest-page', {
+        document_id: doc.id,
+        force: message.force ?? false,
+      });
+    }
+    case 'annotation-reaction':
+    case 'analyze-annotation': {
+      if (message.annotation) {
+        await request('/api/annotation', { annotation: message.annotation });
+      }
+      return request(
+        message.action === 'annotation-reaction'
+          ? '/api/annotation-reaction'
+          : '/api/analyze-annotation',
+        {
+          annotation_id: message.annotationId ?? message.annotation?.id,
+          ...(message.action === 'annotation-reaction'
+            ? { reaction: message.values?.reaction }
+            : {}),
+        },
+      );
+    }
+    case 'sync':
+      return request('/api/sync', { public_only: false });
+    case 'update': {
+      const doc = await ensureDocument();
+      return request('/api/update', {
+        document_id: doc.id,
+        values: message.values,
+      });
+    }
+    case 'analyze': {
+      const doc = await ensureDocument();
+      const status = await request('/api/status');
+      if (message.annotation?.user === `acct:${status.user}@hypothes.is`) {
+        await request('/api/annotation', {
+          annotation: message.annotation,
+          document: message.document,
+        });
+      }
+      return request('/api/analyze', { document_id: doc.id });
+    }
+    default:
+      throw new Error('Unsupported local research action');
+  }
+}
+
+export function initLocalResearch() {
+  if (!globalThis.chrome?.runtime?.onMessage) {
+    return;
+  }
+  initSavedPageVisits(chrome.tabs, {
+    savedURLs: async () =>
+      (
+        await handleResearchMessage({
+          type: 'local-research',
+          action: 'saved-urls',
+        })
+      ).urls,
+    record: async uri => {
+      await handleResearchMessage({
+        type: 'local-research',
+        action: 'visit',
+        uri,
+      });
+    },
+  });
+  chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
+    if (message?.type !== 'local-research') {
+      return false;
+    }
+    const ownPage = sender.url?.startsWith(chrome.runtime.getURL(''));
+    const ownProfileScript = /^https:\/\/hypothes\.is\/users\//.test(
+      sender.url ?? '',
+    );
+    if (sender.id !== chrome.runtime.id || (!ownPage && !ownProfileScript)) {
+      sendResponse({ ok: false, error: 'Local research sender rejected' });
+      return false;
+    }
+    if (
+      [
+        'account',
+        'settings',
+        'import-references',
+        'import-zotero-desktop',
+        'import-zotero-online',
+        'zotero-connection',
+        'zotero-import-status',
+        'save-zotero-connection',
+        'export-references',
+        'save-settings',
+        'backup',
+        'remove',
+        'restore',
+        'organize',
+        'research',
+        'research-job',
+        'wiki',
+        'graph',
+        'kura',
+        'kura-members',
+        'recommendations',
+        'refresh-recommendations',
+      ].includes(message.action) &&
+      !ownPage
+    ) {
+      sendResponse({
+        ok: false,
+        error: 'Account access requires an extension page',
+      });
+      return false;
+    }
+    handleResearchMessage(message).then(
+      data => sendResponse({ ok: true, data }),
+      error => sendResponse({ ok: false, error: error.message }),
+    );
+    return true;
+  });
+}
